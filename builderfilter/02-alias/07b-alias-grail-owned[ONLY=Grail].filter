//-----------------------------------------------------------------------------------
// GRAIL OWNED TAG (Grail)
//-----------------------------------------------------------------------------------
// Grail filters also tag unidentified uniques / set items that are in the grail but not owned
// (ALLDISCOVERED !ALLOWNED) — white GRAIL instead of the orange not-found one.
// Rules in 03-unidformatting/19-Tags_Unid_UniquesSet; other filters get it off from
// 07b-alias-grail-owned[ALL-EXCEPT=Grail].
Alias[GRAIL_OWNED_TAG]: %WHITE%GRAIL
Alias[GRAIL_OWNED_CALLOUT]: TRUE
