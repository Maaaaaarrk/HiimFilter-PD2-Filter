//-----------------------------------------------------------------------------------
// SITE FX: per-rule minimap icon / sound / frame tags for shared segments.
// Hiim (and Phil777) segments add these inline; the Kassahi bucket's aliases already
// carry their own icon and sound, so its copy of each alias is empty (or its own frame).
// Keep the alias names identical in 07-alias-site-fx[ALL-EXCEPT=KassahiStd] and [ONLY=KassahiStd].
//-----------------------------------------------------------------------------------
// Values for the Kassahi bucket (Regular / Meme / Mystery, normal + hyper).

// SITE_FX: condition flag for the few rules that only exist in one style (wss / cwss stack tag).
Alias[SITE_FX]: (CLVL<0)

// cwss frame
Alias[DISP_CWSS]: %WSS_SHARD%
// iwss frame
Alias[DISP_IWSS]: %WSS_SHARD%
// lmal decoration
Alias[DISP_LMAL]: %NAME%
// toa
Alias[DISP_TOA]: %TOKEN_PARTS%
// uber boss mats
Alias[FX_BOSS_MAT]:
// essences
Alias[FX_ESSENCE]:
// flawless gem / skull stacks
Alias[FX_GEM_STACK]:
// infusions (crf*)
Alias[FX_INFUSION]:
// jewf
Alias[FX_JEWF]:
// lbox / imrn
Alias[FX_PD2_GG]:
// lpp
Alias[FX_PD2_RARE]:
// perfect gem / skull stacks
Alias[FX_PGEM_STACK]:
// rkey
Alias[FX_RKEY]:
// rtp / rid
Alias[FX_RTP_RID]:
// unid 3-star uniques (Phil777, 19-Kassahi_UNID-stars)
Alias[FX_STARS_3]:
// uba
Alias[FX_UBA]:
// ubaa / ubab / ubac
Alias[FX_UBA_PARTS]:
// pk1 / pk2 / pk3
Alias[FX_UBER_KEY]:
// mbr / bey / dhn
Alias[FX_UBER_ORGAN]:
// ubtm
Alias[FX_UBTM]:
// unid 3-star uniques (Hiim)
Alias[FX_UNID_3STAR]:
// unid GG uniques / sets
Alias[FX_UNID_GG]:
// unid EQ7 rares
Alias[FX_UNID_RARE_SUPER]:
// lsvl / llmr
Alias[FX_VIAL_MIRROR]:
// wss
Alias[FX_WSS]:
