//-----------------------------------------------------------------------------------
// SITE FX: per-rule minimap icon / sound / frame tags for shared segments.
// Hiim (and Phil777) segments add these inline; the Kassahi bucket's aliases already
// carry their own icon and sound, so its copy of each alias is empty (or its own frame).
// Keep the alias names identical in 07-alias-site-fx[ALL-EXCEPT=KassahiStd] and [ONLY=KassahiStd].
//-----------------------------------------------------------------------------------
// Values for the Kassahi bucket (Regular / Meme / Mystery, normal + hyper).

// SITE_FX: condition flag for the few rules that only exist in one style (wss / cwss stack tag).
Alias[SITE_FX]: FALSE

// cwss frame
Alias[DISP_CWSS]: %WSS_SHARD%
// iwss frame
Alias[DISP_IWSS]: %WSS_SHARD%
// lmal decoration
Alias[DISP_LMAL]: %NAME%
// toa
Alias[DISP_TOA]: %TOKEN_PARTS%
// uber boss mats
Alias[FX_BOSS_MAT]:
// essences
Alias[FX_ESSENCE]:
// flawless gem / skull stacks
Alias[FX_GEM_STACK]:
// infusions (crf*)
Alias[FX_INFUSION]:
// jewf
Alias[FX_JEWF]:
// lbox / imrn
Alias[FX_PD2_GG]:
// lpp
Alias[FX_PD2_RARE]:
// perfect gem / skull stacks
Alias[FX_PGEM_STACK]:
// rkey
Alias[FX_RKEY]:
// rtp / rid
Alias[FX_RTP_RID]:
// unid 3-star uniques (Phil777, 19-Kassahi_UNID-stars)
Alias[FX_STARS_3]:
// uba
Alias[FX_UBA]:
// ubaa / ubab / ubac
Alias[FX_UBA_PARTS]:
// pk1 / pk2 / pk3
Alias[FX_UBER_KEY]:
// mbr / bey / dhn
Alias[FX_UBER_ORGAN]:
// ubtm
Alias[FX_UBTM]:
// unid 3-star uniques (Hiim)
Alias[FX_UNID_3STAR]:
// unid GG uniques / sets
Alias[FX_UNID_GG]:
// unid EQ7 rares
Alias[FX_UNID_RARE_SUPER]:
// lsvl / llmr
Alias[FX_VIAL_MIRROR]:
// wss
Alias[FX_WSS]:

//-----------------------------------------------------------------------------------
// KASSAHI FAMILY VARIANTS: Kassahi-bucket values for aliases used only by Kassahi segments.
// The Phil777 values are in 02-alias/03-alias-kassahi-luxe (same names).
//-----------------------------------------------------------------------------------
Alias[PHIL777_STYLE]: FALSE
// Tags (were 01-header/05-qtytagging[Kassahi,ALL-EXCEPT=Phil777])
Alias[QTY_TAG]: %TAN%x%WHITE%%QTY%
Alias[SLAMMED_TAG]: *
Alias[DESECRATED_TAG]: %GOLD%*
Alias[VENDOR_GOLD_TAG]: %ORANGE%• %WHITE%$
// Runes: El-Fal framed as low (Lem is RUNE_MID_LOW)
Alias[RUNE_LOW_RANGE]: (RUNE<20)
// Mystery names
Alias[MYSTERY_COLOR]: %RED%
Alias[MYSTERY_TOP_NAME]: GG Mystery
Alias[MYSTERY_QTY]: (QTY=1)
// Rejuvs
Alias[REJUV_SMALL_LABEL]: %PURPLE%° %WHITE%35% %PURPLE%°
Alias[REJUV_FULL_LABEL]: %PURPLE%° %WHITE%Juice %PURPLE%°

