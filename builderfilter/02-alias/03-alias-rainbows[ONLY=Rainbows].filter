//-----------------------------------------------------------------------------------
// General Item re-names
//-----------------------------------------------------------------------------------

ItemDisplay[RUNE>0 RUNE<21 FILTLVL>7]: %RUNENAME%{%NAME%}%CONTINUE%


ItemDisplay[wss]: %PURPLE%WORLDSTONE SHARD%CONTINUE%
ItemDisplay[cwss]: %ORANGE%Tainted %PURPLE%WORLDSTONE SHARD%CONTINUE%

// Craft Infusion renames — set the name here so 05-utility/06-Gems tooltips
// don't override formatting with hardcoded text.
ItemDisplay[lucb GROUND]: Dorito%CONTINUE%
ItemDisplay[lucb QTY>1 GROUND]: %NAME% %QTY_TAG%%CONTINUE%
ItemDisplay[crfb]: %RED%Blood %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfc]: %PURPLE%Caster %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfs]: %GREEN%Safety %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfh]: %BLUE%Hitpower %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfv]: %GRAY%Vampiric %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfu]: %YELLOW%Bountiful %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfp]: %WHITE%Brilliant %GOLD%Craft Infusion%CONTINUE%

// Formating for names
ItemDisplay[gzv OR gzvs]: %PURPLE%Amethyst%CONTINUE%
ItemDisplay[gpv OR gpvs]: %PURPLE%P Amethyst%CONTINUE%
ItemDisplay[glw OR glws]: %WHITE%Diamond%CONTINUE%
ItemDisplay[gpw OR gpws]: %WHITE%P. Diamond%CONTINUE%
ItemDisplay[glg OR glgs]: %GREEN%Emerald%CONTINUE%
ItemDisplay[gpg OR gpgs]: %GREEN%O  P Emerald  O%CONTINUE%
ItemDisplay[glr OR glrs]: %RED%Ruby%CONTINUE%
ItemDisplay[gpr OR gprs]: %RED%O  P Ruby  O%CONTINUE%
ItemDisplay[glb OR glbs]: %BLUE%Sapphire%CONTINUE%
ItemDisplay[gpb OR gpbs]: %BLUE%O  P Sapphire  O%CONTINUE%
ItemDisplay[gly OR glys]: %YELLOW%Topaz%CONTINUE%
ItemDisplay[gpy OR gpys]: %YELLOW%O  P Topaz  O%CONTINUE%
ItemDisplay[skl OR skls]: %CORAL%. %LIGHT_GRAY%Skull %CORAL%.%CONTINUE%
ItemDisplay[skz OR skzs]: %CORAL%O O  %LIGHT_GRAY%P Skull  %CORAL%O O%CONTINUE%
ItemDisplay[GEM=4 FILTLVL<3]: %WHITE%F %NAME%%CONTINUE%

ItemDisplay[(crfb OR crfc OR crfs OR crfh OR crfv OR crfu OR crfp) QTY>1]: %NAME% %QTY_TAG%%CONTINUE%{%NAME%}
ItemDisplay[(crfb OR crfc OR crfs OR crfh OR crfv OR crfu OR crfp)]: %NAME%%CONTINUE%{%NAME%}
