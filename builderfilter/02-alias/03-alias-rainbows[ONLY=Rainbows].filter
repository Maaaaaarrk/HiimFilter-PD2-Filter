// Rainbows style: the general aliases with rainbow item markers and colors.
//-----------------------------------------------------------------------------------
// Alias for item ground annotations
//-----------------------------------------------------------------------------------

// General item
Alias[GEN_ITEM]: %YELLOW%OO%BLUE%OO %NAME% %BLUE%OO%YELLOW%OO
Alias[WSS_SHARD]: %RED%O %GREEN%O %BLUE%O %NAME% %BLUE%O %GREEN%O %RED%O
Alias[GEN_ALT]: %RED%O%GREEN%O%BLUE%O%YELLOW%O %NAME% %YELLOW%O%BLUE%O%GREEN%O%RED%O
Alias[TOKEN_PARTS]: %RED%X%GREEN%><%BLUE%x%ORANGE% %NAME% %BLUE%x%GREEN%><%RED%X
Alias[UBER_KEYS]: %RED%X%GREEN%><%BLUE%x %NAME% %BLUE%x%GREEN%><%RED%X
Alias[BOSS_MAT]: %RED%XxXxX %NAME% %RED%XxXxX
Alias[BOSS_ALT]: %YELLOW%X%YELLOW%X%YELLOW%X %NAME% %YELLOW%X%YELLOW%X%YELLOW%X
Alias[PD2_MATS]: %YELLOW%X%YELLOW%X%YELLOW%X %NAME% %YELLOW%X%YELLOW%X%YELLOW%X
Alias[BOSS_ENTRY]: %RED%### %NAME% %RED%###
Alias[GEN_RARE]: %RED%@%RED%@%RED%@ %NAME% %RED%@%RED%@%RED%@
Alias[GEN_TOP_RARE]: %RED%O%GREEN%O%BLUE%O%YELLOW%O %NAME% %YELLOW%O%BLUE%O%GREEN%O%RED%O
Alias[GEN_GG_ITEM]: %RED%O %GREEN%O %BLUE%O %NAME% %BLUE%O %GREEN%O %RED%O
Alias[RARE_GG_ITEM]: %RED%OO%GREEN%OO%BLUE%OO%YELLOW%OO %NAME% %YELLOW%OO%BLUE%OO%GREEN%OO%RED%OO
Alias[RARE_GG_ALT]: %RED%X%YELLOW%x%GREEN%X%BLUE%x%BLUE%X%GREEN%x%YELLOW%X%RED%x %NAME% %RED%x%YELLOW%X%GREEN%x%BLUE%X%BLUE%x%GREEN%X%YELLOW%x%RED%X
Alias[RUNE_LOW]: %PX-0B%%RED%O %NAME% %RED%O
Alias[RUNE_CRAFT]: %DOT-0B%%RED%O%GREEN%O %NAME% %GREEN%O%RED%O
Alias[RUNE_MID]: %DOT-9B%%PX-0B%%RED%O %GREEN%O %BLUE%O %NAME% %BLUE%O %GREEN%O %RED%O
Alias[RUNE_MID_LOW]: %DOT-9B%%PX-0B%%RED%O %GREEN%O %BLUE%O %NAME% %BLUE%O %GREEN%O %RED%O
Alias[RUNE_ALT_MID]: %BORDER-9B%%DOT-0B%%RED%O %GREEN%O %BLUE%O %NAME% %BLUE%O %GREEN%O %RED%O
Alias[RUNE_HIGH]: %BORDER-9B%%MAP-7D%%DOT-0B%%RED%O %GREEN%O %BLUE%O %YELLOW%O %NAME% %YELLOW%O %BLUE%O %GREEN%O %RED%O

// Phil777 label hooks (Phil777 values in 03-alias-kassahi-luxe); defined above the aliases they use
Alias[PHIL777_LOOK]: FALSE
Alias[CHARM_UNID]: %NAME%
Alias[RW_LABEL]: %NAME%
Alias[RUNE_ALT_HIGH]: %BORDER-9B%%MAP-7D%%DOT-0B%%RED%OO %GREEN%OO %BLUE%OO %YELLOW%OO %NAME% %YELLOW%OO %BLUE%OO %GREEN%OO %RED%OO
Alias[MAG_ITEM]: %MAP-6A%%DOT-94%%YELLOW%O %NAME% %YELLOW%O
Alias[MAG_DBL_AFFIX_ITEM]: %BORDER-6A%%DOT-94%%YELLOW%OO %NAME% %YELLOW%OO
Alias[RARE_ITEM]: %MAP-0B%%DOT-6A%%RED%O %NAME% %RED%O
Alias[RARE_PLUS]: %DOT-6A%O %NAME% O
Alias[RARE_HIGH_ITEM]: %MAP-0B%%DOT-6A%%RED%O %NAME% %RED%O
Alias[RARE_GOOD_ITEM]: %MAP-9B%%DOT-6A%%RED%O %GREEN%O %BLUE%O %NAME% %BLUE%O %GREEN%O %RED%O
Alias[RARE_SUPER]: %BORDER-9B%%DOT-6A%%RED%O %GREEN%O %BLUE%O %YELLOW%O %NAME% %YELLOW%O %BLUE%O %GREEN%O %RED%O

