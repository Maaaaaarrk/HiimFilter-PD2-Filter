// Rare GG Item Drop — shares RUNE_ALT_HIGH body so lsvl/llmr render in the
// SUR-ZOD frame in Phil777-Regular.
Alias[RARE_GG_ITEM]: %BLACK%@%PURPLE%@@%BLACK%@%GREEN%@@%BLACK%@%PURPLE%@@%BLACK%@%GREEN%@@%BLACK%@   %BLACK%O %RED%%NAME%%BLACK% O   %BLACK%@%GREEN%@@%BLACK%@%PURPLE%@@%BLACK%@%GREEN%@@%BLACK%@%PURPLE%@@%BLACK%@

// Unlimited Use items — shares RUNE_ALT_HIGH body so rtp/rid/rkey render in
