//-----------------------------------------------------------------------------------
// Kassahi luxe — full alias set (consolidated)
//
// Merged from the legacy two-file layout:
//   * `03-alias-kassahi-general-luxe` (GEN_*, BOSS_*, RUNE_*, MAG_*, RARE_*,
//     UNI_*, SET_*, FACET_*, RW_BASE_*, CRAFT_*, etc. — visuals shared by this
//     variant's family)
//   * `03-alias-kassahi-luxe` (GG_* item-specific aliases, MAIN_DOT,
//     PD2_MATS, plus the rvl rename and gem name re-formatting)
//-----------------------------------------------------------------------------------

// === Set 2: shared visual-family aliases (general) ===

// General item
Alias[GEN_ITEM]: %BLACK%@%PURPLE%@%GREEN%@%BLACK%@ %NAME% %BLACK%@%GREEN%@%PURPLE%@%BLACK%@

// General item Alt
Alias[GEN_ALT]: %PURPLE%«%BLACK%·%GREEN%» %BLACK%O %RED%Catalyst %BLACK%O %GREEN%«%BLACK%·%PURPLE%»

// Token parts — unified «·» frame (matches PD2_MATS); name colour set upstream
Alias[TOKEN_PARTS]: %PURPLE%«%BLACK%·%GREEN%» %BLACK%O %NAME% %BLACK%O %GREEN%«%BLACK%·%PURPLE%»

// Uber Keys — unified «·» frame; name colour set upstream
Alias[UBER_KEYS]: %PURPLE%«%BLACK%·%GREEN%» %BLACK%O %NAME% %BLACK%O %GREEN%«%BLACK%·%PURPLE%»

// Boss Mat Item — unified «·» frame; name colour set upstream
Alias[BOSS_MAT]: %PURPLE%«%BLACK%·%GREEN%» %BLACK%O %NAME% %BLACK%O %GREEN%«%BLACK%·%PURPLE%»

// Boss Mat Item Alt
Alias[BOSS_ALT]: %YELLOW%O O O O %NAME% %YELLOW%O O O O

// Boss Entry Item
Alias[BOSS_ENTRY]: %RED%«·» «·» %NAME% %RED%«·» «·»

// Rare General Item — unified «·» frame; name colour set upstream
Alias[GEN_RARE]: %PURPLE%«%BLACK%·%GREEN%» %BLACK%O %NAME% %BLACK%O %GREEN%«%BLACK%·%PURPLE%»

// Rarer General Item
