//-----------------------------------------------------------------------------------
// General Item re-names
//-----------------------------------------------------------------------------------

ItemDisplay[RUNE<20]: %ORANGE%%RUNENAME%%CONTINUE%
// Runes 1-20: keep the rune-name annotation tooltip at higher filter levels
// (Hiim suppresses these above FILTLVL 7; Kassahi keeps them visible).
ItemDisplay[RUNE>0 RUNE<20]: %NAME%{%NAME%}%CONTINUE%
ItemDisplay[RUNE=20]: Lem%CONTINUE%
ItemDisplay[RUNE=21]: Pul%CONTINUE%
ItemDisplay[RUNE=22]: Um%CONTINUE%
ItemDisplay[RUNE=23]: Mal%CONTINUE%
ItemDisplay[RUNE=24]: Ist%CONTINUE%
ItemDisplay[RUNE=25]: Gul%CONTINUE%
ItemDisplay[RUNE=26]: Vex%CONTINUE%
ItemDisplay[RUNE=27]: Ohm%CONTINUE%
ItemDisplay[RUNE=28]: Lo%CONTINUE%
ItemDisplay[RUNE=29]: Sur%CONTINUE%
ItemDisplay[RUNE=30]: Ber%CONTINUE%
ItemDisplay[RUNE=31]: Jah%CONTINUE%
ItemDisplay[RUNE=32]: Cham%CONTINUE%
ItemDisplay[RUNE=33]: Zod%CONTINUE%
ItemDisplay[RUNE>19 RUNE<26]: %GREEN%%NAME%%CONTINUE%
ItemDisplay[RUNE>25]: %PURPLE%%NAME%%CONTINUE%

Alias[WSS_SHARD]: %PURPLE%«%BLACK%·%GREEN%» %BLACK%O %NAME% %BLACK%O %GREEN%«%BLACK%·%PURPLE%»


Alias[MAIN_DOT]: O
// PD2 mats frame — used by the Phil777 luxenames rename block. Wraps the
// upstream %NAME% (already coloured by the rename rules in luxenames) in
// the «·» bracket pair with a BLACK O on each side of the name.
Alias[PD2_MATS]: %PURPLE%«%BLACK%·%GREEN%» %BLACK%O %NAME% %BLACK%O %GREEN%«%BLACK%·%PURPLE%»

// Rejuves
ItemDisplay[rvl]: %GREEN%+ %PURPLE%Full %GREEN%+%CONTINUE%



