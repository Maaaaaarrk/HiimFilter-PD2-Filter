//-----------------------------------------------------------------------------------
// Kassahi PD2-item display aliases (Kassahi-only items not in Hiim's shared rules).
//
// Each alias references %MAIN_DOT%, which is defined per Kassahi variant in the
// 03-alias-kassahi-{normal,hyper,luxe,mystery-*}.filter files (• for normal/hyper/
// mystery, O for Luxe). That gives variant-specific decoration without duplicating
// the alias body across five files.
//
// Used by `05-utility/02-Kassahi_pd2items[Kassahi].filter`.
//-----------------------------------------------------------------------------------


// Token of Absolution — literal "Token" label, no %NAME% (boss-room entry)
Alias[TOKEN_DISPLAY]: %RED%%MAIN_DOT%%MAIN_DOT%  %ORANGE%Token  %RED%%MAIN_DOT%%MAIN_DOT%

// Horadrim Scarab — group-content material
Alias[HORADRIC_SCARAB]: %GOLD% %NAME%

// Craft Infusions — one alias per recipe (each is a Pre-made craft recipe with a color motif)
//   crfb = Blood       (red/coral)        — life leech, raw HP, edmg
//   crfc = Caster      (blue/purple)      — fcr, mana, mpk
//   crfs = Safety      (dark/light green) — pdr, edef, resist
//   crfh = Hitpower    (teal/blue)        — fhr, fbr, ctc fnova
//   crfv = Vampiric    (gold/orange)      — ml, plr, dem/und
//   crfu = Bountiful   (sage/yellow)      — mf, lr
//   crfp = Brilliant   (light gray/white) — astat, ias, ares
Alias[CRAFT_BLOOD]:     %CORAL%%MAIN_DOT%%RED%%MAIN_DOT%%MAIN_DOT%   %NAME%   %RED%%MAIN_DOT%%MAIN_DOT%%CORAL%%MAIN_DOT%
Alias[CRAFT_CASTER]:    %BLUE%%MAIN_DOT%%PURPLE%%MAIN_DOT%%MAIN_DOT%   %NAME%   %PURPLE%%MAIN_DOT%%MAIN_DOT%%BLUE%%MAIN_DOT%
Alias[CRAFT_SAFETY]:    %DARK_GREEN%%MAIN_DOT%%GREEN%%MAIN_DOT%%MAIN_DOT%   %NAME%   %GREEN%%MAIN_DOT%%MAIN_DOT%%DARK_GREEN%%MAIN_DOT%
Alias[CRAFT_HITPOWER]:  %TEAL%%MAIN_DOT%%BLUE%%MAIN_DOT%%MAIN_DOT%   %NAME%   %BLUE%%MAIN_DOT%%MAIN_DOT%%TEAL%%MAIN_DOT%
Alias[CRAFT_VAMPIRIC]:  %GOLD%%MAIN_DOT%%ORANGE%%MAIN_DOT%%MAIN_DOT%   %NAME%   %ORANGE%%MAIN_DOT%%MAIN_DOT%%GOLD%%MAIN_DOT%
Alias[CRAFT_BOUNTIFUL]: %SAGE%%MAIN_DOT%%YELLOW%%MAIN_DOT%%MAIN_DOT%   %NAME%   %YELLOW%%MAIN_DOT%%MAIN_DOT%%SAGE%%MAIN_DOT%
Alias[CRAFT_BRILLIANT]: %LIGHT_GRAY%%MAIN_DOT%%WHITE%%MAIN_DOT%%MAIN_DOT%   %NAME%   %WHITE%%MAIN_DOT%%MAIN_DOT%%LIGHT_GRAY%%MAIN_DOT%
