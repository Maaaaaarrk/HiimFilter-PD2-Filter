//-----------------------------------------------------------------------------------
// Alias for item ground annotations
//-----------------------------------------------------------------------------------

// General item
Alias[GEN_ITEM]: %ORANGE%O O O %NAME% %ORANGE%O O O

// Worldstone Shard — mirrors GEN_ITEM (inlined; PD2 doesn't resolve aliases inside Alias[] bodies)
Alias[WSS_SHARD]: %ORANGE%O O O %NAME% %ORANGE%O O O

// General item Alt
Alias[GEN_ALT]: %PURPLE%O O O %NAME% %PURPLE%O O O

// Token parts
Alias[TOKEN_PARTS]: %ORANGE%> > %NAME% %ORANGE%< <

// Uber Keys
Alias[UBER_KEYS]: %RED%o %PURPLE% %NAME% %RED%o

// Boss Mat Item
Alias[BOSS_MAT]: %RED%o %GOLD% %NAME% %RED% o

// Boss Mat Item Alt
Alias[BOSS_ALT]: %RED%o %GOLD% %NAME% %RED% o

// PD2 materials (Project Diablo 2 end-game item wrapper)
Alias[PD2_MATS]: %RED%o %GOLD% %NAME% %RED% o

// Boss Entry Item
Alias[BOSS_ENTRY]: %RED%O O %NAME% %RED%O O

// Rare General Item
Alias[GEN_RARE]: %RED%O%YELLOW%O%GREEN%O%BLUE%O %NAME% %BLUE%O%GREEN%O%YELLOW%O%RED%O

// Rarer General Item
Alias[GEN_TOP_RARE]: %RED%O%YELLOW%O%GREEN%O%BLUE%O %RED%oo %NAME% %RED%oo %BLUE%O%GREEN%O%YELLOW%O%RED%O

// GG General Item Drop
Alias[GEN_GG_ITEM]: %RED%O%YELLOW%O%GREEN%O%BLUE%O %RED%oooo %NAME% %RED%oooo %BLUE%O%GREEN%O%YELLOW%O%RED%O

// Rare GG Item Drop
Alias[RARE_GG_ITEM]: %RED%O%YELLOW%O%GREEN%O%BLUE%O %RED%ooooooo %NAME% %RED%ooooooo %BLUE%O%GREEN%O%YELLOW%O%RED%O

// Unlimited Use items
Alias[RARE_GG_ALT]: %RED%ooooooo %NAME% %RED%ooooooo

// Low rune
Alias[RUNE_LOW]: %PX-0B% %NAME%

// Craft rune
Alias[RUNE_CRAFT]: %DOT-0B% %NAME%

// Mid rune — LEM PUL (RUNE_MID_LOW), UM MAL (RUNE_MID)
Alias[RUNE_MID]: %DOT-9B%%PX-0B%%RED%oo %NAME% %RED%oo
Alias[RUNE_MID_LOW]: %DOT-9B%%PX-0B%%RED%oo %NAME% %RED%oo

// Mid rune Tier 2
Alias[RUNE_ALT_MID]: %BORDER-9B%%DOT-0B%%RED%O%YELLOW%O%GREEN%O%BLUE%O %RED%ooo %NAME% %RED%ooo %BLUE%O%GREEN%O%YELLOW%O%RED%O

// High rune
Alias[RUNE_HIGH]: %BORDER-9B%%MAP-7D%%DOT-0B%%RED%O%YELLOW%O%GREEN%O%BLUE%O %RED%oooooo %NAME% %RED%oooooo %BLUE%O%GREEN%O%YELLOW%O%RED%O %WHITE%

// High rune Tier 2
Alias[RUNE_ALT_HIGH]: %BORDER-9B%%MAP-7D%%DOT-0B%%RED%O%YELLOW%O%GREEN%O%BLUE%O %RED%ooooooo %NAME% %RED%ooooooo %BLUE%O%GREEN%O%YELLOW%O%RED%O

ItemDisplay[RUNE>0]: %RUNENAME% %RUNENUM%%CONTINUE%
ItemDisplay[RUNE>0 RUNE<20]: %ORANGE%%NAME%%CONTINUE%
ItemDisplay[RUNE>19]: %PURPLE%%NAME%%CONTINUE%


// Phil777 label hooks (Phil777 values in 03-alias-kassahi-luxe); defined above the aliases they use
Alias[PHIL777_LOOK]: FALSE
Alias[CHARM_UNID]: %NAME%
Alias[RW_LABEL]: %NAME%

// Magic Item 1 Affix
Alias[MAG_ITEM]: %MAP-6A%%DOT-94%%BLUE%O %NAME% %BLUE%O

// Magic Item 2 Affix
Alias[MAG_DBL_AFFIX_ITEM]: %BORDER-6A%%DOT-94%%BLUE%OOO %NAME% %BLUE%OOO

// Rare Item basic
Alias[RARE_ITEM]: %MAP-0B%%DOT-6A%%ORANGE%O %NAME% %ORANGE%O

// Rare Item Extra
Alias[RARE_PLUS]: %DOT-6A%%YELLOW%O %NAME% %YELLOW%O

// Rare Item High ilvl
Alias[RARE_HIGH_ITEM]: %MAP-0B%%DOT-6A%%YELLOW%OO %NAME% %YELLOW%OO

// Rare Item Good
Alias[RARE_GOOD_ITEM]: %MAP-9B%%DOT-6A%%YELLOW%OOO %NAME% %YELLOW%OOO

// Rare Item GG
Alias[RARE_SUPER]: %BORDER-9B%%DOT-6A%%YELLOW%OOO %YELLOW%o %NAME% %YELLOW%o OOO

// Amazon quiver UNID annotations
Alias[QUIVER_MAG_AMA]: %BLUE%O    %NAME%    O
Alias[QUIVER_RARE_AMA]: %YELLOW%O     %NAME%     O
Alias[QUIVER_RARE_AMA_TIGHT]: %YELLOW%O   %NAME%   O

// Grand-charm callouts (prefixes use %CONTINUE% so they stack with the alias below)
Alias[CHARM_HIGH_LVL]: %YELLOW%hi-lvl %NAME%
Alias[CHARM_MID_LVL]: %BLUE%mid-lvl %NAME%
Alias[CHARM_GC_TAG]: %BLUE%GC
Alias[CHARM_SC_TAG]: %BLUE%SC
Alias[CHARM_LC_TAG]: %BLUE%LC

// Unidentified unique charms (Hellfire Torch / Annihilus / Gheeds Fortune)
Alias[UNI_UNID_TORCH]: %RED%o %PURPLE%%GOLD%  Unidentified Hellfire Torch  %RED%o
Alias[UNI_UNID_ANNI]: %RED%o %PURPLE%%GOLD%  Unidentified Annihilus  %RED%o
Alias[UNI_UNID_GHEEDS]: %RED%o %PURPLE%%GOLD%  Unidentified Gheeds Fortune  %RED%o

// Leveling Tag
Alias[LEVELING_TAG]: %ORANGE%lvling%PX-62%


// FACET Item
Alias[FACET_ITEM]: %BORDER-9B%%MAP-7D%%DOT-6A%%PX-55%%RED%O%ORANGE%O%YELLOW%O%GREEN%O%BLUE%O%PURPLE%O %NAME% %PURPLE%O%BLUE%O%GREEN%O%YELLOW%O%ORANGE%O%RED%O

// Unique Boss Item
Alias[UNI_BOSS_ITEM]: %BORDER-9B%%RED%O%YELLOW%O%GREEN%O%BLUE%O %RED%ooo %NAME% %RED%ooo %RED%O%YELLOW%O%GREEN%O%BLUE%O

// Unique GG Item
Alias[UNI_GG_ITEM]: %BORDER-9B%%DOT-D3%%RED%O%YELLOW%O%GREEN%O%BLUE%O %RED%o %NAME% %RED%o %RED%O%YELLOW%O%GREEN%O%BLUE%O

// Unique Tier3 Item
Alias[UNI_STAR3_ITEM]: %BORDER-D3%%RED%o o o %NAME% %RED%o o o

// Unique Tier2 Item
Alias[UNI_STAR2_ITEM]: %MAP-D3%%RED%o o %NAME% %RED%o o

// Unique Tier1 Item
Alias[UNI_STAR1_ITEM]: %DOT-D3%%RED%o %NAME% %RED%o

// Unique Tier0 Item
Alias[UNI_STAR0_ITEM]: %DOT-D3%%RED%. %NAME% %RED%.


// SET GG Item
Alias[SET_GG_ITEM]: %BORDER-7D%%GREEN%o o o o %NAME% %GREEN%o o o o

// SET Tier3 Item
Alias[SET_TIER3_ITEM]: %MAP-7D%%GREEN%o o o %NAME% %GREEN%o o o

// SET Tier2 Item
Alias[SET_TIER2_ITEM]: %DOT-7D%%GREEN%o o %NAME% %GREEN%o o

// SET Tier1 Item
Alias[SET_TIER1_ITEM]: %DOT-7D%%GREEN%o %NAME% %GREEN%o

// RW Bases GG
Alias[RW_BASE_GG]: %BORDER-9B%%DOT-0E%%SOUNDID-4719% %NAME% %PURPLE%

// RW Bases Orange Alt Text
Alias[RW_BASE_ALT_ORANGE]: %NAME% %DOT-0B%%ORANGE%

// RW Bases Orange Text
Alias[RW_BASE_ORANGE]: %NAME% %DOT-0B%%ORANGE%< < <

// RW Bases Green Text
Alias[RW_BASE_GREEN]: %NAME% %DOT-76%%DARK_GREEN%

// RW Bases Lower Green Text
Alias[RW_BASE_LOW_GREEN]: %NAME% %DOT-7D%%GREEN%OOO

// Craft 2 Item Base
Alias[CRAFT_TWO]: %GREEN%O O %NAME% %DOT-94%%GREEN%[Craft] O O

// Craft 1 Item Base
Alias[CRAFT_ONE]: %GREEN%O %NAME% %DOT-94%%GREEN%[Craft] O

// Craft Item Base
Alias[CRAFT_ZERO]: %NAME% %GREEN%[Craft]

// LLD Craft Item Base
Alias[CRAFT_LLD]: %NAME% %GREEN%[LLD Craft]



//-----------------------------------------------------------------------------------
// General Item re-names
//-----------------------------------------------------------------------------------

ItemDisplay[RUNE>0 RUNE<21 FILTLVL>7]: %RUNENAME%{%NAME%}%CONTINUE%

ItemDisplay[wss]: %PURPLE%WORLDSTONE SHARD%CONTINUE%
ItemDisplay[cwss]: %ORANGE%Tainted %PURPLE%WORLDSTONE SHARD%CONTINUE%

// Craft Infusion renames — set the name here so 05-utility/06-Gems tooltips
// don't override formatting with hardcoded text.
ItemDisplay[crfb]: %RED%Blood %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfc]: %PURPLE%Caster %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfs]: %GREEN%Safety %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfh]: %BLUE%Hitpower %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfv]: %GRAY%Vampiric %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfu]: %YELLOW%Bountiful %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfp]: %WHITE%Brilliant %GOLD%Craft Infusion%CONTINUE%

// Formating for names
ItemDisplay[gzv OR gzvs]: %PURPLE%O Amethyst O%CONTINUE%
ItemDisplay[gpv OR gpvs]: %PURPLE%O  P Amethyst  O%CONTINUE%
ItemDisplay[glw OR glws]: %PURPLE%O %WHITE%Diamond %PURPLE%O%CONTINUE%
ItemDisplay[gpw OR gpws]: %PURPLE%O  %WHITE%P Diamond  %PURPLE%O%CONTINUE%
ItemDisplay[glg OR glgs]: %GREEN%O Emerald O%CONTINUE%
ItemDisplay[gpg OR gpgs]: %GREEN%O  P Emerald  O%CONTINUE%
ItemDisplay[glr OR glrs]: %RED%O Ruby O%CONTINUE%
ItemDisplay[gpr OR gprs]: %RED%O  P Ruby  O%CONTINUE%
ItemDisplay[glb OR glbs]: %BLUE%O Sapphire O%CONTINUE%
ItemDisplay[gpb OR gpbs]: %BLUE%O  P Sapphire  O%CONTINUE%
ItemDisplay[gly OR glys]: %YELLOW%O Topaz O%CONTINUE%
ItemDisplay[gpy OR gpys]: %YELLOW%O  P Topaz  O%CONTINUE%
ItemDisplay[skl OR skls]: %CORAL%O %LIGHT_GRAY%Skull %CORAL%O%CONTINUE%
ItemDisplay[skz OR skzs]: %CORAL%O O  %LIGHT_GRAY%P Skull  %CORAL%O O%CONTINUE%
ItemDisplay[GEM=4 FILTLVL<3]: %WHITE%F %NAME%%CONTINUE%

ItemDisplay[(crfb OR crfc OR crfs OR crfh OR crfv OR crfu OR crfp) QTY>1 QTY<51]: %NAME% %QTY_TAG%%CONTINUE%{%NAME%}
ItemDisplay[(crfb OR crfc OR crfs OR crfh OR crfv OR crfu OR crfp)]: %ORANGE%O o O %NAME% %ORANGE%O o O%CONTINUE%{%NAME%}
