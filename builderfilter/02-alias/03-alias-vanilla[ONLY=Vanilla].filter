//-----------------------------------------------------------------------------------
// Alias for item ground annotations Vanilla++
//-----------------------------------------------------------------------------------

// General item
Alias[GEN_ITEM]: %NAME%

// Worldstone Shard — mirrors GEN_ITEM (inlined; PD2 doesn't resolve aliases inside Alias[] bodies)
Alias[WSS_SHARD]: %NAME%

// General item Alt
Alias[GEN_ALT]: %PURPLE%·   %NAME%   %PURPLE%·

// Token parts
Alias[TOKEN_PARTS]: %ORANGE%•   %NAME%   %ORANGE%•

// Uber Keys
Alias[UBER_KEYS]: %RED%•   %NAME%   %RED%•

// Boss Mat Item
Alias[BOSS_MAT]: %YELLOW%••   %NAME%   %YELLOW%••

// Boss Mat Item Alt
Alias[BOSS_ALT]: %YELLOW%••   %NAME%   %YELLOW%••

// PD2 materials (Project Diablo 2 end-game item wrapper)
Alias[PD2_MATS]: %YELLOW%••   %NAME%   %YELLOW%••

// Boss Entry Item
Alias[BOSS_ENTRY]: %RED%• •   %NAME%   %RED%• •

// Rare General Item
Alias[GEN_RARE]: %ORANGE%••  %NAME%  %ORANGE%••

// Rarer General Item
Alias[GEN_TOP_RARE]: %DARK_GREEN%••  %NAME%  %DARK_GREEN%••

// GG General Item Drop
Alias[GEN_GG_ITEM]: %PURPLE%••  %NAME%  %PURPLE%••

// Rare GG Item Drop
Alias[RARE_GG_ITEM]: %PURPLE%•%GREEN%!%PURPLE%• %PURPLE%•%GREEN%!%PURPLE%• %PURPLE%•%GREEN%!%PURPLE%• %NAME% %PURPLE%•%GREEN%!%PURPLE%• %PURPLE%•%GREEN%!%PURPLE%• %PURPLE%•%GREEN%!%PURPLE%•

// Unlimited Use items
Alias[RARE_GG_ALT]: %RED%•·•·•   %NAME%   %RED%•·•·•

// Low rune
Alias[RUNE_LOW]: %PX-0B%%ORANGE% %NAME% %ORANGE%

// Craft rune
Alias[RUNE_CRAFT]: %PX-0B%%DARK_GREEN%•%ORANGE% %NAME% %DARK_GREEN%•

// Mid rune — LEM PUL (RUNE_MID_LOW), UM MAL (RUNE_MID)
Alias[RUNE_MID]: %DOT-9B%%PX-0B%%GREEN%••   %NAME%   %GREEN%••
Alias[RUNE_MID_LOW]: %DOT-9B%%PX-0B%%GREEN%••   %NAME%   %GREEN%••

// Mid rune Tier 2
Alias[RUNE_ALT_MID]: %BORDER-9B%%DOT-0B%%GREEN%••   %NAME%   %GREEN%••

// High rune
Alias[RUNE_HIGH]: %BORDER-9B%%MAP-7D%%DOT-0B%%PURPLE%•%ORANGE%!%PURPLE%•    %NAME%    %PURPLE%•%ORANGE%!%PURPLE%•

// High rune Tier 2
Alias[RUNE_ALT_HIGH]: %BORDER-9B%%MAP-7D%%DOT-0B%%PURPLE%•%GREEN%!%PURPLE%•    %NAME%    %PURPLE%•%GREEN%!%PURPLE%•


// Magic Item 1 Affix
Alias[MAG_ITEM]: %MAP-6A%%DOT-94%%NAME%

// Magic Item 2 Affix
Alias[MAG_DBL_AFFIX_ITEM]: %BORDER-6A%%DOT-94%%NAME%

// Rare Item basic
Alias[RARE_ITEM]: %MAP-0B%%DOT-6A%%NAME%

// Rare Item Extra
Alias[RARE_PLUS]: %DOT-6A%%YELLOW%· %NAME% %YELLOW%·

// Rare Item High ilvl
Alias[RARE_HIGH_ITEM]: %MAP-0B%%DOT-6A%%YELLOW%· %NAME% %YELLOW%·

// Rare Item Good
Alias[RARE_GOOD_ITEM]: %MAP-9B%%DOT-6A%%PURPLE%·   %NAME%   %PURPLE%·

// Rare Item GG
Alias[RARE_SUPER]: %BORDER-9B%%DOT-6A%%PURPLE%•   %NAME%   %PURPLE%•

// Amazon quiver UNID annotations
Alias[QUIVER_MAG_AMA]: %NAME%
Alias[QUIVER_RARE_AMA]: %NAME%
Alias[QUIVER_RARE_AMA_TIGHT]: %NAME%

// Grand-charm callouts (prefixes use %CONTINUE% so they stack with the alias below)
Alias[CHARM_HIGH_LVL]: %BLUE%hi-lvl %NAME%
Alias[CHARM_MID_LVL]: %BLUE%mid-lvl %NAME%
Alias[CHARM_GC_TAG]: %BLUE%Gr Charm
Alias[CHARM_SC_TAG]: %BLUE%Sm Charm
Alias[CHARM_LC_TAG]: %BLUE%Lg Charm

// Unidentified unique charms (Hellfire Torch / Annihilus / Gheeds Fortune)
Alias[UNI_UNID_TORCH]: %NAME%
Alias[UNI_UNID_ANNI]: %NAME%
Alias[UNI_UNID_GHEEDS]: %NAME%

// Leveling Tag
Alias[LEVELING_TAG]: %ORANGE%lvling%PX-62%


// FACET Item
Alias[FACET_ITEM]: %BORDER-9B%%MAP-7D%%DOT-6A%%PX-55%%RED%•%ORANGE%•%YELLOW%•%GREEN%•%BLUE%•%PURPLE%• %NAME% %PURPLE%•%BLUE%•%GREEN%•%YELLOW%•%ORANGE%•%RED%•

// Unique Boss Item
Alias[UNI_BOSS_ITEM]: %BORDER-9B%%RED%X%ORANGE%X%YELLOW%X%GREEN%X%BLUE%X%PURPLE%X %NAME% %PURPLE%X%BLUE%X%GREEN%X%YELLOW%X%ORANGE%X%RED%X

// Unique GG Item
Alias[UNI_GG_ITEM]: %BORDER-9B%%DOT-D3%%GOLD%• • • • %NAME% %GOLD%• • • •

// Unique Tier3 Item
Alias[UNI_STAR3_ITEM]: %BORDER-D3%%GOLD%• • • %NAME% %GOLD%• • •

// Unique Tier2 Item
Alias[UNI_STAR2_ITEM]: %MAP-D3%%GOLD%• • %NAME% %GOLD%• •

// Unique Tier1 Item
Alias[UNI_STAR1_ITEM]: %DOT-D3%%GOLD%• %NAME% %GOLD%•

// Unique Tier0 Item
Alias[UNI_STAR0_ITEM]: %DOT-D3%%GOLD%. %NAME% %GOLD%.


// SET GG Item
Alias[SET_GG_ITEM]: %BORDER-7D%%GREEN%• • • • %NAME% %GREEN%• • • •

// SET Tier3 Item
Alias[SET_TIER3_ITEM]: %MAP-7D%%GREEN%• • • %NAME% %GREEN%• • •

// SET Tier2 Item
Alias[SET_TIER2_ITEM]: %DOT-7D%%GREEN%• • %NAME% %GREEN%• •

// SET Tier1 Item
Alias[SET_TIER1_ITEM]: %DOT-7D%%GREEN%• %NAME% %GREEN%•

// RW Bases GG
Alias[RW_BASE_GG]: %BORDER-9B%%DOT-0E%%SOUNDID-4719% %NAME% %PURPLE%

// RW Bases Orange Alt Text
Alias[RW_BASE_ALT_ORANGE]: %NAME% %DOT-0B%%ORANGE%

// RW Bases Orange Text
Alias[RW_BASE_ORANGE]: %NAME% %DOT-0B%

// RW Bases Green Text
Alias[RW_BASE_GREEN]: %NAME% %DOT-76%%DARK_GREEN%

// RW Bases Lower Green Text
Alias[RW_BASE_LOW_GREEN]: %NAME% %DOT-7D%

// Craft 2 Item Base
Alias[CRAFT_TWO]: %GREEN%• %NAME% %DOT-94%%GREEN%•

// Craft 1 Item Base
Alias[CRAFT_ONE]: %GREEN% %NAME% %DOT-94%

// Craft Item Base
Alias[CRAFT_ZERO]: %NAME%

// LLD Craft Item Base
Alias[CRAFT_LLD]: %NAME%



//-----------------------------------------------------------------------------------
// General Item re-names
//-----------------------------------------------------------------------------------

ItemDisplay[RUNE>0 RUNE<21 FILTLVL>7]: %RUNENAME%{%NAME%}%CONTINUE%

ItemDisplay[wss]: %RED%WORLDSTONE SHARD%CONTINUE%
ItemDisplay[cwss]: %ORANGE%Tainted %RED%WORLDSTONE SHARD%CONTINUE%remo

// Craft Infusion renames — set the name here so 05-utility/06-Gems tooltips
// don't override formatting with hardcoded text.
ItemDisplay[crfb]: %RED%Blood %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfc]: %PURPLE%Caster %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfs]: %GREEN%Safety %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfh]: %BLUE%Hitpower %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfv]: %GRAY%Vampiric %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfu]: %YELLOW%Bountiful %GOLD%Craft Infusion%CONTINUE%
ItemDisplay[crfp]: %WHITE%Brilliant %GOLD%Craft Infusion%CONTINUE%

// Formating for names
ItemDisplay[gzv OR gzvs]: %PURPLE%Amethyst%CONTINUE%
ItemDisplay[gpv OR gpvs]: %PURPLE%O  P Amethyst  O%CONTINUE%
ItemDisplay[glw OR glws]: %WHITE%Diamond%CONTINUE%
ItemDisplay[gpw OR gpws]: %PURPLE%O  %WHITE%P Diamond  %PURPLE%O%CONTINUE%
ItemDisplay[glg OR glgs]: %GREEN%Emerald%CONTINUE%
ItemDisplay[gpg OR gpgs]: %GREEN%O  P Emerald  O%CONTINUE%
ItemDisplay[glr OR glrs]: %RED%Ruby%CONTINUE%
ItemDisplay[gpr OR gprs]: %RED%O  P Ruby  O%CONTINUE%
ItemDisplay[glb OR glbs]: %BLUE%Sapphire%CONTINUE%
ItemDisplay[gpb OR gpbs]: %BLUE%O  P Sapphire  O%CONTINUE%
ItemDisplay[gly OR glys]: %YELLOW%Topaz%CONTINUE%
ItemDisplay[gpy OR gpys]: %YELLOW%O  P Topaz  O%CONTINUE%
ItemDisplay[skl OR skls]: %CORAL%· %LIGHT_GRAY%Skull %CORAL%·%CONTINUE%
ItemDisplay[skz OR skzs]: %CORAL%O O  %LIGHT_GRAY%P Skull  %CORAL%O O%CONTINUE%
ItemDisplay[gem=4 FILTLVL<3]: %WHITE%F %NAME%%CONTINUE%

ItemDisplay[(crfb OR crfc OR crfs OR crfh OR crfv OR crfu OR crfp) QTY>1 QTY<51]: %NAME% %QTY_TAG%%CONTINUE%{%NAME%}
