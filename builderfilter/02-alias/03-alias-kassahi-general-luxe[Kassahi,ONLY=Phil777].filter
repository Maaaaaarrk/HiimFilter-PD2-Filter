//-----------------------------------------------------------------------------------
// Kassahi philanthropy777 — item ground annotations (parity with Hiim's 03-alias-general)
//-----------------------------------------------------------------------------------

// General item
Alias[GEN_ITEM]: %BLACK%@%PURPLE%O%GREEN%O%BLACK%@ %NAME% %BLACK%@%GREEN%O%PURPLE%O%BLACK%@

// General item Alt
Alias[GEN_ALT]: %BLACK%@%PURPLE%O%RED%O%BLACK%@ %NAME% %BLACK%@%RED%O%PURPLE%O%BLACK%@

// Token parts
Alias[TOKEN_PARTS]: %ORANGE%«·»  %NAME%  %ORANGE%«·»

// Uber Keys
Alias[UBER_KEYS]: %RED%«·» «·»  %NAME%  %RED%«·» «·»

// Boss Mat Item
