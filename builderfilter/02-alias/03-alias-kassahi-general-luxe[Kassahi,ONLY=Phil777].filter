// Boss Mat Item Alt
Alias[BOSS_ALT]: %YELLOW%O O O O %NAME% %YELLOW%O O O O

// Boss Entry Item
Alias[BOSS_ENTRY]: %RED%O O %NAME% %RED%O O

// Rare General Item
Alias[GEN_RARE]: %ORANGE%«·» «·» «·» %NAME% %ORANGE%«·» «·» «·»

// Rarer General Item
Alias[GEN_TOP_RARE]: %DARK_GREEN%«·» «·» «·» %NAME% %DARK_GREEN%«·» «·» «·»

// GG General Item Drop
Alias[GEN_GG_ITEM]: %PURPLE%«·» «·» «·» %NAME% %PURPLE%«·» «·» «·»

// Rare GG Item Drop
Alias[RARE_GG_ITEM]: %PURPLE%«%GREEN%·%PURPLE%» «%GREEN%·%PURPLE%» «%GREEN%·%PURPLE%» «%GREEN%·%PURPLE%» %NAME% %PURPLE%«%GREEN%·%PURPLE%» «%GREEN%·%PURPLE%» «%GREEN%·%PURPLE%» «%GREEN%·%PURPLE%»

// Unlimited Use items
