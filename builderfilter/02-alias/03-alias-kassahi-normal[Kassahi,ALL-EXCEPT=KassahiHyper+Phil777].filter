// PD2 Shards decoration alias (used by wss/cwss rules in 05-utility/02-Kassahi_pd2items)
//-----------------------------------------------------------------------------------

// Map frames (issue #981; used in 05-utility/05-Kassahi_maps-2[ONLY=KassahiStd])
Alias[UNI_MAPS]: %PX-20%%DOT-62%%MAP-21%%BORDER-80%%SOUNDID-4718%%PURPLE%••%RED%••%ORANGE%•  %NAME%  %ORANGE%•%RED%••%PURPLE%••
Alias[COW_MAP]: %PX-62%%DOT-21%%MAP-80%%SOUNDID-4717%%PURPLE%•%RED%•  %NAME%  %RED%•%PURPLE%•
Alias[NORMAL_MAPS]: %DOT-80%%NAME%

ItemDisplay[RUNE>0]: %RUNENAME%%CONTINUE%
// Vex+ stay red (the RUNE_HIGH / RUNE_ALT_HIGH / RUNE_TOP_HIGH frames colour the name)
ItemDisplay[RUNE>0 RUNE<26]: %ORANGE%%NAME%%CONTINUE%
// Rune names, El-Gul orange, Vex-Zod red (issue #981)
ItemDisplay[RUNE=01]: %ORANGE%El%CONTINUE%
ItemDisplay[RUNE=02]: %ORANGE%Eld%CONTINUE%
ItemDisplay[RUNE=03]: %ORANGE%Tir%CONTINUE%
ItemDisplay[RUNE=04]: %ORANGE%Nef%CONTINUE%
ItemDisplay[RUNE=05]: %ORANGE%Eth%CONTINUE%
ItemDisplay[RUNE=06]: %ORANGE%Ith%CONTINUE%
ItemDisplay[RUNE=07]: %ORANGE%Tal%CONTINUE%
ItemDisplay[RUNE=08]: %ORANGE%Ral%CONTINUE%
ItemDisplay[RUNE=09]: %ORANGE%Ort%CONTINUE%
