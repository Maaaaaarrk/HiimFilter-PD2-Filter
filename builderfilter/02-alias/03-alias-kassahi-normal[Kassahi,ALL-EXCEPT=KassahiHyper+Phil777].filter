ItemDisplay[RUNE=12]: %ORANGE%Sol%CONTINUE%
ItemDisplay[RUNE=13]: %ORANGE%Shael%CONTINUE%
ItemDisplay[RUNE=14]: %ORANGE%Dol%CONTINUE%
ItemDisplay[RUNE=15]: %ORANGE%Hel%CONTINUE%
ItemDisplay[RUNE=16]: %ORANGE%Io%CONTINUE%
ItemDisplay[RUNE=17]: %ORANGE%Lum%CONTINUE%
ItemDisplay[RUNE=18]: %ORANGE%Ko%CONTINUE%
ItemDisplay[RUNE=19]: %ORANGE%Fal%CONTINUE%
ItemDisplay[RUNE=20]: %ORANGE%Lem%CONTINUE%
ItemDisplay[RUNE=21]: %ORANGE%Pul%CONTINUE%
ItemDisplay[RUNE=22]: %ORANGE%Um%CONTINUE%
ItemDisplay[RUNE=23]: %ORANGE%Mal%CONTINUE%
ItemDisplay[RUNE=24]: %ORANGE%Ist%CONTINUE%
ItemDisplay[RUNE=25]: %ORANGE%Gul%CONTINUE%
ItemDisplay[RUNE=26]: %RED%Vex%CONTINUE%
ItemDisplay[RUNE=27]: %RED%Ohm%CONTINUE%
ItemDisplay[RUNE=28]: %RED%Lo%CONTINUE%
ItemDisplay[RUNE=29]: %RED%Sur%CONTINUE%
ItemDisplay[RUNE=30]: %RED%Ber%CONTINUE%
ItemDisplay[RUNE=31]: %RED%Jah%CONTINUE%
ItemDisplay[RUNE=32]: %RED%Cham%CONTINUE%
ItemDisplay[RUNE=33]: %RED%Zod%CONTINUE%
// Runes 1-20: keep the rune-name annotation tooltip at higher filter levels
// (Hiim suppresses these above FILTLVL 7; Kassahi keeps them visible).
ItemDisplay[RUNE>0 RUNE<21]: %NAME%{%NAME%}%CONTINUE%

Alias[WSS_SHARD]: %SOUNDID-4715%%PX-9B%%DOT-0A%%PURPLE%•%RED%•%CORAL%•  %NAME%  %CORAL%•%RED%•%PURPLE%•

