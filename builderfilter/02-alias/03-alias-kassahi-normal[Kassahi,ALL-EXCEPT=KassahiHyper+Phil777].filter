//-----------------------------------------------------------------------------------
// Kassahi normal — full alias set (covers Regular-Normal, Meme, Mystery-Normal)
//
// Merged from the legacy two-file layout:
//   * `03-alias-kassahi-general-normal` (GEN_*, BOSS_*, RUNE_*, MAG_*, RARE_*,
//     UNI_*, SET_*, FACET_*, RW_BASE_*, CRAFT_*, etc. — visuals shared by this
//     variant's family)
//   * `03-alias-kassahi-normal` (GG_* item-specific aliases, MAIN_DOT,
//     PD2_MATS, plus the rvl rename and gem name re-formatting)
//-----------------------------------------------------------------------------------

// === Set 2: shared visual-family aliases (general) ===

// General item — orange triplet
Alias[GEN_ITEM]: %NAME%

// General item Alt
Alias[GEN_ALT]: %NAME%

// Token parts
Alias[TOKEN_PARTS]: %SOUNDID-4715%%PX-9B%%DOT-62%%PURPLE%«%BLACK%·%RED%»  %NAME%  %RED%«%BLACK%·%PURPLE%»

// Uber Keys
Alias[UBER_KEYS]: %SOUNDID-4715%%PX-9B%%DOT-62%%PURPLE%«%BLACK%·%RED%»  %NAME%  %RED%«%BLACK%·%PURPLE%»

// Boss Mat Item
Alias[BOSS_MAT]: %SOUNDID-4715%%PX-9B%%DOT-62%%PURPLE%«%BLACK%·%RED%»  %NAME%  %RED%«%BLACK%·%PURPLE%»

// Boss Mat Item Alt
Alias[BOSS_ALT]: %NAME%

// Boss Entry Item
