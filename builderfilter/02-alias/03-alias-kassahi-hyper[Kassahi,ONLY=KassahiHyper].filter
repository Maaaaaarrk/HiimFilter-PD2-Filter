// Craft rune
Alias[RUNE_CRAFT]: %DOT-0B%%GREEN%••  %NAME%  %GREEN%••

// Mid rune — LEM PUL (RUNE_MID_LOW), UM MAL (RUNE_MID); 2-doublet PURPLE/GREEN alternation
