//-----------------------------------------------------------------------------------
// Kassahi hyper — full alias set (covers Regular-Hyper, Meme-Hyper, Mystery-Hyper)
//
// Merged from the legacy two-file layout:
//   * `03-alias-kassahi-general-hyper` (GEN_*, BOSS_*, RUNE_*, MAG_*, RARE_*,
//     UNI_*, SET_*, FACET_*, RW_BASE_*, CRAFT_*, etc. — visuals shared by this
//     variant's family)
//   * `03-alias-kassahi-hyper` (GG_* item-specific aliases, MAIN_DOT,
//     PD2_MATS, plus the rvl rename and gem name re-formatting)
//-----------------------------------------------------------------------------------

// === Set 2: shared visual-family aliases (general) ===

// General item — orange @@ triplet
Alias[GEN_ITEM]: %ORANGE%@@%BLACK%@ %ORANGE%@@%BLACK%@ %NAME% %BLACK%@%ORANGE%@@ %BLACK%@%ORANGE%@@

// General item Alt
Alias[GEN_ALT]: %PURPLE%@@%BLACK%@ %PURPLE%@@%BLACK%@ %NAME% %BLACK%@%PURPLE%@@ %BLACK%@%PURPLE%@@

// Token parts
Alias[TOKEN_PARTS]: %ORANGE%@%BLACK%@ %NAME% %BLACK%@%ORANGE%@

// Uber Keys
Alias[UBER_KEYS]: %RED%@@%ORANGE%@@%RED%@@   %NAME%   %RED%@@%ORANGE%@@%RED%@@

// Boss Mat Item
Alias[BOSS_MAT]: %YELLOW%@%ORANGE%@%YELLOW%@%ORANGE%@%YELLOW%@ %NAME% %YELLOW%@%ORANGE%@%YELLOW%@%ORANGE%@%YELLOW%@

// Boss Mat Item Alt
Alias[BOSS_ALT]: %YELLOW%@@@@ %NAME% %YELLOW%@@@@

// Boss Entry Item
Alias[BOSS_ENTRY]: %RED%@@@ %NAME% %RED%@@@

// Rare General Item — orange-red doublet pattern
Alias[GEN_RARE]: %ORANGE%@%RED%@%ORANGE%@   %NAME%   %ORANGE%@%RED%@%ORANGE%@

// Rarer General Item — dark green emphasis
Alias[GEN_TOP_RARE]: %DARK_GREEN%@%GREEN%@%DARK_GREEN%@   %NAME%   %DARK_GREEN%@%GREEN%@%DARK_GREEN%@

// GG General Item Drop — full warm gradient
Alias[GEN_GG_ITEM]: %PURPLE%@%RED%@%ORANGE%@%YELLOW%@   %NAME%   %YELLOW%@%ORANGE%@%RED%@%PURPLE%@

// Rare GG Item Drop — gradient with white accent
Alias[RARE_GG_ITEM]: %PURPLE%@@%RED%@@%ORANGE%@@%YELLOW%@@ %WHITE%•   %NAME%   %WHITE%• %YELLOW%@@%ORANGE%@@%RED%@@%PURPLE%@@

// Unlimited Use items
Alias[RARE_GG_ALT]: %PURPLE%X%RED%@%PURPLE%X%RED%@%PURPLE%X %NAME% %PURPLE%X%RED%@%PURPLE%X%RED%@%PURPLE%X

// Flawless Gems
Alias[FLAW_GEM1]: %PURPLE%•  %NAME%  %PURPLE%•
Alias[FLAW_GEM2]: %WHITE%•  %NAME%  %WHITE%•
Alias[FLAW_GEM3]: %GREEN%•  %NAME%  %GREEN%•
Alias[FLAW_GEM4]: %RED%•  %NAME%  %RED%•
Alias[FLAW_GEM5]: %BLUE%•  %NAME%  %BLUE%•
Alias[FLAW_GEM6]: %YELLOW%•  %NAME%  %YELLOW%•
Alias[FLAW_GEM7]: %ORANGE%•  %NAME%  %ORANGE%•

// Perfect Gems
Alias[PERF_GEM1]: %PURPLE%••  %NAME%  %PURPLE%••
Alias[PERF_GEM2]: %WHITE%••  %NAME%  %WHITE%••
Alias[PERF_GEM3]: %GREEN%••  %NAME%  %GREEN%••
Alias[PERF_GEM4]: %RED%••  %NAME%  %RED%••
Alias[PERF_GEM5]: %BLUE%••  %NAME%  %BLUE%••
Alias[PERF_GEM6]: %YELLOW%••  %NAME%  %YELLOW%••
Alias[PERF_GEM7]: %ORANGE%••  %NAME%  %ORANGE%••

// Infusion Orbs
Alias[INFUSION1]: %BLUE%•%PURPLE%••  %NAME%  %PURPLE%••%BLUE%•
Alias[INFUSION2]: %LIGHT_GRAY%•%WHITE%••  %NAME%  %WHITE%••%LIGHT_GRAY%•
Alias[INFUSION3]: %DARK_GREEN%•%GREEN%••  %NAME%  %GREEN%••%DARK_GREEN%•
Alias[INFUSION4]: %CORAL%•%RED%••  %NAME%  %RED%••%CORAL%•
Alias[INFUSION5]: %TEAL%•%BLUE%••  %NAME%  %BLUE%••%TEAL%•
Alias[INFUSION6]: %SAGE%•%YELLOW%••  %NAME%  %YELLOW%••%SAGE%•
Alias[INFUSION7]: %TAN%•%ORANGE%••  %NAME%  %ORANGE%••%TAN%•

// Low rune — single red @ pair (matches upstream RUNE 20-21 hyper styling)
Alias[RUNE_LOW]: %PX-0B%%GREEN%•  %ORANGE%%NAME%  %GREEN%•

// Craft rune
Alias[RUNE_CRAFT]: %DOT-0B%%GREEN%••  %ORANGE%%NAME%  %GREEN%••

// Mid rune — LEM PUL (RUNE_MID_LOW), UM MAL (RUNE_MID); 2-doublet PURPLE/GREEN alternation
Alias[RUNE_MID]: %DOT-9B%%PX-0B%%GREEN%@%BLACK%@  %ORANGE%%NAME%  %BLACK%@%GREEN%@
Alias[RUNE_MID_LOW]: %DOT-9B%%PX-0B%%PURPLE%@%BLACK%@ %GREEN%@%BLACK%@  %ORANGE%%NAME%  %BLACK%@%GREEN%@ %BLACK%@%PURPLE%@

// Mid rune Tier 2 — 3-doublet
Alias[RUNE_ALT_MID]: %BORDER-9B%%DOT-0B%%PURPLE%@@%BLACK%@ %GREEN%@@%BLACK%@ %PURPLE%@@%BLACK%@ %NAME% %BLACK%@%PURPLE%@@ %BLACK%@%GREEN%@@ %BLACK%@%PURPLE%@@

// High rune — full triple PURPLE/GREEN with map+border (matches upstream RUNE 26-28 hyper)
Alias[RUNE_HIGH]: %BORDER-9B%%MAP-7D%%DOT-0B%%PURPLE%@@@%BLACK%@ %GREEN%@@@%BLACK%@  %WHITE%• %RED%%NAME% %WHITE%•  %BLACK%@%GREEN%@@@ %BLACK%@%PURPLE%@@@

// High rune Tier 2 — wider spacing (matches upstream RUNE 30, 33 hyper)
Alias[RUNE_ALT_HIGH]: %BORDER-9B%%MAP-7D%%DOT-0B%%PURPLE%@@%BLACK%@ %GREEN%@@@%BLACK%@ %PURPLE%@@@%BLACK%@ %GREEN%@@@%BLACK%@  %WHITE%• %RED%%NAME% %WHITE%•  %BLACK%@%GREEN%@@@ %BLACK%@%PURPLE%@@@ %BLACK%@%GREEN%@@@ %BLACK%@%PURPLE%@@


// Magic Item 1 Affix — matches upstream FMT_MAG_T3 body
Alias[MAG_ITEM]: %MAP-6A%%DOT-94%%PURPLE%•  %NAME%  %PURPLE%•

// Magic Item 2 Affix — matches upstream FMT_MAG_GG body
Alias[MAG_DBL_AFFIX_ITEM]: %BORDER-6A%%DOT-94%%PURPLE%•%WHITE%•  %NAME%  %WHITE%•%PURPLE%•

// Rare Item basic — matches upstream FMT_RARE_T3 body
Alias[RARE_ITEM]: %PX-20%%DOT-21%%MAP-6D%%SAGE%•%YELLOW%•%WHITE%•   %NAME%   %WHITE%•%YELLOW%•%SAGE%•

// Rare Item Extra
Alias[RARE_PLUS]: %DOT-6A%@ %NAME% @

// Rare Item High ilvl — matches upstream FMT_RARE_T3 body
Alias[RARE_HIGH_ITEM]: %PX-20%%DOT-21%%MAP-6D%%SAGE%•%YELLOW%•%WHITE%•   %NAME%   %WHITE%•%YELLOW%•%SAGE%•

// Rare Item Good — matches upstream FMT_RARE_GG body
Alias[RARE_GOOD_ITEM]: %DOT-20%%MAP-21%%BORDER-6D%%SAGE%••%YELLOW%••%WHITE%•   %NAME%   %WHITE%•%YELLOW%••%SAGE%••

// Rare Item GG — matches upstream FMT_RARE_JEWEL body
Alias[RARE_SUPER]: %DOT-20%%MAP-21%%BORDER-6D%%SAGE%•••%YELLOW%•••%WHITE%••   %NAME%   %WHITE%••%YELLOW%•••%SAGE%•••

// Amazon quiver UNID annotations — Kassahi-hyper x style
Alias[QUIVER_MAG_AMA]: %BLUE%x  %NAME%  x
Alias[QUIVER_RARE_AMA]: %YELLOW%x   %NAME%   x
Alias[QUIVER_RARE_AMA_TIGHT]: %YELLOW%x %NAME% x

// Grand-charm callouts
Alias[CHARM_HIGH_LVL]: %YELLOW%High Lvl %NAME%
Alias[CHARM_MID_LVL]: %BLUE%Mid Lvl %NAME%
Alias[CHARM_GC_TAG]: %BORDER-6A%%DOT-94%%BLUE%xXx GC xXx
Alias[CHARM_SC_TAG]: %BLUE%SC
Alias[CHARM_LC_TAG]: %BLUE%LC

// Unidentified unique charms
Alias[UNI_UNID_TORCH]: %RED%x %GOLD%Unidentified Hellfire Torch %RED%x
Alias[UNI_UNID_ANNI]: %RED%x %GOLD%Unidentified Annihilus %RED%x
Alias[UNI_UNID_GHEEDS]: %RED%x %GOLD%Unidentified Gheeds Fortune %RED%x

// Leveling Tag
Alias[LEVELING_TAG]: %SAGE%lvling%PX-62%


// FACET Item — full rainbow + gold name
Alias[FACET_ITEM]: %BORDER-9B%%MAP-7D%%DOT-6A%%PX-55%%RED%@%ORANGE%@%YELLOW%@%GREEN%@%BLUE%@%PURPLE%@ %GOLD%%NAME% %PURPLE%@%BLUE%@%GREEN%@%YELLOW%@%ORANGE%@%RED%@

// Unique Boss Item — full rainbow + gold name
Alias[UNI_BOSS_ITEM]: %BORDER-9B%%RED%X%ORANGE%X%YELLOW%X%GREEN%X%BLUE%X%PURPLE%X %GOLD%%NAME% %PURPLE%X%BLUE%X%GREEN%X%YELLOW%X%ORANGE%X%RED%X

// Unique GG Item — Kassahi-Hyper GG (xX gradient + WHITE accent + PURPLE name) — matches UNID_GG
Alias[UNI_GG_ITEM]: %BORDER-9B%%DOT-D3%%PURPLE%xX%RED%xX%ORANGE%xX%YELLOW%xX   %WHITE%• %PURPLE%%NAME%%WHITE% •   %YELLOW%Xx%ORANGE%Xx%RED%Xx%PURPLE%Xx

// Unique Tier3 Item — 3-doublet PURPLE-RED-ORANGE + GOLD name (matches UNID_T3)
Alias[UNI_STAR3_ITEM]: %BORDER-D3%%PURPLE%xX%RED%xX%ORANGE%xX  %GOLD%%NAME%%ORANGE%  Xx%RED%Xx%PURPLE%Xx

// Unique Tier2 Item — 2-doublet RED-ORANGE + GOLD name (matches UNID_T2)
Alias[UNI_STAR2_ITEM]: %MAP-D3%%RED%xX%ORANGE%xX  %GOLD%%NAME%%ORANGE%  Xx%RED%Xx

// Unique Tier1 Item — 1-doublet RED + GOLD name (matches UNID_T1)
Alias[UNI_STAR1_ITEM]: %DOT-D3%%RED%xX %GOLD%%NAME%%RED% Xx

// Unique Tier0 Item — single LIGHT_GRAY x + GOLD name (matches UNID_T0)
Alias[UNI_STAR0_ITEM]: %DOT-D3%%LIGHT_GRAY%x %GOLD%%NAME%%LIGHT_GRAY% x


// SET GG Item — 3 single x PURPLE-RED-DARK_GREEN + GREEN name (matches UNID_SET_GG)
Alias[SET_GG_ITEM]: %BORDER-7D%%PURPLE%x%RED%x%DARK_GREEN%x   %GREEN%%NAME%%DARK_GREEN%   x%RED%x%PURPLE%x

// SET Tier3 Item — 2 single x RED-DARK_GREEN + GREEN name (matches UNID_SET_T3)
Alias[SET_TIER3_ITEM]: %MAP-7D%%RED%x%DARK_GREEN%x  %GREEN%%NAME%%DARK_GREEN%  x%RED%x

// SET Tier2 Item — 1 single x RED + GREEN name (matches UNID_SET_T2)
Alias[SET_TIER2_ITEM]: %DOT-7D%%RED%x %GREEN%%NAME%%RED% x

// SET Tier1 Item — 1 single x LIGHT_GRAY + GREEN name (matches UNID_SET_T1)
Alias[SET_TIER1_ITEM]: %DOT-7D%%LIGHT_GRAY%x %GREEN%%NAME%%LIGHT_GRAY% x

// RW Bases GG
Alias[RW_BASE_GG]: %BORDER-9B%%DOT-0E%%SOUNDID-4719% %NAME% %PURPLE%

// RW Bases Orange Alt Text
Alias[RW_BASE_ALT_ORANGE]: %NAME% %DOT-0B%%ORANGE%

// RW Bases Orange Text
Alias[RW_BASE_ORANGE]: %NAME% %DOT-0B%%ORANGE%@ @ @

// RW Bases Green Text
Alias[RW_BASE_GREEN]: %NAME% %DOT-76%%DARK_GREEN%

// RW Bases Lower Green Text
Alias[RW_BASE_LOW_GREEN]: %NAME% %DOT-7D%%GREEN%@@@

// Craft 2 Item Base — matches upstream Kassahi °° style (graduated)
Alias[CRAFT_TWO]: %ORANGE%°°° %NAME% °°°

// Craft 1 Item Base — matches upstream Kassahi °° style (graduated)
Alias[CRAFT_ONE]: %ORANGE%°° %NAME% °°

// Craft Item Base — matches upstream Kassahi `%ORANGE%°%NAME%` exactly
Alias[CRAFT_ZERO]: %ORANGE%°%NAME%

// LLD Craft Item Base
Alias[CRAFT_LLD]: %NAME% %GREEN%[LLD Craft]



//-----------------------------------------------------------------------------------
// General Item re-names
//-----------------------------------------------------------------------------------

ItemDisplay[RUNE>0]: %RUNENAME%%CONTINUE%
ItemDisplay[RUNE>0]: %ORANGE%%NAME%%CONTINUE%
// Runes 1-20: keep the rune-name annotation tooltip at higher filter levels
// (Hiim suppresses these above FILTLVL 7; Kassahi keeps them visible).
ItemDisplay[RUNE>0 RUNE<21]: %NAME%{%NAME%}%CONTINUE%

Alias[WSS_SHARD]: %PURPLE%•%RED%•%CORAL%•   %CORAL% %NAME% %CORAL%   •%RED%•%PURPLE%•


// === Set 1: item-specific GG_* / MAIN_DOT / PD2_MATS / rvl rename ===

// imrn
Alias[GG_IMRN]: %PX-60%%DOT-21%%MAP-0A%%SOUNDID-4714%%GREEN%@@%BLACK%@ %PURPLE%@%BLACK%@  %RED%%NAME%%BLACK%  @%PURPLE%@ %BLACK%@%GREEN%@@
// lbox
Alias[GG_LBOX]: %DOT-60%%MAP-21%%BORDER-0A%%SOUNDID-4719%%GREEN%@@%BLACK%@ %PURPLE%@@%BLACK%@   %WHITE%• %RED%%NAME%%WHITE% •   %BLACK%@%PURPLE%@@ %BLACK%@%GREEN%@@
// lsvl llmr
Alias[GG_GG]: %DOT-60%%MAP-21%%BORDER-0A%%SOUNDID-4719%%GREEN%OO%BLACK%O %PURPLE%OO%BLACK%O %GREEN%OO%BLACK%O %PURPLE%OO%BLACK%O   %WHITE%• %RED%%NAME%%WHITE% •   %BLACK%O%PURPLE%OO %BLACK%O%GREEN%OO %BLACK%O%PURPLE%OO %BLACK%O%GREEN%OO
// rkey
Alias[GG_RKEY]: %SOUNDID-4719%%DOT-60%%MAP-21%%BORDER-0A%%GREEN%OO%BLACK%O %PURPLE%OO%BLACK%O   %WHITE%• %RED%%NAME%%WHITE% •   %BLACK%O%PURPLE%OO %BLACK%O%GREEN%OO
// rtp
Alias[GG_RTP]: %SOUNDID-4719%%DOT-60%%MAP-21%%BORDER-0A%%GREEN%OO%BLACK%O %PURPLE%OO%BLACK%O   %WHITE%• %RED%%NAME%%WHITE% •   %BLACK%O%PURPLE%OO %BLACK%O%GREEN%OO
// rid
Alias[GG_RID]: %SOUNDID-4719%%DOT-60%%MAP-21%%BORDER-0A%%PURPLE%OO%BLACK%O %GREEN%OO%BLACK%O %PURPLE%OO%BLACK%O   %WHITE%• %RED%%NAME%%WHITE% •   %BLACK%O%PURPLE%OO %BLACK%O%GREEN%OO %BLACK%O%PURPLE%OO
// PD2 Shards

Alias[MAIN_DOT]: •
Alias[PD2_MATS]: %PURPLE%«%BLACK%·%RED%» %NAME% %RED%«%BLACK%·%PURPLE%»

// Rejuves
ItemDisplay[rvl]: %PURPLE%° %WHITE%Juice %PURPLE%°%CONTINUE%


// === Merged from 03-alias-kassahi-unid-hyper ===
// (UNID-tier display aliases for unidentified uniques/sets)




//------------------------------UNID_ITEM_ALIAS_HYPER------------------------------




// UNIQUES
// CHARMS
Alias[UNICHARM]: %PURPLE%•%ORANGE%•  %GOLD%%NAME%%ORANGE%  •%PURPLE%•
// GG
Alias[UNID_GG]: %PURPLE%xX%RED%xX%ORANGE%xX%YELLOW%xX   %WHITE%• %PURPLE%%NAME%%WHITE% •   %YELLOW%Xx%ORANGE%Xx%RED%Xx%PURPLE%Xx
// TIER 3
Alias[UNID_T3]: %PURPLE%xX%RED%xX%ORANGE%xX  %GOLD%%NAME%%ORANGE%  Xx%RED%Xx%PURPLE%Xx
// TIER 2
Alias[UNID_T2]: %RED%xX%ORANGE%xX  %GOLD%%NAME%%ORANGE%  Xx%RED%Xx
// TIER 1
Alias[UNID_T1]: %RED%xX %GOLD%%NAME%%RED% Xx
// TIER 0
Alias[UNID_T0]: %LIGHT_GRAY%x %GOLD%%NAME%%LIGHT_GRAY% x

// SETS
// GG
Alias[UNID_SET_GG]: %PURPLE%x%RED%x%DARK_GREEN%x   %GREEN%%NAME%%DARK_GREEN%   x%RED%x%PURPLE%x
// TIER 3
Alias[UNID_SET_T3]: %RED%x%DARK_GREEN%x  %GREEN%%NAME%%DARK_GREEN%  x%RED%x
// TIER 2
Alias[UNID_SET_T2]: %RED%x %GREEN%%NAME%%RED% x
// TIER 1
Alias[UNID_SET_T1]: %LIGHT_GRAY%x %GREEN%%NAME%%LIGHT_GRAY% x
