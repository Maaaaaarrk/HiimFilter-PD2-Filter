//-----------------------------------------------------------------------------------
// SOCKET CAP GROUPS
//-----------------------------------------------------------------------------------
// Item-code groups by max sockets. Shared by the Hiim socket tooltip (09-footer/30-Tags_Sockets)
// and the Kassahi copies (25-Kassahi_Item_Descriptions-3 / -5), so a socket-cap change is one edit here.
// Each tooltip keeps its own wording and values; only the base lists are shared.

// Quivers: 1 socket
Alias[SOCK_QUIVER_1]: (aqv OR cqv)
// Quivers: 2 sockets
Alias[SOCK_QUIVER_2]: (aqv2 OR aqv3 OR cqv2 OR cqv3)
// Helms / circlets: 2 sockets
Alias[SOCK_HELM_2]: (cap OR xap OR uap OR skp OR xkp OR ukp OR hlm OR xlm OR fhl OR xhl OR bhm OR xh9 OR ci1)
// Helms: 2 sockets, 3 at ilvl 41+
Alias[SOCK_HELM_2_3]: (msk OR ghm OR crn)
// Helms / circlets: 3 sockets
Alias[SOCK_HELM_3]: (xsk OR xhm OR xrn OR usk OR uh9 OR uhm OR urn OR ci2 OR ci3 OR ulm OR uhl)
// Body armor: 2 sockets
Alias[SOCK_CHEST_2]: (qui OR lea OR hla OR stu OR scl OR chn)
// Shields: 1 socket
Alias[SOCK_SHIELD_1]: (buc OR xuc)
// Shields: 2 sockets
Alias[SOCK_SHIELD_2]: (uuc OR sml OR xml OR uml OR bsh)
// Shields: 3 sockets
Alias[SOCK_SHIELD_3]: (lrg OR xrg OR urg OR upk OR kit OR xit OR ush OR tow OR xow OR gts OR xts OR xsh OR spk OR xpk)
// Monarch / Aegis / Ward (Hiim says 3, Kassahi -5 says 4)
Alias[SOCK_SHIELD_ELITE_TOP]: (uit OR uow OR uts)
// Weapons: always 1 socket
Alias[SOCK_WEAP_1]: (dgr OR dir OR wnd OR ywn OR 9wn OR tkf OR tax OR jav)
// Weapons: 6 sockets (4 if 1H)
Alias[SOCK_WEAP_6]: (9mp OR 9wa OR 7mp OR 7wa OR 9ga OR 9gi OR 7ga OR 7gi OR 9m9 OR 9gm OR 7m7 OR 7gm OR 7cr OR 9gd OR 7gd OR 9st OR 9p9 OR 7st OR 7p7 OR 9h9 OR 9wc OR 7h7 OR 7wc OR 8l8 OR 8lw OR 6l7 OR 6lw OR 8hx OR 6hx OR 8ws OR 6ws OR am8 OR am9 OR amd OR ame OR 7sr)
// Weapons: 2 sockets, 3 at ilvl 26+
Alias[SOCK_WEAP_2_3]: (kri OR clw OR btl OR skr OR ob5)
// Weapons: 3 sockets, 4 at ilvl 26+
Alias[SOCK_WEAP_3_4]: (whm OR bsd OR lsd OR clm OR gis OR bsw OR tri OR vou OR hbw OR cbw OR mxb)
// Weapons: 4 sockets, 5 at ilvl 26+ (2H)
Alias[SOCK_WEAP_4_5]: (2ax OR bax OR btx)
// Weapons: 4 / 5 / 6 by ilvl (2H)
Alias[SOCK_WEAP_4_6]: (mpi OR wax OR gax OR gix)
