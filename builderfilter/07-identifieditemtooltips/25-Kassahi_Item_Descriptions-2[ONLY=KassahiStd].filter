//Exactly Requirements after upgrade
// UPSTR/UPDEX/UPLVL are the post-upgrade requirements with the item's -req already applied.
// Grey = your character meets it, red = too low str/dex/lvl.
//Strength
ItemDisplay[(RARE OR CRAFT OR UNI OR SET) (NORM OR EXC) ID $f(UPSTR>0) !$f(UPSTR>CHARSTAT0-STAT0)]: %NAME%{%NAME% %DARK_GREEN%s:%LIGHT_GRAY%%UPSTR%}%CONTINUE%
ItemDisplay[(RARE OR CRAFT OR UNI OR SET) (NORM OR EXC) ID $f(UPSTR>0) $f(UPSTR>CHARSTAT0-STAT0)]: %NAME%{%NAME% %DARK_GREEN%s:%RED%%UPSTR%}%CONTINUE%
//Dexterity
ItemDisplay[(RARE OR CRAFT OR UNI OR SET) (NORM OR EXC) ID $f(UPDEX>0) $f(UPSTR>0)]: %NAME%{%NAME%,}%CONTINUE%
ItemDisplay[(RARE OR CRAFT OR UNI OR SET) (NORM OR EXC) ID $f(UPDEX>0) !$f(UPDEX>CHARSTAT2-STAT2)]: %NAME%{%NAME% %DARK_GREEN%d:%LIGHT_GRAY%%UPDEX%}%CONTINUE%
ItemDisplay[(RARE OR CRAFT OR UNI OR SET) (NORM OR EXC) ID $f(UPDEX>0) $f(UPDEX>CHARSTAT2-STAT2)]: %NAME%{%NAME% %DARK_GREEN%d:%RED%%UPDEX%}%CONTINUE%
//LVL
ItemDisplay[(RARE OR CRAFT OR UNI OR SET) (NORM OR EXC) ID $f(UPLVL>0) $f(OR(UPSTR>0,UPDEX>0))]: %NAME%{%NAME%,}%CONTINUE%
ItemDisplay[(RARE OR CRAFT OR UNI OR SET) (NORM OR EXC) ID $f(UPLVL>0) !$f(UPLVL>CLVL)]: %NAME%{%NAME% %DARK_GREEN%l:%LIGHT_GRAY%%UPLVL%}%CONTINUE%
ItemDisplay[(RARE OR CRAFT OR UNI OR SET) (NORM OR EXC) ID $f(UPLVL>0) $f(UPLVL>CLVL)]: %NAME%{%NAME% %DARK_GREEN%l:%RED%%UPLVL%}%CONTINUE%

