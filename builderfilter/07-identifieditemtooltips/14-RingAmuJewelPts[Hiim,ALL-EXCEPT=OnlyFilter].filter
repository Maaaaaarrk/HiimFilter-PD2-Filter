
// ------------------------------------------------------------------------------
// Tool-tip Pts AMU / RING / JEWEL — raw weighted score as "NNN%" (centipoints)
// ------------------------------------------------------------------------------
// Color: ORANGE normally, PURPLE at 6Pt+ (rings/amulets) or 4Pt+ (jewels).
// Divisors live in 06-hiim_pts_formula: PTS_RING_DIV / PTS_AMU_DIV / PTS_MELEEJEW_DIV / PTS_CASTERJEW_DIV / PTS_LLDJEW_DIV
// ------------------------------------------------------------------------------

// PVM Melee Ring
ItemDisplay[rin !UNI !SET ID MINDMG+MAXDMG>9 $f(ROUND(PTSRING_MELEE*100/PTS_RING_DIV/100))~3-5]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSRING_MELEE%*100/%PTS_RING_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSRING_MELEE%*100/%PTS_RING_DIV%)/100) pt PVM Melee Ring%CL%%NAME%}
ItemDisplay[rin !UNI !SET ID MINDMG+MAXDMG>9 $f(ROUND(PTSRING_MELEE*100/PTS_RING_DIV/100))>5]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSRING_MELEE%*100/%PTS_RING_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSRING_MELEE%*100/%PTS_RING_DIV%)/100) pt PVM Melee Ring%CL%%NAME%}

// PVM Caster Ring (STAT86 and STAT138 weights live in the alias — each value of 2 = 1Pt)
ItemDisplay[rin !UNI !SET ID FCR>0 $f(ROUND(PTSRING_CASTER*100/PTS_RING_DIV/100))~3-5]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) pt PVM Caster Ring%CL%%NAME%}
ItemDisplay[rin !UNI !SET ID FCR>0 $f(ROUND(PTSRING_CASTER*100/PTS_RING_DIV/100))>5]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) pt PVM Caster Ring%CL%%NAME%}

// LLD Melee Ring
ItemDisplay[rin !UNI !SET ID LVLREQ<31 STR>14 $f(ROUND(PTSRING_LLDMELEE*100/PTS_RING_DIV/100))~4-5]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSRING_LLDMELEE%*100/%PTS_RING_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSRING_LLDMELEE%*100/%PTS_RING_DIV%)/100) pt LLD Melee Ring%CL%%NAME%}
ItemDisplay[rin !UNI !SET ID LVLREQ<31 STR>14 $f(ROUND(PTSRING_LLDMELEE*100/PTS_RING_DIV/100))>5]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSRING_LLDMELEE%*100/%PTS_RING_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSRING_LLDMELEE%*100/%PTS_RING_DIV%)/100) pt LLD Melee Ring%CL%%NAME%}

// LLD Caster Ring
ItemDisplay[rin !UNI !SET ID LVLREQ<31 FCR>0 $f(ROUND(PTSRING_LLDCASTER*100/PTS_RING_DIV/100))~4-5]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSRING_LLDCASTER%*100/%PTS_RING_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSRING_LLDCASTER%*100/%PTS_RING_DIV%)/100) pt LLD Caster Ring%CL%%NAME%}
ItemDisplay[rin !UNI !SET ID LVLREQ<31 FCR>0 $f(ROUND(PTSRING_LLDCASTER*100/PTS_RING_DIV/100))>5]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSRING_LLDCASTER%*100/%PTS_RING_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSRING_LLDCASTER%*100/%PTS_RING_DIV%)/100) pt LLD Caster Ring%CL%%NAME%}

// HLD Caster Ring
ItemDisplay[rin !UNI !SET ID STR+DEX>29 FCR>0 $f(ROUND(PTSRING_HLDCASTER*100/PTS_RING_DIV/100))~4-5]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSRING_HLDCASTER%*100/%PTS_RING_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSRING_HLDCASTER%*100/%PTS_RING_DIV%)/100) pt HLD Caster Ring%CL%%NAME%}
ItemDisplay[rin !UNI !SET ID STR+DEX>29 FCR>0 $f(ROUND(PTSRING_HLDCASTER*100/PTS_RING_DIV/100))>5]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSRING_HLDCASTER%*100/%PTS_RING_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSRING_HLDCASTER%*100/%PTS_RING_DIV%)/100) pt HLD Caster Ring%CL%%NAME%}

// LLD Melee Amulet
ItemDisplay[amu !UNI !SET ID LVLREQ<31 LIFE>19 AMU_WITH_ANY_CLASS $f(ROUND(PTSAMU_LLDMELEE*100/PTS_AMU_DIV/100))~3-5]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSAMU_LLDMELEE%*100/%PTS_AMU_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSAMU_LLDMELEE%*100/%PTS_AMU_DIV%)/100) pt LLD Melee Amulet%CL%%NAME%}
ItemDisplay[amu !UNI !SET ID LVLREQ<31 LIFE>19 AMU_WITH_ANY_CLASS $f(ROUND(PTSAMU_LLDMELEE*100/PTS_AMU_DIV/100))>5]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSAMU_LLDMELEE%*100/%PTS_AMU_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSAMU_LLDMELEE%*100/%PTS_AMU_DIV%)/100) pt LLD Melee Amulet%CL%%NAME%}

// LLD Caster Amulet
ItemDisplay[amu !UNI !SET ID LVLREQ<31 FCR>0 AMU_TREE_ONLY $f(ROUND(PTSAMU_LLDCASTER*100/PTS_AMU_DIV/100))~3-5]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSAMU_LLDCASTER%*100/%PTS_AMU_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSAMU_LLDCASTER%*100/%PTS_AMU_DIV%)/100) pt LLD Caster Amulet%CL%%NAME%}
ItemDisplay[amu !UNI !SET ID LVLREQ<31 FCR>0 AMU_TREE_ONLY $f(ROUND(PTSAMU_LLDCASTER*100/PTS_AMU_DIV/100))>5]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSAMU_LLDCASTER%*100/%PTS_AMU_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSAMU_LLDCASTER%*100/%PTS_AMU_DIV%)/100) pt LLD Caster Amulet%CL%%NAME%}

// PVM Amulet (STAT86 and STAT80 weights live in the alias — STAT86 of 2 = 1Pt, STAT80 of 16 = 1Pt)
ItemDisplay[amu !UNI !SET ID AMU_WITH_2CLASS $f(ROUND(PTSAMU_PVM*100/PTS_AMU_DIV/100))~3-5]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSAMU_PVM%*100/%PTS_AMU_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSAMU_PVM%*100/%PTS_AMU_DIV%)/100) pt PVM Amulet%CL%%NAME%}
ItemDisplay[amu !UNI !SET ID AMU_WITH_2CLASS $f(ROUND(PTSAMU_PVM*100/PTS_AMU_DIV/100))>5]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSAMU_PVM%*100/%PTS_AMU_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSAMU_PVM%*100/%PTS_AMU_DIV%)/100) pt PVM Amulet%CL%%NAME%}

// HLD Caster Amulet
ItemDisplay[amu !UNI !SET ID STR+DEX>29 AMU_WITH_2CLASS $f(ROUND(PTSAMU_HLDCASTER*100/PTS_AMU_DIV/100))~4-5]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSAMU_HLDCASTER%*100/%PTS_AMU_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSAMU_HLDCASTER%*100/%PTS_AMU_DIV%)/100) pt HLD Caster Amulet%CL%%NAME%}
ItemDisplay[amu !UNI !SET ID STR+DEX>29 AMU_WITH_2CLASS $f(ROUND(PTSAMU_HLDCASTER*100/PTS_AMU_DIV/100))>5]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSAMU_HLDCASTER%*100/%PTS_AMU_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSAMU_HLDCASTER%*100/%PTS_AMU_DIV%)/100) pt HLD Caster Amulet%CL%%NAME%}

// ------------------------------------------------------------------------------

// LLD Item tags Jewelry
ItemDisplay[(amu OR rin) !UNI !SET ID LVLREQ<31]: %NAME% LLD{%NAME%}%CONTINUE%

// ------------------------------------------------------------------------------
// Jewel Pts — purple at old 4Pt threshold
// ------------------------------------------------------------------------------

// Melee Jewel (STAT91 -req weight lives in the alias — value of -15 = 1Pt)
ItemDisplay[jew !UNI !SET ID $f(ROUND(PTSJEW_MELEE*100/PTS_MELEEJEW_DIV/100))=3]: %CONTINUE% %NAME% %ORANGE%$f(ROUND(%PTSJEW_MELEE%*100/%PTS_MELEEJEW_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSJEW_MELEE%*100/%PTS_MELEEJEW_DIV%)/100) pt Melee Jewel%CL%%NAME%}
ItemDisplay[jew !UNI !SET ID $f(ROUND(PTSJEW_MELEE*100/PTS_MELEEJEW_DIV/100))>3]: %CONTINUE% %NAME% %PURPLE%$f(ROUND(%PTSJEW_MELEE%*100/%PTS_MELEEJEW_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSJEW_MELEE%*100/%PTS_MELEEJEW_DIV%)/100) pt Melee Jewel%CL%%NAME%}

// Caster Jewel
ItemDisplay[jew !UNI !SET ID $f(ROUND(PTSJEW_CASTER*100/PTS_CASTERJEW_DIV/100))=3]: %CONTINUE% %NAME% %ORANGE%$f(ROUND(%PTSJEW_CASTER%*100/%PTS_CASTERJEW_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSJEW_CASTER%*100/%PTS_CASTERJEW_DIV%)/100) pt Caster Jewel%CL%%NAME%}
ItemDisplay[jew !UNI !SET ID $f(ROUND(PTSJEW_CASTER*100/PTS_CASTERJEW_DIV/100))>3]: %CONTINUE% %NAME% %PURPLE%$f(ROUND(%PTSJEW_CASTER%*100/%PTS_CASTERJEW_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSJEW_CASTER%*100/%PTS_CASTERJEW_DIV%)/100) pt Caster Jewel%CL%%NAME%}

// LLD Jewel
ItemDisplay[jew !UNI !SET ID LVLREQ<31 $f(ROUND(PTSJEW_LLD*100/PTS_LLDJEW_DIV/100))=3]: %CONTINUE% %NAME% %ORANGE%$f(ROUND(%PTSJEW_LLD%*100/%PTS_LLDJEW_DIV%)/100)pt{%ORANGE%$f(ROUND(%PTSJEW_LLD%*100/%PTS_LLDJEW_DIV%)/100) pt LLD Jewel%CL%%NAME%}
ItemDisplay[jew !UNI !SET ID LVLREQ<31 $f(ROUND(PTSJEW_LLD*100/PTS_LLDJEW_DIV/100))>3]: %CONTINUE% %NAME% %PURPLE%$f(ROUND(%PTSJEW_LLD%*100/%PTS_LLDJEW_DIV%)/100)pt{%PURPLE%$f(ROUND(%PTSJEW_LLD%*100/%PTS_LLDJEW_DIV%)/100) pt LLD Jewel%CL%%NAME%}

