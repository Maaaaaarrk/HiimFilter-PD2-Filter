// Half Freeze Duration / Cannot Be Frozen Notes
// Unequipped
ItemDisplay[STAT118=1 !EQUIPPED]: %NAME%{%NAME%%CL%%WHITE%2x %TEAL%hfd %WHITE%= %TEAL%cbf}%CONTINUE%
// Equipped w/o other CBF source
ItemDisplay[(CHARSTAT118=1 CHARSTAT153=0) STAT118=1 EQUIPPED]: %NAME%{%NAME%%CL%%DARK_GREEN%%CHARSTAT118%/2 %TEAL%hfd %WHITE%items for %TEAL%cbf}%CONTINUE%
ItemDisplay[(CHARSTAT118=2 CHARSTAT153=0) STAT118=1 EQUIPPED]: %NAME%{%NAME%%CL%%GREEN%%CHARSTAT118%/2 %TEAL%hfd %WHITE%items for %TEAL%cbf}%CONTINUE%
ItemDisplay[(CHARSTAT118>2 CHARSTAT153=0) STAT118=1 EQUIPPED]: %NAME%{%NAME%%CL%%RED%%CHARSTAT118%/2 %TEAL%hfd %WHITE%items for %TEAL%cbf}%CONTINUE%
// Unequipped with other CBF source
ItemDisplay[!EQUIPPED (CHARSTAT118>1 OR CHARSTAT153>0) (STAT118>0 OR STAT153>0)]: %NAME%{%NAME%%CL%%RED%already has %TEAL%cbf}%CONTINUE%
// Safe-to-remove CBF/HFD Item
ItemDisplay[EQUIPPED (((CHARSTAT153>1 OR CHARSTAT118>1) STAT153>0) OR ((CHARSTAT153>0 OR CHARSTAT118>2) STAT118>0))]: %NAME%{%NAME%%CL%%TEAL%cbf %RED%kept if removed}%CONTINUE%

