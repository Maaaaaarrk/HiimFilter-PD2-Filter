//-----------------------------------------------------------------------------------
// ITEM TAGS
//-----------------------------------------------------------------------------------
// ITEM TAGS - ETH
ItemDisplay[ETH UNI ID !(REPAIR>0)]: %GRAY%eth %GOLD%%NAME%%CONTINUE%{%NAME%}
ItemDisplay[ETH SET ID !(REPAIR>0)]: %GRAY%eth %GREEN%%NAME%%CONTINUE%{%NAME%}

// ETH Rep
ItemDisplay[ETH UNI ID (REPAIR>0)]: %GRAY%eth-rep %GOLD%%NAME%%CONTINUE%{%NAME%}
ItemDisplay[ETH SET ID (REPAIR>0)]: %GRAY%eth-rep %GREEN%%NAME%%CONTINUE%{%NAME%}

// Vial candidate
ItemDisplay[!ETH !UNI (REPAIR>0)]: %NAME% %GRAY%rep%CONTINUE%{%NAME%}

// ITEM TAGS- SOCKETS
ItemDisplay[(ARMOR OR WEAPON) NMAG SOCK=0]: %WHITE%%NAME%%CONTINUE%{%NAME%}
ItemDisplay[(ARMOR OR WEAPON) NMAG SOCK>0]: %GRAY%%NAME%%CONTINUE%{%NAME%}
ItemDisplay[SOCK>0 !RW]: %NAME% %GRAY%[%SOCKETS%]%CONTINUE%{%NAME%}

// ITEM TAGS - Corrupted. STAT360 is the corruption outcome ID from CubeMain.txt; 0 = not corrupted,
// 1 = corrupted with no stat added (charms, Annihilus, map tier changes), 11 is unused. corruptor is STAT361.
ItemDisplay[STAT360>0]: %NAME%%RED%%CONTINUE%{%NAME%}
ItemDisplay[STAT360=48 ETH]: %NAME% Indes%CONTINUE%{%NAME%} // 48 repair durability + % enhanced defense, on ETH
ItemDisplay[STAT360=48 !ETH]: %NAME% Rep EDef%CONTINUE%{%NAME%} // 48 repair durability + % enhanced defense
ItemDisplay[STAT360=2]: %NAME% ED%CONTINUE%{%NAME%} // +% enhanced damage
ItemDisplay[STAT360=3]: %NAME% AR%CONTINUE%{%NAME%} // + attack rating
ItemDisplay[STAT360=4]: %NAME% LAH%CONTINUE%{%NAME%} // life after each hit
ItemDisplay[STAT360=5]: %NAME% Demon%CONTINUE%{%NAME%} // +AR / +% damage vs demons
ItemDisplay[STAT360=6]: %NAME% -Req%CONTINUE%{%NAME%} // -% requirements
ItemDisplay[STAT360=7]: %NAME% MF%CONTINUE%{%NAME%} // +% magic find
ItemDisplay[STAT360=8]: %NAME% LAEK%CONTINUE%{%NAME%} // life after each kill
ItemDisplay[STAT360=9]: %NAME% MAEK%CONTINUE%{%NAME%} // mana after each kill
ItemDisplay[STAT360=10]: %NAME% Mana%CONTINUE%{%NAME%} // + mana
ItemDisplay[STAT360=12]: %NAME% -FireRes%CONTINUE%{%NAME%} // -% enemy fire resistance
ItemDisplay[STAT360=13]: %NAME% -LightRes%CONTINUE%{%NAME%} // -% enemy lightning resistance
ItemDisplay[STAT360=14]: %NAME% -ColdRes%CONTINUE%{%NAME%} // -% enemy cold resistance
ItemDisplay[STAT360=15]: %NAME% -PsnRes%CONTINUE%{%NAME%} // -% enemy poison resistance
ItemDisplay[STAT360=16]: %NAME% FCR%CONTINUE%{%NAME%} // faster cast rate
ItemDisplay[STAT360=17]: %NAME% LL ED%CONTINUE%{%NAME%} // life leech + % enhanced damage
ItemDisplay[STAT360=18]: %NAME% AR%CONTINUE%{%NAME%} // + attack rating (throwing weapons)
ItemDisplay[STAT360=19]: %NAME% DS%CONTINUE%{%NAME%} // deadly strike
ItemDisplay[STAT360=20]: %NAME% IAS%CONTINUE%{%NAME%} // increased attack speed
ItemDisplay[STAT360=21]: %NAME% CB%CONTINUE%{%NAME%} // crushing blow
ItemDisplay[STAT360=22]: %NAME% IAS ED%CONTINUE%{%NAME%} // IAS + % enhanced damage
ItemDisplay[STAT360=23]: %NAME% IAS CB%CONTINUE%{%NAME%} // IAS + crushing blow
ItemDisplay[STAT360=24]: %NAME% ITD ED%CONTINUE%{%NAME%} // ignore target defense + % enhanced damage
ItemDisplay[STAT360=25]: %NAME% ED-DS%CONTINUE%{%NAME%} // deadly strike + % enhanced damage
ItemDisplay[STAT360=26]: %NAME% AR ED%CONTINUE%{%NAME%} // + attack rating + % enhanced damage
ItemDisplay[STAT360=27]: %NAME% +Sk%CONTINUE%{%NAME%} // +1 all skills (weapon / Anni)
ItemDisplay[STAT360=28]: %NAME% FCR Fire%CONTINUE%{%NAME%} // +5% fire skill damage + FCR
ItemDisplay[STAT360=29]: %NAME% FCR Cold%CONTINUE%{%NAME%} // +5% cold skill damage + FCR
ItemDisplay[STAT360=30]: %NAME% FCR Light%CONTINUE%{%NAME%} // +5% lightning skill damage + FCR
ItemDisplay[STAT360=31]: %NAME% FCR Poison%CONTINUE%{%NAME%} // +5% poison skill damage + FCR
ItemDisplay[STAT360=32]: %NAME% Sockets%CONTINUE%{%NAME%} // added sockets
ItemDisplay[STAT360=33]: %NAME% EDef%CONTINUE%{%NAME%} // +% enhanced defense
ItemDisplay[STAT360=34]: %NAME% RepLife%CONTINUE%{%NAME%} // replenish life
ItemDisplay[STAT360=35]: %NAME% FHR%CONTINUE%{%NAME%} // faster hit recovery
ItemDisplay[STAT360=36]: %NAME% FireRes%CONTINUE%{%NAME%} // + fire resistance
ItemDisplay[STAT360=37]: %NAME% ColdRes%CONTINUE%{%NAME%} // + cold resistance
ItemDisplay[STAT360=38]: %NAME% LightRes%CONTINUE%{%NAME%} // + lightning resistance
ItemDisplay[STAT360=39]: %NAME% PsnRes%CONTINUE%{%NAME%} // + poison resistance
ItemDisplay[STAT360=40]: %NAME% ManaRegen%CONTINUE%{%NAME%} // +% mana regeneration
ItemDisplay[STAT360=41]: %NAME% Thorns%CONTINUE%{%NAME%} // attacker takes damage (per level)
ItemDisplay[STAT360=42]: %NAME% FCR%CONTINUE%{%NAME%} // faster cast rate
ItemDisplay[STAT360=43]: %NAME% Life%%CONTINUE%{%NAME%} // +% max life
ItemDisplay[STAT360=44]: %NAME% FRW%CONTINUE%{%NAME%} // faster run/walk
ItemDisplay[STAT360=45]: %NAME% CBF%CONTINUE%{%NAME%} // cannot be frozen
ItemDisplay[STAT360=46]: %NAME% DR%CONTINUE%{%NAME%} // flat damage reduced
ItemDisplay[STAT360=47]: %NAME% MDR%CONTINUE%{%NAME%} // flat magic damage reduced
ItemDisplay[STAT360=49]: %NAME% Curse%CONTINUE%{%NAME%} // curse resistance / effectiveness
ItemDisplay[STAT360=50]: %NAME% +Sk%CONTINUE%{%NAME%} // +1 all skills
ItemDisplay[STAT360=51]: %NAME% AllRes%CONTINUE%{%NAME%} // + all resistances
ItemDisplay[STAT360=52]: %NAME% PDR%CONTINUE%{%NAME%} // % physical damage reduced
ItemDisplay[STAT360=53]: %NAME% MaxFire%CONTINUE%{%NAME%} // + max fire resistance
ItemDisplay[STAT360=54]: %NAME% MaxCold%CONTINUE%{%NAME%} // + max cold resistance
ItemDisplay[STAT360=55]: %NAME% MaxLight%CONTINUE%{%NAME%} // + max lightning resistance
ItemDisplay[STAT360=56]: %NAME% MaxPsn%CONTINUE%{%NAME%} // + max poison resistance
ItemDisplay[STAT360=57]: %NAME% LL%CONTINUE%{%NAME%} // life leech
ItemDisplay[STAT360=58]: %NAME% ML%CONTINUE%{%NAME%} // mana leech
ItemDisplay[STAT360=59]: %NAME% AR LR%CONTINUE%{%NAME%} // + attack rating + light radius
ItemDisplay[STAT360=60]: %NAME% GF%CONTINUE%{%NAME%} // +% gold find
ItemDisplay[STAT360=61]: %NAME% Life%CONTINUE%{%NAME%} // + life
ItemDisplay[STAT360=62]: %NAME% CurseEff%CONTINUE%{%NAME%} // curse effectiveness
ItemDisplay[STAT360=63]: %NAME% Pierce%CONTINUE%{%NAME%} // % chance to pierce
ItemDisplay[STAT360=64]: %NAME% FBR%CONTINUE%{%NAME%} // faster block rate
ItemDisplay[STAT360=65]: %NAME% AllStats%CONTINUE%{%NAME%} // + all attributes
ItemDisplay[STAT360=66]: %NAME% -Def%CONTINUE%{%NAME%} // -% target defense
ItemDisplay[STAT360=67]: %NAME% Block%CONTINUE%{%NAME%} // +% chance to block
ItemDisplay[STAT360=68]: %NAME% Str%CONTINUE%{%NAME%} // + strength
ItemDisplay[STAT360=69]: %NAME% Dex%CONTINUE%{%NAME%} // + dexterity
ItemDisplay[STAT360=70]: %NAME% Vit%CONTINUE%{%NAME%} // + vitality
ItemDisplay[STAT360=71]: %NAME% Ene%CONTINUE%{%NAME%} // + energy
ItemDisplay[STAT360=72]: %NAME% MaxAllRes%CONTINUE%{%NAME%} // + max all resistances
ItemDisplay[STAT360=73]: %NAME% Block FBR%CONTINUE%{%NAME%} // +% block + faster block rate
ItemDisplay[STAT360=74]: %NAME% MinDmg%CONTINUE%{%NAME%} // + minimum damage
ItemDisplay[STAT360=75]: %NAME% MaxDmg%CONTINUE%{%NAME%} // + maximum damage
ItemDisplay[STAT360=76]: %NAME% ITD%CONTINUE%{%NAME%} // ignore target defense
ItemDisplay[STAT360=77]: %NAME% Undead%CONTINUE%{%NAME%} // +AR / +% damage vs undead
// ItemDisplay[STAT360=78]: %NAME% Map DS%CONTINUE%{%NAME%} // map: monster deadly strike, density, XP
// ItemDisplay[STAT360=79]: %NAME% Map CBF%CONTINUE%{%NAME%} // map: monsters cannot be frozen + life, density, XP
// ItemDisplay[STAT360=80]: %NAME% Map -Speed%CONTINUE%{%NAME%} // map: player -IAS/FCR, density, rarity
// ItemDisplay[STAT360=81]: %NAME% Map -PDR%CONTINUE%{%NAME%} // map: player -damage reduction, density, rarity
