
//-----------------------------------------------------------------------------------
// LLD-only: clvl targets for crafted ilvl 51/71 and alvl 40/45 on any craft base
// Game rounds after each /2 and stores as ints:
//   crafted_ilvl = ROUND(CLVL/2) + ROUND(ILVL/2)  ->  clvl = 2*(target - ROUND(ILVL/2))
//   crafted_alvl = MAX(CI - ROUND(QLVL/2), CI*2 - 99) where CI = crafted_ilvl
//     -> min CI  = MIN(target_alvl + ROUND(QLVL/2), CEIL((target_alvl + 99)/2))
//        precomputed: CEIL(139/2)=70 for alvl 40, CEIL(144/2)=72 for alvl 45
//-----------------------------------------------------------------------------------
ItemDisplay[(MAG OR RARE) ID ILVL>0 STAT486=0 STAT360=0 !SHOP !EQUIPPED !MERC (NORM OR EXC) (ARMOR OR WEAPON) !SHIELD !CHEST !STAFF !WAND !SOR !(ba9 OR baa OR dr9 OR dra OR am7 OR am8 OR am9 OR 9lw OR 9tw OR 9qr)]: %NAME%{%GRAY%Craft at CLVL $f(2*(MIN(40+ROUND(QLVL/2),70)-ROUND(ILVL/2))) for ALVL 40%CL%Craft at CLVL $f(2*(71-ROUND(ILVL/2))) for ILVL 71 (ALVL $f(MAX(71-ROUND(QLVL/2),43)))%CL%Craft at CLVL $f(2*(51-ROUND(ILVL/2))) for ILVL 51 (ALVL $f(MAX(51-ROUND(QLVL/2),3)))%CL%%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID ILVL>0 STAT486=0 STAT360=0 !SHOP !EQUIPPED !MERC (NORM OR EXC) (SHIELD OR CHEST) !(pa8 OR pa9 OR paa OR ne8 OR ne9 OR nea)]: %NAME%{%GRAY%Craft at CLVL $f(2*(MIN(45+ROUND(QLVL/2),72)-ROUND(ILVL/2))) for ALVL 45%CL%Craft at CLVL $f(2*(71-ROUND(ILVL/2))) for ILVL 71 (ALVL $f(MAX(71-ROUND(QLVL/2),43)))%CL%Craft at CLVL $f(2*(51-ROUND(ILVL/2))) for ILVL 51 (ALVL $f(MAX(51-ROUND(QLVL/2),3)))%CL%%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID ILVL>0 STAT486=0 STAT360=0 !SHOP !EQUIPPED !MERC (NORM OR EXC) (STAFF OR WAND OR SOR) !(ob9 OR oba)]: %NAME%{%GRAY%Craft at CLVL $f(2*(39-ROUND(ILVL/2))) for ALVL 40%CL%Craft at CLVL $f(2*(71-ROUND(ILVL/2))) for ILVL 71 (ALVL 72)%CL%Craft at CLVL $f(2*(51-ROUND(ILVL/2))) for ILVL 51 (ALVL 52)%CL%%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID ILVL>0 STAT486=0 STAT360=0 !SHOP !EQUIPPED !MERC (rin OR amu)]: %NAME%{%GRAY%Craft at CLVL $f(2*(40-ROUND(ILVL/2))) for ALVL 40%CL%Craft at CLVL $f(2*(71-ROUND(ILVL/2))) for ILVL 71 (ALVL 71)%CL%Craft at CLVL $f(2*(51-ROUND(ILVL/2))) for ILVL 51 (ALVL 51)%CL%%NAME%}%CONTINUE%
//-----------------------------------------------------------------------------------
