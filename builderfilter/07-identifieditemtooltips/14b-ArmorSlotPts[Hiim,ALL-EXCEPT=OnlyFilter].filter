
// ------------------------------------------------------------------------------
// Tool-tip Pts for rare / crafted armor slots (helms, circlets, gloves, belts, chests,
// shields and Necromancer heads, boots). Scores and the Pt scale live in 06-score_pts_formula:
// PTSSLOT_<SLOT> / PTS_SLOT_DIV. Color: ORANGE at 3-4Pt, PURPLE at 5Pt+.
// ------------------------------------------------------------------------------

// Helm
ItemDisplay[(BAR OR DRU OR (HELM !CIRC !CLASS)) GROUND (RARE OR CRAFT) ID $f(ROUND(PTSSLOT_HELM*100/PTS_SLOT_DIV/100))~3-4]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSSLOT_HELM%*100/%PTS_SLOT_DIV%)/100)pt{%NAME%}
ItemDisplay[(BAR OR DRU OR (HELM !CIRC !CLASS)) !GROUND (RARE OR CRAFT) ID $f(ROUND(PTSSLOT_HELM*100/PTS_SLOT_DIV/100))~3-4]: %CONTINUE%%NAME%{%ORANGE%$f(ROUND(%PTSSLOT_HELM%*100/%PTS_SLOT_DIV%)/100) pt Helm%CL%%NAME%}
ItemDisplay[(BAR OR DRU OR (HELM !CIRC !CLASS)) GROUND (RARE OR CRAFT) ID $f(ROUND(PTSSLOT_HELM*100/PTS_SLOT_DIV/100))>4]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSSLOT_HELM%*100/%PTS_SLOT_DIV%)/100)pt{%NAME%}
ItemDisplay[(BAR OR DRU OR (HELM !CIRC !CLASS)) !GROUND (RARE OR CRAFT) ID $f(ROUND(PTSSLOT_HELM*100/PTS_SLOT_DIV/100))>4]: %CONTINUE%%NAME%{%PURPLE%$f(ROUND(%PTSSLOT_HELM%*100/%PTS_SLOT_DIV%)/100) pt Helm%CL%%NAME%}

