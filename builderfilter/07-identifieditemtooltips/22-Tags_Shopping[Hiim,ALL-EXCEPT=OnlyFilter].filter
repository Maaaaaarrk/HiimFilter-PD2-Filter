ItemDisplay[!UNI ID (CLSK4>1 AND SK154>2) BAR]: %NAME% %ORANGE%+2/3 Warcry Helm%CONTINUE%{%NAME%}// +2 Barbarian, +3 Warcry Barb helm

// Druid Pelts
ItemDisplay[!UNI ID ((CLSK5>1 OR TABSK42>1) AND SK245>2) DRU]: %NAME% %ORANGE%2/3 Tornado Pelt%CONTINUE%{%NAME%}// +2 Druid/Tornado, +3 Tornado Druid Pelt
ItemDisplay[!UNI ID ((CLSK5>1 OR TABSK42>1) AND SK234>2) DRU]: %NAME% %ORANGE%2/3 Fissure Pelt%CONTINUE%{%NAME%}// +2 Druid/Fissure, +3 Fissure Druid Pelt
ItemDisplay[!UNI ID ((CLSK5>1 OR TABSK42>1) AND SK229>2) DRU]: %NAME% %ORANGE%2/3 Molten Pelt%CONTINUE%{%NAME%}// +2 Druid/Molten Boulder, +3 Molten Boulder Druid Pelt
ItemDisplay[!UNI ID ((CLSK5>1 OR TABSK42>1) AND SK237>2) DRU]: %NAME% %ORANGE%2/3 Dire Wolf Pelt%CONTINUE%{%NAME%}// +2 Druid/Dire Wolf, +3 Dire Wolf Druid Pelt
ItemDisplay[!UNI ID ((CLSK5>1 OR TABSK42>1) AND SK247>2) DRU]: %NAME% %ORANGE%2/3 Grizzly Pelt%CONTINUE%{%NAME%}// +2 Druid/Grizzly, +3 Grizzly Druid Pelt

// Armors
ItemDisplay[MAG ID (SOCK>3 AND LIFE>89) CHEST]: %NAME% %ORANGE%Whale Armor %BLUE%%NAME%%CONTINUE%{%NAME%}// 4 sockets, 90+ Health Armor
ItemDisplay[RARE ID (SOCK>3 AND LIFE>89) CHEST]: %NAME% %ORANGE%Whale Armor %YELLOW%%NAME%%CONTINUE%{%NAME%}// 4 sockets, 90+ Health Armor
ItemDisplay[CRAFT ID (SOCK>3 AND LIFE>89) CHEST]: %NAME% %ORANGE%Whale Armor%CONTINUE%{%NAME%}// 4 sockets, 90+ Health Armor

// Gloves
ItemDisplay[!UNI ID (TABSK0=2 OR TABSK1=2 OR TABSK2=2 OR TABSK50=2) IAS>0 GLOVES]: %NAME% %ORANGE%2/%STAT93%%CONTINUE%{%NAME%}// +2 tab skills, IAS Gloves
ItemDisplay[!UNI ID (TABSK0=3 OR TABSK1=3 OR TABSK2=3 OR TABSK50=3) IAS>0 GLOVES]: %NAME% %ORANGE%3/%STAT93%%CONTINUE%{%NAME%}// +3 tab skills, IAS Gloves

// Shields
ItemDisplay[(MAG OR RARE OR CRAFT) ID (SOCK>3 AND FBR>1) uit]: %NAME%{%NAME%%NL%%PURPLE%JMoD}// JMoD Monarch

// Staves with charges
// Staves have 10%/30%/50% Faster Cast Rate (normal/exceptional/elite) 40%+ automod+ 20 craft, 100+fcr for callout & allsk
ItemDisplay[ID CHSK54>0 STAFF NORM FCR>59 ALLSK>0]: %NAME% %SAGE%[TELE]{%PURPLE%FCR & Teleport Charges Staff}
ItemDisplay[ID CHSK54>0 STAFF EXC FCR>79 ALLSK>0]: %NAME% %SAGE%[TELE]{%PURPLE%FCR & Teleport Charges Staff}
ItemDisplay[ID CHSK54>0 STAFF FCR>99 ALLSK>0]: %NAME% %SAGE%[TELE]{%PURPLE%FCR & Teleport Charges Staff}
ItemDisplay[ID CHSK357>0 STAFF]: %NAME% {%ORANGE%(Blink)} // Blink charges

// Wands with charges
ItemDisplay[ID (CHSK445>0) WAND FILTLVL<3]: %NAME% %SAGE%[LifeTap]{%NAME%}%CONTINUE% // Life tap charges
ItemDisplay[ID (CHSK447>0) WAND FILTLVL<3]: %NAME% %SAGE%[LR]{%NAME%}%CONTINUE% // Lower Resist charges
ItemDisplay[ID (CHSK445>0) WAND]: %NAME%{%ORANGE%Life Tap Charges Wand%CL%%NAME%}%CONTINUE% // Life tap charges
ItemDisplay[ID (CHSK447>0) WAND]: %NAME%{%ORANGE%Lower Res Charges Wand%CL%%NAME%}%CONTINUE% // Lower Resist charges

