// Circlets
ItemDisplay[!UNI RARE ID FCR>0 FRW=0 CIRC (CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1 OR TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK8>1 OR TABSK9>1 OR TABSK10>1 OR TABSK16>1 OR TABSK17>1 OR TABSK18>1 OR TABSK24>1 OR TABSK25>1 OR TABSK26>1 OR TABSK32>1 OR TABSK33>1 OR TABSK34>1 OR TABSK40>1 OR TABSK41>1 OR TABSK42>1 OR TABSK48>1 OR TABSK49>1 OR TABSK50>1)]: %DOT-97%%NAME%{%NAME%%CL%%ORANGE%> > > >    $f(CLSK0+CLSK1+CLSK2+CLSK3+CLSK4+CLSK5+CLSK6+TABSK0+TABSK1+TABSK2+TABSK8+TABSK9+TABSK10+TABSK16+TABSK17+TABSK18+TABSK24+TABSK25+TABSK26+TABSK32+TABSK33+TABSK34+TABSK40+TABSK41+TABSK42+TABSK48+TABSK49+TABSK50+STAT127) / %STAT105% FCR   < < < <}%CONTINUE%// class/tab skills + AllSkills, FCR circlet
ItemDisplay[!UNI RARE ID FCR>0 FRW>0 CIRC (CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1 OR TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK8>1 OR TABSK9>1 OR TABSK10>1 OR TABSK16>1 OR TABSK17>1 OR TABSK18>1 OR TABSK24>1 OR TABSK25>1 OR TABSK26>1 OR TABSK32>1 OR TABSK33>1 OR TABSK34>1 OR TABSK40>1 OR TABSK41>1 OR TABSK42>1 OR TABSK48>1 OR TABSK49>1 OR TABSK50>1)]: %DOT-97%%NAME%{%NAME%%CL%%ORANGE%> > > >    $f(CLSK0+CLSK1+CLSK2+CLSK3+CLSK4+CLSK5+CLSK6+TABSK0+TABSK1+TABSK2+TABSK8+TABSK9+TABSK10+TABSK16+TABSK17+TABSK18+TABSK24+TABSK25+TABSK26+TABSK32+TABSK33+TABSK34+TABSK40+TABSK41+TABSK42+TABSK48+TABSK49+TABSK50+STAT127) / %STAT105% FCR / %STAT96% FRW   < < < <}%CONTINUE%// class/tab skills + AllSkills, FCR & FRW circlet
ItemDisplay[!UNI RARE ID FCR=0 FRW>0 CIRC (CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1 OR TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK8>1 OR TABSK9>1 OR TABSK10>1 OR TABSK16>1 OR TABSK17>1 OR TABSK18>1 OR TABSK24>1 OR TABSK25>1 OR TABSK26>1 OR TABSK32>1 OR TABSK33>1 OR TABSK34>1 OR TABSK40>1 OR TABSK41>1 OR TABSK42>1 OR TABSK48>1 OR TABSK49>1 OR TABSK50>1)]: %DOT-97%%NAME%{%NAME%%CL%%ORANGE%> > > >    $f(CLSK0+CLSK1+CLSK2+CLSK3+CLSK4+CLSK5+CLSK6+TABSK0+TABSK1+TABSK2+TABSK8+TABSK9+TABSK10+TABSK16+TABSK17+TABSK18+TABSK24+TABSK25+TABSK26+TABSK32+TABSK33+TABSK34+TABSK40+TABSK41+TABSK42+TABSK48+TABSK49+TABSK50+STAT127) / %STAT96% FRW   < < < <}%CONTINUE%// class/tab skills + AllSkills, FRW circlet


ItemDisplay[!UNI !RW ID HELM !(SOCK=1) ((STAT141>0 STAT136>0) OR ((STAT141>0 OR STAT136>0) (CLSK0>1 OR CLSK3>1 OR CLSK4>1)))]: %NAME% %BORDER-ED%%PURPLE%!!{%NAME%}%CONTINUE%// DS+CB, or DS/CB with Bar/Ama/Pal class skill >1

// Armor(Chest helm shield etc) extra callout
ItemDisplay[!UNI !RW ID !CIRC ARMOR (IAS>0 OR FCR>0 OR SOCK>3) LIFE>0 (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0)]: %NAME% %BORDER-ED%%PURPLE%!!{%NAME%}%CONTINUE%
ItemDisplay[!UNI !RW ID !CIRC ARMOR (FCR>10 OR SOCK>3) (CLSK1>0 OR CLSK2>0 OR CLSK5>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK17>0 OR TABSK42>0)]: %NAME% %BORDER-ED%%PURPLE%!!{%NAME%}%CONTINUE%// caster classes: Sor/Nec/Dru, Necro Pois&Bone, Druid Elemental, all Sor tabs
ItemDisplay[!UNI !RW ID !CIRC ARMOR (STAT36>0 OR SOCK>3) EDAM>149]: %NAME% %BORDER-ED%%PURPLE%!!{%NAME%}%CONTINUE%// phys armor

// Barbarian helms
ItemDisplay[!UNI ID (CLSK4>1 AND SK149>2) BAR]: %DOT-97%%NAME% %CONTINUE%{%NAME%}// +2 Barbarian, +3 Battle Orders Barb helm
ItemDisplay[!UNI ID (CLSK4>1 AND SK154>2) BAR]: %DOT-97%%NAME% %CONTINUE%{%NAME%}// +2 Barbarian, +3 Warcry Barb helm
ItemDisplay[!UNI ID (CLSK4>1 AND SK154>2) FCR>0 BAR]: %NAME% %BORDER-ED%%PURPLE%!!%CONTINUE%{%NAME%}// +2 Barbarian, +3 Warcry Barb helm

// Druid Pelts
ItemDisplay[!UNI ID (CLSK5>1 OR TABSK42>1) (SK245>2 OR SK234>2 OR SK229>2 OR SK237>2 OR SK247>2) DRU]: %DOT-97%%NAME%%CONTINUE%{%NAME%}// +2 Druid/Elemental, +3 Tornado/Fissure/Molten Boulder/Dire Wolf/Grizzly

// Armors
ItemDisplay[(MAG OR RARE OR CRAFT) ID (SOCK>3 AND LIFE>89) CHEST]: %DOT-97%%NAME%%CONTINUE%{%ORANGE%Whale Armor%CL%%NAME%}// 4 sockets, 90+ Health Armor

// Gloves
ItemDisplay[!UNI ID (TABSK0=2 OR TABSK1=2 OR TABSK2=2 OR TABSK50=2) IAS>0 GLOVES]: %DOT-97%%NAME% %ORANGE%2/%STAT93%%CONTINUE%{%NAME%}// +2 tab skills, IAS Gloves
ItemDisplay[!UNI ID (TABSK0=3 OR TABSK1=3 OR TABSK2=3 OR TABSK50=3) IAS>0 GLOVES]: %DOT-97%%NAME% %ORANGE%3/%STAT93%%CONTINUE%{%NAME%}// +3 tab skills, IAS Gloves

// Shields
ItemDisplay[(MAG OR RARE OR CRAFT) ID SHIELD SOCK>3 (EDAM>149 OR STAT36>19 OR CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME% %BORDER-ED%%PURPLE%!!{%NAME%}%CONTINUE%// 4os shield + EDAM>149/PDR>19/any class or tab skill

