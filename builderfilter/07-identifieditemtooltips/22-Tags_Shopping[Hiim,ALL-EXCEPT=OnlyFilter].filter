// Circlets
ItemDisplay[!UNI RARE ID (CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1) ALLSK=0 FCR>0 CIRC]: %NAME%{%NAME%%CL%%ORANGE%> > > >    2/%STAT105%    < < < <}%CONTINUE%// class skills, FCR circlet
ItemDisplay[!UNI RARE ID (CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1) ALLSK=1 FCR>0 CIRC]: %NAME%{%NAME%%CL%%ORANGE%> > > >    3/%STAT105%    < < < <}%CONTINUE%// class skills, +20 FCR circlet

// Armor(Chest helm shield etc) extra callout
ItemDisplay[!UNI !RW ID !CIRC ARMOR FCR>0 LIFE>0 (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0)]: %NAME% %PURPLE%!!{%PURPLE%>   %TAN%FCR & Skill & Life   %PURPLE%<%CL%%NAME%}%CONTINUE%// class skills & FCR & Life
ItemDisplay[!UNI !RW ID !CIRC ARMOR STAT36>0 (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0)]: %NAME% %PURPLE%!{%PURPLE%>   %TAN%PDR & Skill   %PURPLE%<%CL%%NAME%}%CONTINUE%// class skills & PDR
ItemDisplay[!UNI !RW ID !CIRC ARMOR STAT36>0 EDAM>99]: %NAME% %PURPLE%!!{%PURPLE%>   %TAN%PDR & Enhanced Damage   %PURPLE%<%CL%%NAME%}%CONTINUE%// EDAM & PDR

