//-----------------------------------------------------------------------------------
// Kassahi - restore type color for identified UNI/SET items
//
// Prepends gold to identified unique items and green to identified set items.
// Runs BEFORE the stat-info chain in 25-29 so the type color survives the
// chain — when later rules prepend "stat-info%CL%%NAME%", the running
// %NAME% already starts with %ORANGE%/%GREEN%, keeping the item name in
// its expected colour.
//-----------------------------------------------------------------------------------

ItemDisplay[UNI ID]: %ORANGE%%NAME%%CONTINUE%
ItemDisplay[SET ID]: %GREEN%%NAME%%CONTINUE%
