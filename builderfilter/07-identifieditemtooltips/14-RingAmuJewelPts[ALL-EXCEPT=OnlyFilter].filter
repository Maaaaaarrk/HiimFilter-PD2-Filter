
// ------------------------------------------------------------------------------
// Tool-tip Pts AMU / RING / JEWEL — raw weighted score as "NNN%" (centipoints)
// ------------------------------------------------------------------------------
// Color: ORANGE normally, PURPLE at 6Pt+ (rings/amulets) or 4Pt+ (jewels).
// Divisors live in 06-hiim_pts_formula: PTS_RING_DIV / PTS_AMU_DIV / PTS_MELEEJEW_DIV / PTS_CASTERJEW_DIV / PTS_LLDJEW_DIV
// ------------------------------------------------------------------------------

// PVM Melee Ring
ItemDisplay[rin !UNI !SET ID MINDMG+MAXDMG>9 $f(%PTSRING_MELEE%>383) $f(%PTSRING_MELEE%<768)]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSRING_MELEE%*100/%PTS_RING_DIV%)/100) Pt{%ORANGE%$f(ROUND(%PTSRING_MELEE%*100/%PTS_RING_DIV%)/100) Pt PVM Melee Ring%CL%%NAME%}
ItemDisplay[rin !UNI !SET ID MINDMG+MAXDMG>9 $f(%PTSRING_MELEE%>767)]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSRING_MELEE%*100/%PTS_RING_DIV%)/100) Pt{%PURPLE%$f(ROUND(%PTSRING_MELEE%*100/%PTS_RING_DIV%)/100) Pt PVM Melee Ring%CL%%NAME%}

// PVM Caster Ring — no STAT86 / no MAEK
ItemDisplay[rin !UNI !SET ID FCR>0 !(STAT86>0) !(MAEK>0) $f(%PTSRING_CASTER%>383) $f(%PTSRING_CASTER%<768)]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) Pt{%ORANGE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) Pt PVM Caster Ring%CL%%NAME%}
ItemDisplay[rin !UNI !SET ID FCR>0 !(STAT86>0) !(MAEK>0) $f(%PTSRING_CASTER%>767)]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) Pt{%PURPLE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) Pt PVM Caster Ring%CL%%NAME%}

// PVM Caster Ring — with STAT86 (threshold -128 for implicit STAT86 value)
ItemDisplay[rin !UNI !SET ID FCR>0 (STAT86>0) !(MAEK>0) $f(%PTSRING_CASTER%>255) $f(%PTSRING_CASTER%<640)]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) Pt{%ORANGE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) Pt PVM Caster Ring%CL%%NAME%}
ItemDisplay[rin !UNI !SET ID FCR>0 (STAT86>0) !(MAEK>0) $f(%PTSRING_CASTER%>639)]: %CONTINUE%%NAME% %PURPLE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) Pt{%PURPLE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) Pt PVM Caster Ring%CL%%NAME%}

// PVM Caster Ring — with MAEK (threshold -128)
ItemDisplay[rin !UNI !SET ID FCR>0 (MAEK>0) !(STAT86>0) $f(%PTSRING_CASTER%>255) $f(%PTSRING_CASTER%<640)]: %CONTINUE%%NAME% %ORANGE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) Pt{%ORANGE%$f(ROUND(%PTSRING_CASTER%*100/%PTS_RING_DIV%)/100) Pt PVM Caster Ring%CL%%NAME%}
