ItemDisplay[jew !UNI !SET ID LVLREQ<31 (STAT91=-15) $f(%PTSJEW_LLD%>124)]: %CONTINUE% %NAME% %PURPLE%$f(ROUND(%PTSJEW_LLD%*100/%PTS_LLDJEW_DIV%)/100) Pt{%PURPLE%$f(ROUND(%PTSJEW_LLD%*100/%PTS_LLDJEW_DIV%)/100) Pt LLD Jewel -15%CL%%NAME%}

