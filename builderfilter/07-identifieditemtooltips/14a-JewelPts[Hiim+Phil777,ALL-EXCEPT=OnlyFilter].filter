// ------------------------------------------------------------------------------
// Jewel Pts — purple at old 4Pt threshold
// ------------------------------------------------------------------------------

// Melee Jewel (STAT91 -req weight lives in the alias — value of -15 = 1Pt)
ItemDisplay[jew GROUND !UNI !SET ID $f(ROUND(PTSJEW_MELEE*100/PTS_MELEEJEW_DIV/100))=3]: %CONTINUE% %NAME% %ORANGE%$f(ROUND(%PTSJEW_MELEE%*100/%PTS_MELEEJEW_DIV%)/100)pt{%NAME%}
ItemDisplay[jew !GROUND !UNI !SET ID $f(ROUND(PTSJEW_MELEE*100/PTS_MELEEJEW_DIV/100))=3]: %CONTINUE% %NAME%{%ORANGE%$f(ROUND(%PTSJEW_MELEE%*100/%PTS_MELEEJEW_DIV%)/100) pt Melee Jewel%CL%%NAME%}
ItemDisplay[jew GROUND !UNI !SET ID $f(ROUND(PTSJEW_MELEE*100/PTS_MELEEJEW_DIV/100))>3]: %CONTINUE% %NAME% %PURPLE%$f(ROUND(%PTSJEW_MELEE%*100/%PTS_MELEEJEW_DIV%)/100)pt{%NAME%}
ItemDisplay[jew !GROUND !UNI !SET ID $f(ROUND(PTSJEW_MELEE*100/PTS_MELEEJEW_DIV/100))>3]: %CONTINUE% %NAME%{%PURPLE%$f(ROUND(%PTSJEW_MELEE%*100/%PTS_MELEEJEW_DIV%)/100) pt Melee Jewel%CL%%NAME%}

