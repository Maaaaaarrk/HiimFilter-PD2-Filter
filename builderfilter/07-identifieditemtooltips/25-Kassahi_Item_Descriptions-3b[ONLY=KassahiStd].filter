
// Crafting Recipes Shown for Magic Items and Freshly-Found Rares
ItemDisplay[(MAG OR RARE) ID !EQUIPPED STAT486=0 (amu OR rin OR (MAG (GLOVES OR BOOTS OR BELT) OR (RARE ELT (GLOVES OR BOOTS OR BELT))))]: %NAME%{%NAME%%CL%%WHITE%crafted: %GRAY%alvl:%WHITE%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID !EQUIPPED STAT486=0 (WEAPON OR ARMOR) !(CIRC OR (MAG (GLOVES OR BOOTS OR BELT) OR (RARE ELT (GLOVES OR BOOTS OR BELT))))]: %NAME%{%NAME%%CL%%WHITE%crafted: %GRAY%alvl:%WHITE%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID !EQUIPPED (HELM !CIRC) CRAFTALVL>80]: %NAME%{%NAME%%ORANGE%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID !EQUIPPED amu CRAFTALVL>89]: %NAME%{%NAME%%ORANGE%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID !EQUIPPED WEAPON CRAFTALVL>76]: %NAME%{%NAME%%ORANGE%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID !EQUIPPED CHEST CRAFTALVL>84]: %NAME%{%NAME%%ORANGE%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID !EQUIPPED SHIELD CRAFTALVL>84]: %NAME%{%NAME%%ORANGE%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID !EQUIPPED GLOVES CRAFTALVL>74]: %NAME%{%NAME%%ORANGE%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID !EQUIPPED rin CRAFTALVL>80]: %NAME%{%NAME%%ORANGE%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID !EQUIPPED BELT CRAFTALVL>70]: %NAME%{%NAME%%ORANGE%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID !EQUIPPED BOOTS CRAFTALVL>69]: %NAME%{%NAME%%ORANGE%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ID !EQUIPPED STAT486=0 ((WEAPON OR (ARMOR !CIRC) OR amu OR rin))]: %NAME%{%NAME%%CRAFTALVL%}%CONTINUE%


