//-----------------------------------------------------------------------------------
// LLD-only: clvl targets for crafted ilvl 51/71 and alvl 40/45 on any craft base
// Game rounds after each /2 and stores as ints:
//   crafted_ilvl = ROUND(CLVL/2) + ROUND(ILVL/2)  ->  clvl = 2*(target - ROUND(ILVL/2))
//   crafted_alvl = MAX(CI - ROUND(QLVL/2), CI*2 - 99) where CI = crafted_ilvl
//     -> min CI  = MIN(target_alvl + ROUND(QLVL/2), CEIL((target_alvl + 99)/2))
//        precomputed: CEIL(139/2)=70 for alvl 40, CEIL(144/2)=72 for alvl 45
//-----------------------------------------------------------------------------------
ItemDisplay[(MAG OR RARE) ID ILVL>50 STAT360=0 !cm1 !cm2 !cm3 !jew !EQ7]: %NAME%{%CL%%NAME%%CORAL% Craft at clvl $f(2*(51-ROUND(ILVL/2))) for ilvl 51 (alvl $f(MAX(51-ROUND(QLVL/2),3)))%CL%%CORAL% Craft at clvl $f(2*(71-ROUND(ILVL/2))) for ilvl 71 (alvl $f(MAX(71-ROUND(QLVL/2),43)))%CL%%CORAL% Craft at clvl $f(2*(MIN(40+ROUND(QLVL/2),70)-ROUND(ILVL/2))) for alvl 40%CL%%CORAL% Craft at clvl $f(2*(MIN(45+ROUND(QLVL/2),72)-ROUND(ILVL/2))) for alvl 45}%CONTINUE%
