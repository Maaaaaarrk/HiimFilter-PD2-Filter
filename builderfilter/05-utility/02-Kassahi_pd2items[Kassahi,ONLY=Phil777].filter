//-----------------------------------------------------------------------------------
// Kassahi-only PD2 items
//
// Items also covered by Hiim's `03-PD2_items[ALL]` / `04-Ubermats[ALL]` (which use
// alias-driven decoration like %GEN_ITEM%, %BOSS_MAT%, %BOSS_ENTRY%, %TOKEN_PARTS%,
// %UBER_KEYS%) are NOT redefined here — they render with Kassahi-variant styling
// because each Kassahi variant's `03-alias-kassahi-general-*.filter` defines those
// aliases with Kassahi visuals.
//
// %MAIN_DOT% (defined per-variant in 03-alias-kassahi-{normal,hyper,luxe}.filter)
// is used inline below for variant-specific dot decoration. It is NOT wrapped in
// another alias body — PD2 only resolves aliases one level deep at ItemDisplay
// substitution time, so nesting %MAIN_DOT% inside another Alias[] body causes
// the engine to emit the literal token. BLAME_ONION (which
// doesn't reference MAIN_DOT) remains in `02-alias/04-alias-kassahi-displays`.
//-----------------------------------------------------------------------------------


// Token of Absolution — essence-style TOKEN_PARTS frame
ItemDisplay[toa]: %MAP-0A%%SOUNDID-4715%%TOKEN_PARTS%{%GOLD%Wherever You Are is The Entry Point.%NL%}

// Worldstone Shards — wss rule moved to common 05-utility/02-wss-display[ALL]
// so Hiim filters route through %WSS_SHARD% too. iwss/cwss stay Kassahi-only
// because Hiim handles those differently in 03-PD2_items[ALL]. cwss ends here with
// the BOSS_ENTRY frame and a copy of the value tooltips from 03-PD2_items[ALL].
ItemDisplay[iwss]: %WSS_SHARD%{%NAME%}%CONTINUE%
ItemDisplay[cwss QTY>1 QTY<8]: %NAME%{%PURPLE%WSS %TAN%Estimated Stack Value%WHITE%: $f(%TAINTED_WORLDSTONE_SHARD_STACK_WSS%)%CL%%TAN%HR Estimated Stack Value%WHITE%: $f(%TAINTED_WORLDSTONE_SHARD_STACK_HR%)%CL%%NAME%}%CONTINUE%
ItemDisplay[cwss QTY>7]: %NAME%{%TAN%HR Estimated Stack Value%WHITE%: $f(%TAINTED_WORLDSTONE_SHARD_STACK_HR%)%CL%%NAME%}%CONTINUE%
ItemDisplay[cwss]: %MAP-0A%%SOUNDID-4715%%BOSS_ENTRY%{%PURPLE%WSS %TAN%Estimated Value Each%WHITE%: %TAINTED_WORLDSTONE_SHARD_WSS_VALUE%%CL%%TAN%HR Estimated Value Each%WHITE%: %TAINTED_WORLDSTONE_SHARD_VALUE%%CL%%CURRENCY_TIMESTAMP%%CL%%RED%Corrupts %TAN%your Annihilus}

// Ears
ItemDisplay[(ivea OR ivez OR iveb OR ived OR iven OR ivep OR ives)]: %MAP-4A%%PD2_MATS%{%NAME%}


// Larzuk's Puzzle Piece — mirrors upstream `05-utility/15-pd2items[ALL]:41-42`
// Terminates (no %CONTINUE%) so the shared `03-PD2_items[ALL]` rule below
// doesn't overwrite the Kassahi-styled output.
ItemDisplay[lpp]: %MAP-0A%%SOUNDID-4715%%PD2_MATS%{%GRAY%(Gray/White/Magic/Rare/Crafted)%NL%%WHITE%Armor: 1-2, 1h Weapon: 1-2, 2h Weapon: 2-4%NL%%WHITE%Possible Sockets:%NL%%NAME%}

// Hellfire Torch — Annihilus → Torch tooltip
ItemDisplay[UNI cm2]: %NAME%%CONTINUE%{%WHITE%Make Hellfire Ashes%NL%%TAN%Cube: %WHITE%Torch, Key, to}

// Horadrim Scarabs
ItemDisplay[scrb]: %PX-60%%MAP-0A%%SOUNDID-4715%%NAME%{%GRAY%(These Are Intended For Groups)%NL%%NAME%}%CONTINUE%

//-----------------------------------------------------------------------------------
// Kassahi: hide Arcane / Angelic / Destruction orbs at every filter level.
//
//   irma — Infused Arcane Orb
//   upma — Angelic Orb        (base)
//   urma — Infused Angelic Orb
//   scou — Orb of Destruction
//
// Placed after the styling rules so the empty output wins regardless of the
// prior %CONTINUE% chain.
//-----------------------------------------------------------------------------------

ItemDisplay[(irma OR upma OR urma OR scou)]:
