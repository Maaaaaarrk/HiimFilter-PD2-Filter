// Market Range (min - max HR on the PD2 market, outliers dropped) above the estimated values of
// the PD2 items. Placed before 02-Kassahi_pd2items and 03-PD2_items so the line sits at the top
// of their value tooltips. Values: *_MARKET_RANGE in 02-alias/04-alias-economy-values.
ItemDisplay[cwss]: %NAME%{%TAN%Market Range%WHITE%: %TAINTED_WORLDSTONE_SHARD_MARKET_RANGE%%CL%%NAME%}%CONTINUE%
ItemDisplay[iwss]: %NAME%{%TAN%Market Range%WHITE%: %CATALYST_SHARD_MARKET_RANGE%%CL%%NAME%}%CONTINUE%
ItemDisplay[lbox]: %NAME%{%TAN%Market Range%WHITE%: %LARZUK_PUZZLEBOX_MARKET_RANGE%%CL%%NAME%}%CONTINUE%
ItemDisplay[lpp]: %NAME%{%TAN%Market Range%WHITE%: %LARZUK_PUZZLEPIECE_MARKET_RANGE%%CL%%NAME%}%CONTINUE%
ItemDisplay[imrn]: %NAME%{%TAN%Market Range%WHITE%: %DEMONIC_CUBE_MARKET_RANGE%%CL%%NAME%}%CONTINUE%
