// Map End Wrapper by Tier
ItemDisplay[MAPTIER=1 NMAG]: %MAP-62%%TIER-8%%NAME% %GREEN%*{%NAME%}%CONTINUE%
ItemDisplay[MAPTIER=2 NMAG]: %MAP-62%%TIER-8%%NAME% %YELLOW%*{%NAME%}%CONTINUE%
ItemDisplay[MAPTIER=3 NMAG]: %MAP-62%%TIER-8%%NAME% %MARK_ORANGE_STAR%{%NAME%}%CONTINUE%
//ItemDisplay[MAPTIER=4]: %MAP-62%%TIER-8%%NAME% %RED%*{%NAME%}%CONTINUE%
ItemDisplay[MAPTIER=5 !ID]: %MAP-62%%SOUNDID-4715%%NAME% %GOLD%* * * *{%NAME%}%CONTINUE%
ItemDisplay[MAPTIER=5 ID]: %MAP-62%%SOUNDID-4715%%NAME% %GOLD%*{%NAME%}%CONTINUE%
ItemDisplay[(t61 OR t62)]: %MAP-62%%TIER-4%%NAME% %MARK_PURPLE_STAR%{%NAME%}%CONTINUE%

