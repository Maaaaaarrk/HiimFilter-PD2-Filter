//-----------------------------------------------------------------------------------
// Hiim rejuv display rules (rvl/rvs)
// Split out from `10-Potions[ALL]` so Kassahi can apply its own rejuv handling
// (`12-Kassahi_potions-rejuvs[ONLY=KassahiStd]` / `[Kassahi,ONLY=Phil777]`).
//-----------------------------------------------------------------------------------

ItemDisplay[rvl !RAINBOWS_STYLE]: %PURPLE%big%WHITE%Rejuv{Heals 65% of Life & Mana up to a limit}%CONTINUE%
ItemDisplay[rvl FILTLVL<7 !RAINBOWS_STYLE]: %PURPLE%* %NAME% %PURPLE%*{%NAME%}
ItemDisplay[rvl RAINBOWS_STYLE]: %PURPLE%Rejuv{Heals 65% of Life & Mana up to a limit}%CONTINUE%
ItemDisplay[rvl FILTLVL<7 RAINBOWS_STYLE]: %NAME%{%NAME%}
ItemDisplay[rvl FILTLVL<11]: %NAME%{%NAME%}
ItemDisplay[rvl FILTLVL=11 !RAINBOWS_STYLE]: %PURPLE%GATORADE{%NAME%}
ItemDisplay[rvl FILTLVL=11 RAINBOWS_STYLE]: %PURPLE%Rejuv{%NAME%}
ItemDisplay[rvl (MAPID=161 OR MAPID=162 OR MAPID=163)]: %NAME%{Good Luck on Rathma}
ItemDisplay[rvl]:

ItemDisplay[rvs !RAINBOWS_STYLE]: %WHITE%rejuv{Heals 35% of Life & Mana up to a limit}%CONTINUE%
ItemDisplay[rvs FILTLVL<5 !RAINBOWS_STYLE]: %NAME%%PURPLE%35%{%NAME%}
ItemDisplay[rvs RAINBOWS_STYLE]: %PURPLE%35%{Heals 35% of Life & Mana up to a limit}%CONTINUE%
ItemDisplay[rvs FILTLVL<5 RAINBOWS_STYLE]: %NAME%{%NAME%}
ItemDisplay[rvs FILTLVL<7]: %NAME%{%NAME%}
ItemDisplay[rvs FILTLVL=11 !RAINBOWS_STYLE]: %PURPLE%powerade{%NAME%}
ItemDisplay[rvs FILTLVL=11 RAINBOWS_STYLE]: %NAME%{%NAME%}
ItemDisplay[rvs]:
