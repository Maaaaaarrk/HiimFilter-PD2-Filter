//-----------------------------------------------------------------------------------
// Hiim rejuv display rules (rvl/rvs)
// Split out from `10-Potions[ALL]` so Kassahi can apply its own rejuv handling
// (`12-Kassahi_potions-rejuvs[Kassahi]`).
//-----------------------------------------------------------------------------------

ItemDisplay[rvl]: %PURPLE%big%WHITE%Rejuv{Heals 65% of Life & Mana up to a limit}%CONTINUE%
ItemDisplay[rvl FILTLVL<7]: %PURPLE%* %NAME% %PURPLE%*{%NAME%}
ItemDisplay[rvl FILTLVL<11]: %NAME%{%NAME%}
ItemDisplay[rvl FILTLVL=11]: %PURPLE%GATORADE{%NAME%}
ItemDisplay[rvl (MAPID=161 OR MAPID=162 OR MAPID=163)]: %NAME%{Good Luck on Rathma}
ItemDisplay[rvl]:

ItemDisplay[rvs]: %WHITE%rejuv{Heals 35% of Life & Mana up to a limit}%CONTINUE%
ItemDisplay[rvs FILTLVL<5]: %NAME%%PURPLE%35%{%NAME%}
ItemDisplay[rvs FILTLVL<7]: %NAME%{%NAME%}
ItemDisplay[rvs FILTLVL=11]: %PURPLE%powerade{%NAME%}
ItemDisplay[rvs]:
