


//------------------------------GEMS------------------------------
// GEMS
ItemDisplay[GEM=1 CLVL<24]: %WHITE%Chip-%SAGE%%GEMTYPE%%CONTINUE%
ItemDisplay[GEM=2 CLVL<24]: %WHITE%Fla-%SAGE%%GEMTYPE%%CONTINUE%
ItemDisplay[GEM=3 CLVL<24]: %SAGE%%GEMTYPE%%CONTINUE%
ItemDisplay[(GEM=1 OR GEM=2 OR GEM=3) CLVL>23]:
ItemDisplay[GEM=4 AND GEMTYPE=1 OR gpv OR gpvs]: %WHITE%F %PURPLE%Amethyst%CONTINUE%
ItemDisplay[GEM=4 AND GEMTYPE=2 OR gpw OR gpws]: %WHITE%F %WHITE%Diamond%CONTINUE%
ItemDisplay[GEM=4 AND GEMTYPE=3 OR gpg OR gpgs]: %WHITE%F %GREEN%Emerald%CONTINUE%
ItemDisplay[GEM=4 AND GEMTYPE=4 OR gpr OR gprs]: %WHITE%F %RED%Ruby%CONTINUE%
ItemDisplay[GEM=4 AND GEMTYPE=5 OR gpb OR gpbs]: %WHITE%F %BLUE%Sapphire%CONTINUE%
ItemDisplay[GEM=4 AND GEMTYPE=6 OR gpy OR gpys]: %WHITE%F %YELLOW%Topaz%CONTINUE%
ItemDisplay[GEM=4 AND GEMTYPE=7 OR skz OR skzs]: %WHITE%F %GRAY%Skull%CONTINUE%
ItemDisplay[(GEM=4 AND GEMTYPE=7) OR skl OR skls]: %WHITE%F %GRAY%Skull%CONTINUE%
//Perfect
ItemDisplay[GEM=5 AND GEMTYPE=1 OR gpv OR gpvs]: %WHITE%P %PURPLE%Amethyst%MAP-20%%CONTINUE%
ItemDisplay[GEM=5 AND GEMTYPE=2 OR gpw OR gpws]: %WHITE%P %WHITE%Diamond%MAP-20%%CONTINUE%
ItemDisplay[GEM=5 AND GEMTYPE=3 OR gpg OR gpgs]: %WHITE%P %GREEN%Emerald%MAP-20%%CONTINUE%
ItemDisplay[GEM=5 AND GEMTYPE=4 OR gpr OR gprs]: %WHITE%P %RED%Ruby%MAP-20%%CONTINUE%
ItemDisplay[GEM=5 AND GEMTYPE=5 OR gpb OR gpbs]: %WHITE%P %BLUE%Sapphire%MAP-20%%CONTINUE%
ItemDisplay[GEM=5 AND GEMTYPE=6 OR gpy OR gpys]: %WHITE%P %YELLOW%Topaz%MAP-20%%CONTINUE%
ItemDisplay[GEM=5 AND GEMTYPE=7 OR skz OR skzs]: %WHITE%P %GRAY%Skull%MAP-20%%CONTINUE%

// Restore QTY annotation for stacked flawless/perfect gems before the terminating
ItemDisplay[(GEM=4 OR GEM=5) QTY>1 QTY<51]: %NAME% %QTY_TAG%%CONTINUE%

ItemDisplay[GEM=4 GEMTYPE=1]: %PURPLE%+ %BLACK%O %NAME% %BLACK%O %PURPLE%+%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=2]: %WHITE%+ %BLACK%O %NAME% %BLACK%O %WHITE%+%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=3]: %GREEN%+ %BLACK%O %NAME% %BLACK%O %GREEN%+%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=4]: %RED%+ %BLACK%O %NAME% %BLACK%O %RED%+%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=5]: %BLUE%+ %BLACK%O %NAME% %BLACK%O %BLUE%+%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=6]: %YELLOW%+ %BLACK%O %NAME% %BLACK%O %YELLOW%+%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=7]: %LIGHT_GRAY%+ %BLACK%O %NAME% %BLACK%O %LIGHT_GRAY%+%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=1]: %PURPLE%+ %BLACK%O %PURPLE%%NAME% %BLACK%O %PURPLE%+%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=2]: %WHITE%+ %BLACK%O %WHITE%%NAME% %BLACK%O %WHITE%+%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=3]: %GREEN%+ %BLACK%O %GREEN%%NAME% %BLACK%O %GREEN%+%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=4]: %RED%+ %BLACK%O %RED%%NAME% %BLACK%O %RED%+%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=5]: %BLUE%+ %BLACK%O %BLUE%%NAME% %BLACK%O %BLUE%+%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=6]: %YELLOW%+ %BLACK%O %YELLOW%%NAME% %BLACK%O %YELLOW%+%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=7]: %LIGHT_GRAY%+ %BLACK%O %LIGHT_GRAY%%NAME% %BLACK%O %LIGHT_GRAY%+%CONTINUE%

