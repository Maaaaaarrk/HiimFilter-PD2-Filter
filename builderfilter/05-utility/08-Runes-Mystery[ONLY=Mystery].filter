//-----------------------------------------------------------------------------------
// Runes Mystery
//-----------------------------------------------------------------------------------

// Out of Town
// rune
ItemDisplay[RUNE<21 QTY=1 !IN_TOWN FILTLVL<7]: %ORANGE%Rune%CONTINUE%
// lil rune
ItemDisplay[RUNE>19 RUNE<25 QTY=1 !IN_TOWN]: %ORANGE%lil Rune%CONTINUE%
// mid rune
ItemDisplay[RUNE>24 RUNE<28 QTY=1 !IN_TOWN]: %ORANGE%mid Rune%CONTINUE%
// big rune
ItemDisplay[RUNE>27 QTY=1 !IN_TOWN]: %ORANGE%BIG Rune%CONTINUE%

ItemDisplay[RUNE>0 RUNE<21]: %DOT-70%%NAME%%TIER-8%%CONTINUE%

ItemDisplay[RUNE>19 RUNE<22 FILTLVL<8]: %SOUNDID-4715%%NAME%%CONTINUE%
ItemDisplay[RUNE>21 RUNE<28]: %SOUNDID-4715%%NAME%%CONTINUE%
ItemDisplay[RUNE>27]: %SOUNDID-4719%%NAME%%CONTINUE%
ItemDisplay[RUNE>0]: %TIER-6%%NAME%%CONTINUE%
ItemDisplay[RUNE>0 (FILTLVL<3 OR IN_TOWN)]: %NAME% %GREEN%%RUNENUM%%CONTINUE%

// Show Quantity
ItemDisplay[RUNE>0 QTY>1 QTY<51]: %NAME% %QTY_TAG%%CONTINUE%{%NAME%}

//Larger box for old hands
ItemDisplay[RUNE>0 RUNE<21 FILTLVL>7]: %ORANGE%  %NAME%  %ORANGE%{%NAME%}%CONTINUE%

// Low rune name decorations
// Valuable Crafting rune callout — set defined as CRAFTING_RUNES_SET in 02-alias/04-alias-economy-values
ItemDisplay[RUNE<21 FILTLVL<5 CRAFTING_RUNES_SET]: %RUNE_CRAFT%%CONTINUE%
ItemDisplay[RUNE<21 FILTLVL<5 !CRAFTING_RUNES_SET]: %RUNE_LOW%%CONTINUE%
ItemDisplay[RUNE<21 FILTLVL>4 FILTLVL<7]: %RUNE_LOW%%CONTINUE%


ItemDisplay[RUNE>19 AND RUNE<28]: %RUNE_ALT_MID%%CONTINUE%
ItemDisplay[RUNE>27]: %RUNE_ALT_HIGH%%CONTINUE%

//-----------------------------------------------------------------------------------
