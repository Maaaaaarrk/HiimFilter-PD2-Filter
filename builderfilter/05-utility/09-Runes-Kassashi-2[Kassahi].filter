//-----------------------------------------------------------------------------------
// KASSAHI RUNES (Kassahi bucket + Phil777)
// Style differences are aliases: PHIL777_STYLE (TRUE only for Phil777) gates the rules only
// one style uses; RUNE_LOW_RANGE carries per-style values.
// Phil777 values: 02-alias/03-alias-kassahi-luxe. Kassahi bucket: 02-alias/02-alias-site-fx[ONLY=KassahiStd].
//-----------------------------------------------------------------------------------

// Basic Formatting
// Make sure HR's notify

ItemDisplay[PHIL777_STYLE RUNE>0 RUNE<21]: %DOT-70%%NAME%%CONTINUE%

ItemDisplay[PHIL777_STYLE RUNE>19 RUNE<22 FILTLVL<8]: %SOUNDID-4715%%NAME%%CONTINUE%
ItemDisplay[PHIL777_STYLE RUNE>21 RUNE<26 FILTLVL<9]: %SOUNDID-4715%%NAME%%CONTINUE%

ItemDisplay[PHIL777_STYLE RUNE>25]: %SOUNDID-4719%%NAME%%CONTINUE%
ItemDisplay[PHIL777_STYLE RUNE>0 (FILTLVL<3 OR IN_TOWN)]: %NAME% %GREEN%%RUNENUM%%CONTINUE%

// Show Quantity (Phil777; the Kassahi bucket adds it in 03-unidformatting/01-Kassahi_item-names-5)
ItemDisplay[PHIL777_STYLE RUNE>0 QTY>1 QTY<51]: %NAME% %QTY_TAG%%CONTINUE%{%NAME%}
// Low rune frames. RUNE_LOW_RANGE: Phil777 = El-Lem (1-20); Kassahi bucket = El-Fal (1-19, Lem is RUNE_MID_LOW below).
// Valuable Crafting rune callout - set defined as CRAFTING_RUNES_SET in 02-alias/04-alias-economy-values
ItemDisplay[RUNE_LOW_RANGE CRAFTING_RUNES_SET]: %RUNE_CRAFT%%CONTINUE%
// Filter level 9+: RUNE_LOW_STRICT (Kassahi bucket only: no frame, number only)
ItemDisplay[RUNE_LOW_RANGE !CRAFTING_RUNES_SET (FILTLVL<9 OR PHIL777_STYLE)]: %RUNE_LOW%%CONTINUE%
ItemDisplay[!PHIL777_STYLE RUNE_LOW_RANGE !CRAFTING_RUNES_SET FILTLVL>8]: %RUNE_LOW_STRICT%%CONTINUE%

// Mid rune — LEM PUL (RUNE_MID_LOW), UM MAL (RUNE_MID), IST GUL (RUNE_ALT_MID)
ItemDisplay[RUNE>19 AND RUNE<22]: %RUNE_MID_LOW%%CONTINUE%
ItemDisplay[RUNE>21 AND RUNE<24]: %RUNE_MID%%CONTINUE%
ItemDisplay[RUNE>23 AND RUNE<26]: %RUNE_ALT_MID%%CONTINUE%
// High rune — Vex/Ohm/Lo (26-28)
ItemDisplay[RUNE>25 RUNE<29]: %RUNE_HIGH%%CONTINUE%

// High rune Tier 2 — Sur/Jah/Cham (29, 31, 32)
ItemDisplay[RUNE=29 OR RUNE=31 OR RUNE=32 OR ((RUNE=30 OR RUNE=33) PHIL777_STYLE)]: %RUNE_ALT_HIGH%%CONTINUE%
// High rune Tier 3 — Ber/Zod (30, 33)
ItemDisplay[!PHIL777_STYLE (RUNE=30 OR RUNE=33)]: %RUNE_TOP_HIGH%%CONTINUE%

//------------------------------Runes-tooltip------------------------------
// El-Ko crafting tooltips (issue #981). Placed after every rune name/frame rule so the
// tooltip is the last description written. Issue #982 dropped the terminal FILTLVL<10 copies;
// 09-Runes-Kassashi-5 force-shows runes 1-20 below FILTLVL 10.
ItemDisplay[!PHIL777_STYLE r01s]: %NAME%{%LIGHT_GRAY%Vampiric %WHITE%Boots: %LIGHT_GRAY%O%NL%%WHITE%Crafting Recipes: %ORANGE%El, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r02s]: %NAME%{%WHITE%Brilliant Helm: O%NL%%YELLOW%Bountiful %WHITE%Chest: %YELLOW%O%NL%%LIGHT_GRAY%Vampiric %WHITE%Belt: %LIGHT_GRAY%O%NL%%WHITE%Crafting Recipes: %ORANGE%Eld, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r03s]: %NAME%{%YELLOW%Bountiful %WHITE%Helm: %YELLOW%O%NL%%LIGHT_GRAY%Vampiric %WHITE%Chest: %LIGHT_GRAY%O%NL%%BLUE%Hitpower %WHITE%Weapon: %BLUE%O%NL%%PURPLE%Caster %WHITE%Weapon: %PURPLE%O%NL%%WHITE%Crafting Recipes: %ORANGE%Tir, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r04s]: %NAME%{%GREEN%Safety %WHITE%Shield: %GREEN%O%NL%%BLUE%Hitpower %WHITE%Chest: %BLUE%O%NL%%PURPLE%Caster %WHITE%Helm: %PURPLE%O%NL%%RED%Blood %WHITE%Gloves: %RED%O%NL%%WHITE%Crafting Recipes: %ORANGE%Nef, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r05s]: %NAME%{%GREEN%Safety %WHITE%Chest: %GREEN%O%NL%%BLUE%Hitpower %WHITE%Shield: %BLUE%O%NL%%PURPLE%Caster %WHITE%Shield: %PURPLE%O%NL%%RED%Blood %WHITE%Boots: %RED%O%NL%%WHITE%Crafting Recipes: %ORANGE%Eth, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r06s]: %NAME%{%GREEN%Safety %WHITE%Helm: %GREEN%O%NL%%BLUE%Hitpower %WHITE%Helm: %BLUE%O%NL%%PURPLE%Caster %WHITE%Belt: %PURPLE%O%NL%%RED%Blood %WHITE%Shield: %RED%O%NL%%WHITE%Crafting Recipes: %ORANGE%Ith, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r07s]: %NAME%{%WHITE%Brilliant Amulet: O%NL%%GREEN%Safety %WHITE%Belt: %GREEN%O%NL%%BLUE%Hitpower %WHITE%Belt: %BLUE%O%NL%%PURPLE%Caster %WHITE%Chest: %PURPLE%O%NL%%RED%Blood %WHITE%Belt: %RED%O%NL%%WHITE%Crafting Recipes: %ORANGE%Tal, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r08s]: %NAME%{%GREEN%Safety %WHITE%Gloves: %GREEN%O%NL%%BLUE%Hitpower %WHITE%Boots: %BLUE%O%NL%%PURPLE%Caster %WHITE%Amulet: %PURPLE%O%NL%%RED%Blood %WHITE%Helm: %RED%O%NL%%WHITE%Crafting Recipes: %ORANGE%Ral, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r09s]: %NAME%{%WHITE%Brilliant Shield: O%NL%%GREEN%Safety %WHITE%Boots: %GREEN%O%NL%%BLUE%Hitpower %WHITE%Gloves: %BLUE%O%NL%%PURPLE%Caster %WHITE%Gloves: %PURPLE%O%NL%%RED%Blood %WHITE%Weapon: %RED%O%NL%%WHITE%Crafting Recipes: %ORANGE%Ort, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r10s]: %NAME%{%GREEN%Safety %WHITE%Amulet: %GREEN%O%NL%%BLUE%Hitpower %WHITE%Amulet: %BLUE%O%NL%%PURPLE%Caster %WHITE%Boots: %PURPLE%O%NL%%RED%Blood %WHITE%Chest: %RED%O%NL%%WHITE%Crafting Recipes: %ORANGE%Thul, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r11s]: %NAME%{%GREEN%Safety %WHITE%Ring: %GREEN%O%NL%%BLUE%Hitpower %WHITE%Ring: %BLUE%O%NL%%PURPLE%Caster %WHITE%Ring: %PURPLE%O%NL%%RED%Blood %WHITE%Amulet: %RED%O%NL%%WHITE%Crafting Recipes: %ORANGE%Amn, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r12s]: %NAME%{%WHITE%Brilliant Weapon: O%NL%%LIGHT_GRAY%Vampiric %WHITE%Shield: %LIGHT_GRAY%O%NL%%GREEN%Safety %WHITE%Weapon: %GREEN%O%NL%%RED%Blood %WHITE%Ring: %RED%O%NL%%WHITE%Crafting Recipes: %ORANGE%Sol, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r13s]: %NAME%{%WHITE%Brilliant Gloves: O%NL%%YELLOW%Bountiful %WHITE%Weapon: %YELLOW%O%NL%%LIGHT_GRAY%Vampiric %WHITE%Weapon: %LIGHT_GRAY%O%NL%%WHITE%Crafting Recipes: %ORANGE%Shael, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r14s]: %NAME%{%YELLOW%Bountiful %WHITE%Shield: %YELLOW%O%NL%%LIGHT_GRAY%Vampiric %WHITE%Amulet: %LIGHT_GRAY%O%NL%%WHITE%Crafting Recipes: %ORANGE%Dol, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r15s]: %NAME%{%WHITE%Brilliant Ring: O%NL%%YELLOW%Bountiful %WHITE%Gloves: %YELLOW%O%NL%%LIGHT_GRAY%Vampiric %WHITE%Ring: %LIGHT_GRAY%O%NL%%WHITE%Crafting Recipes: %ORANGE%Hel, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r16s]: %NAME%{%WHITE%Brilliant Belt: O%NL%%YELLOW%Bountiful %WHITE%Boots: %YELLOW%O%NL%%LIGHT_GRAY%Vampiric %WHITE%Gloves: %LIGHT_GRAY%O%NL%%WHITE%Crafting Recipes: %ORANGE%Io, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r17s]: %NAME%{%YELLOW%Bountiful %WHITE%Ring: %YELLOW%O%NL%%LIGHT_GRAY%Vampiric %WHITE%Helm: %LIGHT_GRAY%O%NL%%WHITE%Crafting Recipes: %ORANGE%Lum, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%
ItemDisplay[!PHIL777_STYLE r18s]: %NAME%{%WHITE%Brilliant Boots: O%NL%%YELLOW%Bountiful %WHITE%Amulet: %YELLOW%O%NL%%WHITE%Crafting Recipes: %ORANGE%Ko, %GOLD%O, %BLUE%Magic%GOLD%/%YELLOW%Rare%NL%%NAME%}%CONTINUE%

// force show lower runes
ItemDisplay[PHIL777_STYLE RUNE<21 RUNE>0 FILTLVL<10]: %NAME%{%NAME%}

//-----------------------------------------------------------------------------------
