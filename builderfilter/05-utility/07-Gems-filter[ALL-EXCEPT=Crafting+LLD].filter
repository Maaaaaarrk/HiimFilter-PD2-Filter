//-----------------------------------------------------------------------------------
// GEMS
//-----------------------------------------------------------------------------------
// Hide low tier gems outside of normal or with filter strictness
ItemDisplay[(GEM=1 OR GEM=2 OR GEM=3) (FILTLVL>2 OR DIFF>1)]:

// Formatting for stacked vs unstacked with warning
ItemDisplay[GEM>0 QTY>1 QTY<51]: %NAME% %QTY_TAG%%CONTINUE%{%NAME%}
ItemDisplay[gzv OR glw OR glg OR glr OR glb OR gly OR skl OR gpv OR gpw OR gpg OR gpr OR gpb OR gpy OR skz]: %NAME% %RED%UNSTACKED{%TAN%Note%WHITE%: Cube Gems to stack them}%CONTINUE%

// Flawless
ItemDisplay[GEM=4 FILTLVL<8]: %%NAME%{%NAME%}

//Perfect
ItemDisplay[GEM>4 FILTLVL<8]: %%NAME%{%NAME%}
//Pskull
ItemDisplay[skzs FILTLVL<9]: %NAME%{%NAME%}


// Hide/show gems otherwise
ItemDisplay[GEM>0 (MAPID=1 OR MAPID=40 OR MAPID=75 OR MAPID=103 OR MAPID=109)]: %NAME%
ItemDisplay[GEM>0 GROUND]:

//-----------------------------------------------------------------------------------
