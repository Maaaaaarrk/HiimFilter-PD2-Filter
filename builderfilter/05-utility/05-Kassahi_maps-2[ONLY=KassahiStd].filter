// COLORS FOR MAPS
ItemDisplay[NMAG MAPTIER>0]: %WHITE%%NAME%%CONTINUE%
ItemDisplay[MAG MAPTIER>0]: %BLUE%%NAME%%CONTINUE%
ItemDisplay[RARE MAPTIER>0]: %YELLOW%%NAME%%CONTINUE%
ItemDisplay[UNI MAPTIER>0]: %GOLD%%NAME%%CONTINUE%
// TIERS FOR MAPS
ItemDisplay[NMAG MAPTIER>0]: %NAME%{%NAME%}%CONTINUE%
ItemDisplay[MAPTIER>0 QTY>1]: %NAME% %TAN%x%WHITE%%QTY%{%NAME%}%CONTINUE%
ItemDisplay[MAPTIER=0]: %DOT-80%%NAME% %TAN%•{%NAME%}
ItemDisplay[MAPTIER=1]: %GREEN%$f(MAPTIER) %NAME%%CONTINUE%
ItemDisplay[MAPTIER=2]: %ORANGE%$f(MAPTIER) %NAME%%CONTINUE%
ItemDisplay[MAPTIER=3]: %RED%$f(MAPTIER) %NAME%%CONTINUE%
ItemDisplay[MAPTIER=4]: %PURPLE%$f(MAPTIER) %NAME%%CONTINUE%
ItemDisplay[MAPTIER=5]: %RED%$f(MAPTIER) %NAME%%CONTINUE%
ItemDisplay[MAPTIER>0]: %TAN%t%NAME%%CONTINUE%
ItemDisplay[NMAG MAPTIER=1]: %GREEN%%NAME% %GREEN%•%CONTINUE%
ItemDisplay[NMAG MAPTIER=2]: %ORANGE%%NAME% %ORANGE%•%CONTINUE%
ItemDisplay[NMAG MAPTIER=3 !t35]: %RED%%NAME% %RED%•%CONTINUE%
ItemDisplay[NMAG MAPTIER=4]: %PURPLE%%NAME% %PURPLE%•%CONTINUE%
ItemDisplay[MAPTIER>0 (UNI OR t51 OR t52 OR t53 OR t54 OR t55 OR t56 OR t57 OR t58)]: %UNI_MAPS%{%NAME%}
