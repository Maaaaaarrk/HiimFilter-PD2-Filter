//------------------------------GEMS------------------------------

// Gem / infusion names, the quantity tag and "Unstacked" are set in 03-unidformatting/01-Kassahi_item-names-4

// Formatting for flawless highlighting
ItemDisplay[GEM=4 GEMTYPE=1]: %FLAW_GEM1%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=2]: %FLAW_GEM2%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=3]: %FLAW_GEM3%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=4]: %FLAW_GEM4%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=5]: %FLAW_GEM5%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=6]: %FLAW_GEM6%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=7]: %FLAW_GEM7%%CONTINUE%

// Formatting for perfect highlighting
ItemDisplay[GEM=5 GEMTYPE=1]: %PERF_GEM1%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=2]: %PERF_GEM2%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=3]: %PERF_GEM3%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=4]: %PERF_GEM4%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=5]: %PERF_GEM5%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=6]: %PERF_GEM6%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=7]: %PERF_GEM7%%CONTINUE%

// Formatting for Infusion highlighting
ItemDisplay[crfc]: %INFUSION1%%CONTINUE%
ItemDisplay[crfp]: %INFUSION2%%CONTINUE%
ItemDisplay[crfs]: %INFUSION3%%CONTINUE%
ItemDisplay[crfb]: %INFUSION4%%CONTINUE%
ItemDisplay[crfh]: %INFUSION5%%CONTINUE%
ItemDisplay[crfu]: %INFUSION6%%CONTINUE%
ItemDisplay[crfv]: %INFUSION7%%CONTINUE%
