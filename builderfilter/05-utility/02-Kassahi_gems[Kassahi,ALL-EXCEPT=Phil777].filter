//------------------------------GEMS------------------------------

// Gem / infusion names and the quantity tag are set in 03-unidformatting/01-Kassahi_item-names-4

// Formatting for flawless highlighting
ItemDisplay[GEM=4 GEMTYPE=1 (gzv OR gzvs)]: %FLAW_GEM1%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=2 (glw OR glws)]: %FLAW_GEM2%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=3 (glg OR glgs)]: %FLAW_GEM3%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=4 (glr OR glrs)]: %FLAW_GEM4%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=5 (glb OR glbs)]: %FLAW_GEM5%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=6 (gly OR glys)]: %FLAW_GEM6%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=7 (skl OR skls)]: %FLAW_GEM7%%CONTINUE%

// Formatting for perfect highlighting
ItemDisplay[GEM=5 GEMTYPE=1 (gpv OR gpvs)]: %PERF_GEM1%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=2 (gpw OR gpws)]: %PERF_GEM2%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=3 (gpg OR gpgs)]: %PERF_GEM3%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=4 (gpr OR gprs)]: %PERF_GEM4%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=5 (gpb OR gpbs)]: %PERF_GEM5%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=6 (gpy OR gpys)]: %PERF_GEM6%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=7 (skz OR skzs)]: %PERF_GEM7%%CONTINUE%

// Formatting for Infusion highlighting
ItemDisplay[crfc]: %INFUSION1%%CONTINUE%
ItemDisplay[crfp]: %INFUSION2%%CONTINUE%
ItemDisplay[crfs]: %INFUSION3%%CONTINUE%
ItemDisplay[crfb]: %INFUSION4%%CONTINUE%
ItemDisplay[crfh]: %INFUSION5%%CONTINUE%
ItemDisplay[crfu]: %INFUSION6%%CONTINUE%
ItemDisplay[crfv]: %INFUSION7%%CONTINUE%
