//------------------------------GEMS------------------------------

// Formatting for gem name
ItemDisplay[GEM=4]: %WHITE%Flawless%CONTINUE%
ItemDisplay[GEM=5]: %WHITE%Perfect%CONTINUE%

// Formatting for gem o/O colors
ItemDisplay[(GEM>3 GEM<6) GEMTYPE=1]: %NAME% %PURPLE%%CONTINUE%
ItemDisplay[(GEM>3 GEM<6) GEMTYPE=2]: %NAME% %WHITE%%CONTINUE%
ItemDisplay[(GEM>3 GEM<6) GEMTYPE=3]: %NAME% %GREEN%%CONTINUE%
ItemDisplay[(GEM>3 GEM<6) GEMTYPE=4]: %NAME% %RED%%CONTINUE%
ItemDisplay[(GEM>3 GEM<6) GEMTYPE=5]: %NAME% %BLUE%%CONTINUE%
ItemDisplay[(GEM>3 GEM<6) GEMTYPE=6]: %NAME% %YELLOW%%CONTINUE%
ItemDisplay[(GEM>3 GEM<6) GEMTYPE=7]: %NAME% %LIGHT_GRAY%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE>0]: %NAME%o%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE>0]: %NAME%O%CONTINUE%

// Formatting for Infusion name
ItemDisplay[(crfc OR crfp OR crfs OR crfb OR crfh OR crfu OR crfv)]: %GOLD%Infusion%CONTINUE%

// Formatting for Infusion @ colors
ItemDisplay[crfc]: %NAME% %PURPLE%%CONTINUE%
ItemDisplay[crfp]: %NAME% %WHITE%%CONTINUE%
ItemDisplay[crfs]: %NAME% %GREEN%%CONTINUE%
ItemDisplay[crfb]: %NAME% %RED%%CONTINUE%
ItemDisplay[crfh]: %NAME% %BLUE%%CONTINUE%
ItemDisplay[crfu]: %NAME% %YELLOW%%CONTINUE%
ItemDisplay[crfv]: %NAME% %LIGHT_GRAY%%CONTINUE%
ItemDisplay[(crfc OR crfp OR crfs OR crfb OR crfh OR crfu OR crfv)]: %NAME%@%CONTINUE%

// Formatting for stacked vs unstacked with warning
ItemDisplay[(GEM>0 OR crfc OR crfp OR crfs OR crfb OR crfh OR crfu OR crfv) QTY>1 QTY<51]: %NAME% %QTY_TAG%%CONTINUE%{%NAME%}
ItemDisplay[gzv OR glw OR glg OR glr OR glb OR gly OR skl OR gpv OR gpw OR gpg OR gpr OR gpb OR gpy OR skz]: %RED%Unstacked %NAME%{%TAN%Note%WHITE%: Cube Gems to stack them}%CONTINUE%

// Formatting for flawless highlighting
ItemDisplay[GEM=4 GEMTYPE=1]: %FLAW_GEM1%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=2]: %FLAW_GEM2%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=3]: %FLAW_GEM3%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=4]: %FLAW_GEM4%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=5]: %FLAW_GEM5%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=6]: %FLAW_GEM6%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE=7]: %FLAW_GEM7%%CONTINUE%

// Formatting for perfect highlighting
ItemDisplay[GEM=5 GEMTYPE=1]: %PERF_GEM1%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=2]: %PERF_GEM2%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=3]: %PERF_GEM3%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=4]: %PERF_GEM4%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=5]: %PERF_GEM5%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=6]: %PERF_GEM6%%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE=7]: %PERF_GEM7%%CONTINUE%

// Formatting for Infusion highlighting
ItemDisplay[crfc]: %INFUSION1%%CONTINUE%
ItemDisplay[crfp]: %INFUSION2%%CONTINUE%
ItemDisplay[crfs]: %INFUSION3%%CONTINUE%
ItemDisplay[crfb]: %INFUSION4%%CONTINUE%
ItemDisplay[crfh]: %INFUSION5%%CONTINUE%
ItemDisplay[crfu]: %INFUSION6%%CONTINUE%
ItemDisplay[crfv]: %INFUSION7%%CONTINUE%
