ItemDisplay[STAT438>0]: %NAME%{witches%NAME%}%CONTINUE%
ItemDisplay[STAT439>0]: %NAME%{vamp lords%NAME%}%CONTINUE%
ItemDisplay[STAT441>0]: %NAME%{reanimated%NAME%}%CONTINUE%
ItemDisplay[STAT470>0]: %NAME%{souls%NAME%}%CONTINUE%
ItemDisplay[STAT499>0]: %NAME%{minions%NAME%}%CONTINUE%
