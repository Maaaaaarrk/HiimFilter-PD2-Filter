// Map Exp, Mf, Dens, Ra
ItemDisplay[(STAT370>0 OR STAT372>0 OR STAT375>0 OR STAT373>0)]: %NAME%{%CL%%NAME%}%CONTINUE%
ItemDisplay[STAT370>0]: %NAME%{%TEAL%mf:%WHITE%%STAT370%%%NAME%}%CONTINUE%
ItemDisplay[STAT370>0 (STAT372>0 OR STAT375>0 OR STAT373>0)]: %NAME%{, %NAME%}%CONTINUE%
ItemDisplay[STAT372>0]: %NAME%{%TEAL%dens:%WHITE%%STAT372%%%NAME%}%CONTINUE%
ItemDisplay[STAT372>0 (STAT375>0 OR STAT373>0)]: %NAME%{, %NAME%}%CONTINUE%
ItemDisplay[STAT375>0]: %NAME%{%TEAL%ra:%WHITE%%STAT375%%%NAME%}%CONTINUE%
ItemDisplay[STAT375>0 STAT373>0]: %NAME%{, %NAME%}%CONTINUE%
ItemDisplay[STAT373>0]: %NAME%{%TEAL%xp:%WHITE%%STAT373%%%NAME%}%CONTINUE%

// Tier 1 Good Maps (XP) & Tier 1 MF Maps
ItemDisplay[(MAPTIER=1 $f(MAP_MF_SCORE)>MAP_MF_T21_ROLLS STAT360=0) OR (MAPTIER=1 STAT360=0 $f(MAP_XP_SCORE)>MAP_XP_T1_ROLLS)]: %NAME%{  %PURPLE%··%YELLOW%··%CL%%NAME%}%CONTINUE%
ItemDisplay[MAPTIER=1 $f(MAP_MF_SCORE)>MAP_MF_T21_ROLLS STAT360=0]: %NAME%{%GREEN%mf%NAME%}%CONTINUE%
ItemDisplay[(MAPTIER=1 $f(MAP_MF_SCORE)>MAP_MF_T21_ROLLS STAT360=0) (MAPTIER=1 STAT360=0 $f(MAP_XP_SCORE)>MAP_XP_T1_ROLLS)]: %NAME%{, %NAME%}%CONTINUE%
ItemDisplay[(MAPTIER=1 $f(MAP_MF_SCORE)>MAP_MF_T21_ROLLS STAT360=0) OR (MAPTIER=1 STAT360=0 $f(MAP_XP_SCORE)>MAP_XP_T1_ROLLS)]: %NAME%{%YELLOW%··%PURPLE%··  %NAME%}%CONTINUE%
// Tier 1 Slammed xp & mf (MAP_XP_SCORE folds STAT374 in, so slammed+1 is covered)
ItemDisplay[(MAPTIER=1 $f(MAP_MF_SCORE)>MAP_MF_T21_SLAM STAT360>0) OR (MAPTIER=1 STAT360>0 $f(MAP_XP_SCORE)>MAP_XP_T1_SLAM)]: %NAME%{  %PURPLE%••%YELLOW%••%CL%%NAME%}%CONTINUE%
ItemDisplay[MAPTIER=1 $f(MAP_MF_SCORE)>MAP_MF_T21_SLAM STAT360>0]: %NAME%{%GREEN%mf%NAME%}%CONTINUE%
ItemDisplay[(MAPTIER=1 $f(MAP_MF_SCORE)>MAP_MF_T21_SLAM STAT360>0) (MAPTIER=1 STAT360>0 $f(MAP_XP_SCORE)>MAP_XP_T1_SLAM)]: %NAME%{, %NAME%}%CONTINUE%
ItemDisplay[(MAPTIER=1 $f(MAP_MF_SCORE)>MAP_MF_T21_SLAM STAT360>0) OR (MAPTIER=1 STAT360>0 $f(MAP_XP_SCORE)>MAP_XP_T1_SLAM)]: %NAME%{%YELLOW%••%PURPLE%••  %NAME%}%CONTINUE%
// Tier 1 Juicer tag
ItemDisplay[MAPTIER=1 STAT372>0 STAT375>0 STAT373>0 $f(MAP_XP_SCORE)>MAP_XP_T3_ROLLS]: %NAME%{%YELLOW%•••%PURPLE%•••  %GREEN%juicy  %PURPLE%•••%YELLOW%•••%CL%%NAME%}%CONTINUE%
// Tier 1 Rating tooltips
ItemDisplay[MAPTIER=1 STAT360=0 $f(MAP_XP_SCORE)>0]: %NAME%{%GOLD%XP Map Rating: $f(ROUND(%MAP_XP_SCORE%*100/%MAP_XP_T1_ROLLS%))%CL%%NAME%}%CONTINUE%
ItemDisplay[MAPTIER=1 STAT360>0 $f(MAP_XP_SCORE)>0]: %NAME%{%GOLD%XP Map Rating: $f(ROUND(%MAP_XP_SCORE%*100/%MAP_XP_T1_SLAM%))%CL%%NAME%}%CONTINUE%
ItemDisplay[MAPTIER=1 STAT360=0 STAT370>0]: %NAME%{%BLUE%MF Map Rating: $f(ROUND(%MAP_MF_SCORE%*100/%MAP_MF_T21_ROLLS%))%CL%%NAME%}%CONTINUE%
ItemDisplay[MAPTIER=1 STAT360>0 STAT370>0]: %NAME%{%BLUE%MF Map Rating: $f(ROUND(%MAP_MF_SCORE%*100/%MAP_MF_T21_SLAM%))%CL%%NAME%}%CONTINUE%
// Tier 1 Reroll note
ItemDisplay[RARE MAPTIER=1 STAT360=0 !($f(MAP_XP_SCORE)>MAP_XP_T1_ROLLS) !($f(MAP_MF_SCORE)>MAP_MF_T21_ROLLS)]: %NAME%{%RED%reroll this map%CL%%NAME%}%CONTINUE%

