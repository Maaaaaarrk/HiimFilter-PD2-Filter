// Stack value formulas for runes (shown when QTY>1)
// WSS stack value shown only when calculated stack HR value <= 5
// Lem-Vex (WSS shown while the stack is worth 5 HR or less)
ItemDisplay[RUNE=20 QTY>1 !$f(LEM_STACK_HR>5)]: %NAME%{%PURPLE%WSS %TAN%Estimated Stack Value%WHITE%: $f(%LEM_STACK_WSS%)%CL%%TAN%HR Estimated Stack Value%WHITE%: $f(%LEM_STACK_HR%)%CL%%NAME%}%CONTINUE%
ItemDisplay[RUNE=20 QTY>1 $f(LEM_STACK_HR>5)]: %NAME%{%TAN%HR Estimated Stack Value%WHITE%: $f(%LEM_STACK_HR%)%CL%%NAME%}%CONTINUE%
ItemDisplay[RUNE=21 QTY>1 !$f(PUL_STACK_HR>5)]: %NAME%{%PURPLE%WSS %TAN%Estimated Stack Value%WHITE%: $f(%PUL_STACK_WSS%)%CL%%TAN%HR Estimated Stack Value%WHITE%: $f(%PUL_STACK_HR%)%CL%%NAME%}%CONTINUE%
ItemDisplay[RUNE=21 QTY>1 $f(PUL_STACK_HR>5)]: %NAME%{%TAN%HR Estimated Stack Value%WHITE%: $f(%PUL_STACK_HR%)%CL%%NAME%}%CONTINUE%
ItemDisplay[RUNE=22 QTY>1 !$f(UM_STACK_HR>5)]: %NAME%{%PURPLE%WSS %TAN%Estimated Stack Value%WHITE%: $f(%UM_STACK_WSS%)%CL%%TAN%HR Estimated Stack Value%WHITE%: $f(%UM_STACK_HR%)%CL%%NAME%}%CONTINUE%
