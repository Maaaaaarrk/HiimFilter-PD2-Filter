ItemDisplay[scrb]: %MAP-4A%%BOSS_MAT%%CONTINUE%{%NAME%}
ItemDisplay[std]: %DOT-9D%%GEN_TOP_RARE%{%NAME%}

// EARS
ItemDisplay[(ivea OR ivez OR iveb OR ived OR iven OR ivep OR ives)]: %MAP-4A%%BOSS_MAT%{%NAME%}

// Map Tier Tags
ItemDisplay[MAPTIER=1 NMAG]: %GREEN%* [T1] %CONTINUE%
ItemDisplay[MAPTIER=1 !NMAG]: %GREEN%[T1] %CONTINUE%
ItemDisplay[MAPTIER=2 NMAG]: %YELLOW%* [T2] %CONTINUE%
ItemDisplay[MAPTIER=2 !NMAG]: %YELLOW%[T2] %CONTINUE%
ItemDisplay[MAPTIER=3 NMAG]: %MARK_ORANGE_STAR% [T3] %CONTINUE%
ItemDisplay[MAPTIER=3 !NMAG]: %ORANGE%[T3] %CONTINUE%
ItemDisplay[MAPTIER=4]: %RED%[T4] %CONTINUE%
ItemDisplay[(MAPTIER=5) !ID]: %GOLD%* * * * [U] %CONTINUE%
ItemDisplay[(MAPTIER=5) ID]: %GOLD%* [U] %CONTINUE%
ItemDisplay[(t61 OR t62)]: %MARK_PURPLE_STAR% [PvP] %CONTINUE%

