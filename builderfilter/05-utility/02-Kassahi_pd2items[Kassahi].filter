//-----------------------------------------------------------------------------------
// Kassahi-only PD2 items
//
// Items also covered by Hiim's `03-PD2_items[ALL]` / `04-Ubermats[ALL]` (which use
// alias-driven decoration like %GEN_ITEM%, %BOSS_MAT%, %BOSS_ENTRY%, %TOKEN_PARTS%,
// %UBER_KEYS%) are NOT redefined here — they render with Kassahi-variant styling
// because each Kassahi variant's `03-alias-kassahi-general-*.filter` defines those
// aliases with Kassahi visuals.
//
// %MAIN_DOT% (defined per-variant in 03-alias-kassahi-{normal,hyper,luxe}.filter)
// is used inline below for variant-specific dot decoration. It is NOT wrapped in
// another alias body — PD2 only resolves aliases one level deep at ItemDisplay
// substitution time, so nesting %MAIN_DOT% inside another Alias[] body causes
// the engine to emit the literal token. HORADRIC_SCARAB and BLAME_ONION (which
// don't reference MAIN_DOT) remain in `02-alias/04-alias-kassahi-displays`.
//-----------------------------------------------------------------------------------


// Token of Absolution — literal "Token" label, no %NAME%
ItemDisplay[toa]: %MAP-0A%%SOUNDID-4715%%RED%%MAIN_DOT%%MAIN_DOT%  %ORANGE%Token  %RED%%MAIN_DOT%%MAIN_DOT%{%GOLD%Wherever You Are is The Entry Point.%NL%}

// Worldstone Shards — wss rule moved to common 05-utility/02-wss-display[ALL]
// so Hiim filters route through %WSS_SHARD% too. iwss/cwss stay Kassahi-only
// because Hiim handles those differently in 03-PD2_items[ALL].
ItemDisplay[iwss]: %WSS_SHARD%{%NAME%}%CONTINUE%
ItemDisplay[cwss]: %MAP-0A%%SOUNDID-4715%%WSS_SHARD%{%NAME%}%CONTINUE%

// Ears
ItemDisplay[(ivea OR ivez OR iveb OR ived OR iven OR ivep OR ives)]: %MAP-4A%%PD2_MATS%{%NAME%}


// Larzuk's Puzzle Piece — mirrors upstream `05-utility/15-pd2items[ALL]:41-42`
// Terminates (no %CONTINUE%) so the shared `03-PD2_items[ALL]` rule below
// doesn't overwrite the Kassahi-styled output.
ItemDisplay[lpp]: %MAP-0A%%SOUNDID-4715%%PD2_MATS%{%GRAY%(Gray/White/Magic/Rare/Crafted)%NL%%WHITE%Armor: 1-2, 1h Weapon: 1-2, 2h Weapon: 2-4%NL%%WHITE%Possible Sockets:%NL%%NAME%}

// Hellfire Torch — Annihilus → Torch tooltip
ItemDisplay[UNI cm2]: %NAME%%CONTINUE%{%WHITE%Make Hellfire Ashes%NL%%TAN%Cube: %WHITE%Torch, Key, to}

// Horadrim Scarabs
ItemDisplay[scrb]: %PX-60%%MAP-0A%%SOUNDID-4715%%HORADRIC_SCARAB%{%GRAY%(These Are Intended For Groups)%NL%%NAME%}%CONTINUE%
ItemDisplay[scrb]: %PD2_MATS%{%NAME%}%CONTINUE%

// Craft Infusions (pre-made craft recipes) — dot decoration inlined per the
// MAIN_DOT note above. Each rule: outer color → mid color → MAIN_DOTs → NAME → mirror.
ItemDisplay[(crfb OR crfc OR crfs OR crfh OR crfv OR crfu OR crfp)]: %MAP-68%%SOUNDID-4715%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[crfb]: %CORAL%%MAIN_DOT%%RED%%MAIN_DOT%%MAIN_DOT%   %NAME%   %RED%%MAIN_DOT%%MAIN_DOT%%CORAL%%MAIN_DOT%{%NAME%}%CONTINUE%               // Blood — life leech / edmg
ItemDisplay[crfc]: %BLUE%%MAIN_DOT%%PURPLE%%MAIN_DOT%%MAIN_DOT%   %NAME%   %PURPLE%%MAIN_DOT%%MAIN_DOT%%BLUE%%MAIN_DOT%{%NAME%}%CONTINUE%            // Caster — fcr / mana
ItemDisplay[crfs]: %DARK_GREEN%%MAIN_DOT%%GREEN%%MAIN_DOT%%MAIN_DOT%   %NAME%   %GREEN%%MAIN_DOT%%MAIN_DOT%%DARK_GREEN%%MAIN_DOT%{%NAME%}%CONTINUE%  // Safety — pdr / resist
ItemDisplay[crfh]: %TEAL%%MAIN_DOT%%BLUE%%MAIN_DOT%%MAIN_DOT%   %NAME%   %BLUE%%MAIN_DOT%%MAIN_DOT%%TEAL%%MAIN_DOT%{%NAME%}%CONTINUE%               // Hitpower — fhr / ctc fnova
ItemDisplay[crfv]: %GOLD%%MAIN_DOT%%ORANGE%%MAIN_DOT%%MAIN_DOT%   %NAME%   %ORANGE%%MAIN_DOT%%MAIN_DOT%%GOLD%%MAIN_DOT%{%NAME%}%CONTINUE%           // Vampiric — ml / plr
ItemDisplay[crfu]: %SAGE%%MAIN_DOT%%YELLOW%%MAIN_DOT%%MAIN_DOT%   %NAME%   %YELLOW%%MAIN_DOT%%MAIN_DOT%%SAGE%%MAIN_DOT%{%NAME%}%CONTINUE%           // Bountiful — mf / lr
ItemDisplay[crfp]: %LIGHT_GRAY%%MAIN_DOT%%WHITE%%MAIN_DOT%%MAIN_DOT%   %NAME%   %WHITE%%MAIN_DOT%%MAIN_DOT%%LIGHT_GRAY%%MAIN_DOT%{%NAME%}%CONTINUE%  // Brilliant — astat / ias
