ItemDisplay[STAT360=0 GROUND FILTLVL>6 !CLASS SHIELD ID (MAG OR RARE OR CRAFT) !((STAT153>0 SOCK>3) OR (STAT153>0 STAT36>9) OR (STAT153>0 EDAM>99) OR (STAT153>0 FCR>19) OR (STAT153>0 STAT110>49) OR (STAT153>0 (FRES+CRES+LRES+PRES>79)) OR (STAT153>0 (STAT40>0 OR STAT42>0 OR STAT44>0 OR STAT46>0)) OR (STAT153>0 ((CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0) (LIFE>29 OR SOCK>1 OR (FRES+CRES+LRES+PRES>59)))) OR (SOCK>3 STAT36>9) OR (SOCK>3 EDAM>99) OR (SOCK>3 FCR>19) OR (SOCK>3 STAT110>49) OR (SOCK>3 (FRES+CRES+LRES+PRES>79)) OR (SOCK>3 (STAT40>0 OR STAT42>0 OR STAT44>0 OR STAT46>0)) OR (SOCK>3 ((CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0) (LIFE>29 OR SOCK>1 OR (FRES+CRES+LRES+PRES>59)))) OR (STAT36>9 EDAM>99) OR (STAT36>9 FCR>19) OR (STAT36>9 STAT110>49) OR (STAT36>9 (FRES+CRES+LRES+PRES>79)) OR (STAT36>9 (STAT40>0 OR STAT42>0 OR STAT44>0 OR STAT46>0)) OR (STAT36>9 ((CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0) (LIFE>29 OR SOCK>1 OR (FRES+CRES+LRES+PRES>59)))) OR (EDAM>99 FCR>19) OR (EDAM>99 STAT110>49) OR (EDAM>99 (FRES+CRES+LRES+PRES>79)) OR (EDAM>99 (STAT40>0 OR STAT42>0 OR STAT44>0 OR STAT46>0)) OR (EDAM>99 ((CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0) (LIFE>29 OR SOCK>1 OR (FRES+CRES+LRES+PRES>59)))) OR (FCR>19 STAT110>49) OR (FCR>19 (FRES+CRES+LRES+PRES>79)) OR (FCR>19 (STAT40>0 OR STAT42>0 OR STAT44>0 OR STAT46>0)) OR (FCR>19 ((CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0) (LIFE>29 OR SOCK>1 OR (FRES+CRES+LRES+PRES>59)))) OR (STAT110>49 (FRES+CRES+LRES+PRES>79)) OR (STAT110>49 (STAT40>0 OR STAT42>0 OR STAT44>0 OR STAT46>0)) OR (STAT110>49 ((CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0) (LIFE>29 OR SOCK>1 OR (FRES+CRES+LRES+PRES>59)))) OR ((FRES+CRES+LRES+PRES>79) (STAT40>0 OR STAT42>0 OR STAT44>0 OR STAT46>0)) OR ((FRES+CRES+LRES+PRES>79) ((CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0) (LIFE>29 OR SOCK>1 OR (FRES+CRES+LRES+PRES>59)))) OR ((STAT40>0 OR STAT42>0 OR STAT44>0 OR STAT46>0) ((CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0) (LIFE>29 OR SOCK>1 OR (FRES+CRES+LRES+PRES>59)))))]: // keep any two of CBF / 4os / 10+ PDR / 100+ ED / 20 FCR / 50+ PLR / 80+ res / max res / class skill with 30+ life, 2+ sockets or 60+ res
ItemDisplay[STAT360=0 GROUND FILTLVL>6 BOOTS ID (MAG OR RARE OR CRAFT) !((FRW>39 STAT86>0) OR (FRW>39 STAT138>0) OR (FRW>39 (FRW>19 (STAT118>0 OR FHR>9 OR DEX>9 OR STR>9 OR STAT110>0 OR (FRES+CRES+LRES+PRES>29)))) OR (STAT86>0 STAT138>0) OR (STAT86>0 (FRW>19 (STAT118>0 OR FHR>9 OR DEX>9 OR STR>9 OR STAT110>0 OR (FRES+CRES+LRES+PRES>29)))) OR (STAT138>0 (FRW>19 (STAT118>0 OR FHR>9 OR DEX>9 OR STR>9 OR STAT110>0 OR (FRES+CRES+LRES+PRES>29)))))]: // keep any two of 40 FRW / LK / MK / 20 FRW with HFD, 10+ FHR, 10+ dex, 10+ str, PLR or 30+ res

