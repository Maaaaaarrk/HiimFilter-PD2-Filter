ItemDisplay[STAT360=0 GROUND FILTLVL>6 GLOVES ID (MAG OR RARE OR CRAFT) !(FCR>19 OR (STAT141>0 STAT136>0) OR (STAT141>0 EDAM>39) OR (STAT141>0 IAS>19) OR (STAT141>0 (TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK50>1)) OR (STAT136>0 EDAM>39) OR (STAT136>0 IAS>19) OR (STAT136>0 (TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK50>1)) OR (EDAM>39 IAS>19) OR (EDAM>39 (TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK50>1)) OR (IAS>19 (TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK50>1)))]: // keep 20 FCR, or any two of DS / CB / 40+ ED / 20 IAS / +2 bow, passive, jav or martial arts
