// Hide low skill trash
ItemDisplay[STAT360=0 GROUND FILTLVL>4 ID (MAG OR RARE OR CRAFT) (STAFF OR WAND OR SOR)]:
// Amazon bows: +3 bow skills with fools, LR proc, -enemy fire / cold res or +fire / cold skill damage
ItemDisplay[!RW !UNI !SET ID BOW TABSK0>2 (FOOLS>0 OR SUFFIX=907 OR SUFFIX=908 OR SUFFIX=909 OR SUFFIX=910 OR SUFFIX=911 OR SUFFIX=912 OR STAT333>0 OR STAT335>0 OR STAT329>0 OR STAT331>0)]:%NAME%{%NAME%}
// Amazon javelins: +3 javelin skills with fools, LR proc, -enemy lightning / poison res or +lightning / poison skill damage
ItemDisplay[!RW !UNI !SET ID JAV TABSK2>2 (FOOLS>0 OR SUFFIX=907 OR SUFFIX=908 OR SUFFIX=909 OR SUFFIX=910 OR SUFFIX=911 OR SUFFIX=912 OR STAT334>0 OR STAT336>0 OR STAT330>0 OR STAT332>0)]:%NAME%{%NAME%}
//-----------------------------------------------------------------------------------
// Hide bad items on level 5-6
//-----------------------------------------------------------------------------------

ItemDisplay[STAT360=0 GROUND FILTLVL>4 FILTLVL<7 (BAR OR DRU OR ((HELM OR CIRC) !CLASS)) ID (MAG OR RARE OR CRAFT) !(EDAM>0 OR FCR>0 OR STAT141>0 OR STAT136>0 OR CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR FRW>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]:
ItemDisplay[STAT360=0 GROUND FILTLVL>4 FILTLVL<7 GLOVES ID (MAG OR RARE OR CRAFT) !(STAT141>0 OR STAT136>0 OR EDAM>0 OR IAS>0 OR FCR>0 OR TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK41>1 OR TABSK50>1)]:
ItemDisplay[STAT360=0 GROUND FILTLVL>4 FILTLVL<7 BELT ID (MAG OR RARE OR CRAFT) !(FCR>0 OR IAS>0 OR FHR>0 OR (FRES+CRES+LRES+PRES>29) OR STAT36>0 OR STAT40>0 OR STAT42>0 OR STAT44>0 OR STAT46>0)]:
ItemDisplay[STAT360=0 GROUND FILTLVL>4 FILTLVL<7 CHEST ID (MAG OR RARE OR CRAFT) !(STAT153>0 OR (ETH REPAIR>0 EDEF>0) OR FCR>19 OR CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1 OR SOCK>3 OR STAT36>9 OR EDAM>99 OR ((CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0) (LIFE>29 OR STR>14 OR DEX>14 OR FCR>0 OR STAT110>0 OR SOCK>1)))]: // keep ETH + repair + ED, 20 FCR, +2 class skills, 4os, 10+ PDR, 100+ ED, or +skills with a stat / FCR / PLR / 2+ sockets
ItemDisplay[STAT360=0 GROUND FILTLVL>4 FILTLVL<7 !NEC SHIELD ID (MAG OR RARE OR CRAFT) !(STAT153>0 OR SOCK>3 OR STAT36>0 OR EDAM>0 OR CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR FCR>0 OR IAS>0 OR FHR>0 OR (FRES+CRES+LRES+PRES>29) OR STAT40>0 OR STAT42>0 OR STAT44>0 OR STAT46>0)]:
ItemDisplay[STAT360=0 GROUND FILTLVL>4 FILTLVL<7 BOOTS ID (MAG OR RARE OR CRAFT) !(STAT118>0 OR FRW>39 OR STAT86>0 OR STAT138>0 OR (FRW>0 AND (FRES+CRES+LRES+PRES>29)))]:
ItemDisplay[STAT360=0 GROUND FILTLVL>4 FILTLVL<7 NEC ID (MAG OR RARE OR CRAFT) !(STAT153>0 OR SOCK>3 OR STAT36>0 OR CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR FCR>0 OR IAS>0 OR FHR>0 OR (FRES+CRES+LRES+PRES>29) OR STAT40>0 OR STAT42>0 OR STAT44>0 OR STAT46>0)]:
ItemDisplay[STAT360=0 GROUND FILTLVL>4 FILTLVL<7 SIN !ETH ID (MAG OR RARE OR CRAFT) !(STAT153>0 OR EDAM>199 OR CLSK6>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]:

// Weapons
ItemDisplay[STAT360=0 GROUND FILTLVL>4 FILTLVL<7 (MAG OR RARE OR CRAFT) WEAPON ID !(SUFFIX=907 OR SUFFIX=908 OR SUFFIX=909 OR SUFFIX=910 OR SUFFIX=911 OR SUFFIX=912 OR SUFFIX=662 OR SUFFIX=898 OR SUFFIX=899 OR SUFFIX=904 OR SUFFIX=905 OR SUFFIX=906 OR EDAM>199 OR CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR FRW>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]:

// Amulets
ItemDisplay[STAT360=0 GROUND FILTLVL>4 FILTLVL<7 (MAG OR RARE OR CRAFT) amu ID !(STAT153>0 OR FCR>0 OR CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR FRW>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]:

// Rings
ItemDisplay[STAT360=0 GROUND FILTLVL>4 FILTLVL<7 (MAG OR RARE OR CRAFT) rin ID !(STAT153>0 OR FCR>0 OR MINDMG>0 OR MAXDMG>0 OR (FRES+CRES+LRES+PRES>29) OR STAT36>0)]:

//-----------------------------------------------------------------------------------
// Hide bad items on level 7+ (stricter keep lists)
//-----------------------------------------------------------------------------------

