// Weapons
ItemDisplay[STAT360=0 GROUND FILTLVL>6 (MAG OR RARE OR CRAFT) WEAPON ID !(EDAM>419 OR (EDAM>249 (MINDMG>19 OR MAXDMG>19 OR FOOLS>0 OR REPAIR>0 OR SOCK>2 OR SUFFIX=662 OR SUFFIX=898 OR SUFFIX=899 OR SUFFIX=904 OR SUFFIX=905 OR SUFFIX=906 OR IAS>29 OR STAT121>0 OR STAT122>0)))]: // keep 420+ ED, or 250+ ED with 20+ min dmg / 20+ max dmg / fools / repair / 3os / amp proc / 30+ IAS / damage to demons / damage to undead

// Amulets
ItemDisplay[STAT360=0 GROUND FILTLVL>6 (MAG OR RARE OR CRAFT) amu ID !(CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1 OR TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK8>1 OR TABSK9>1 OR TABSK10>1 OR TABSK16>1 OR TABSK17>1 OR TABSK18>1 OR TABSK24>1 OR TABSK25>1 OR TABSK26>1 OR TABSK32>1 OR TABSK33>1 OR TABSK34>1 OR TABSK40>1 OR TABSK41>1 OR TABSK42>1 OR TABSK48>1 OR TABSK49>1 OR TABSK50>1 OR (STAT110>74 (FRES+CRES+LRES+PRES>59)))]: // keep +2 class or tree skills, or 75+ PLR with 60+ res

// Rings
ItemDisplay[STAT360=0 GROUND FILTLVL>6 (MAG OR RARE OR CRAFT) rin ID !(FCR>0 OR MINDMG>7 OR MAXDMG>8 OR (STAT0+STAT1+STAT2+STAT3>29))]: // keep FCR, 8+ min damage, 9+ max damage or 30+ total str / dex / vit / energy

//-----------------------------------------------------------------------------------
// ALWAYS SHOW
//-----------------------------------------------------------------------------------
ItemDisplay[STAT360>0 !NMAG]: %MAP-55%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[SHOP !NMAG]: %NAME%%WHITE%{%NAME%}
ItemDisplay[!SHOP !NMAG]: %NAME%%WHITE%{%NAME%}%CONTINUE%
ItemDisplay[(cm1 OR cm2 OR cm3 OR jew) ID]: %NAME%{%NAME%}
ItemDisplay[MAG ID FILTLVL<5]: %DOT-94%%NAME%%TIER-2%{%NAME%}
ItemDisplay[RARE ID]: %DOT-6A%%NAME%%TIER-2%{%NAME%}
ItemDisplay[CRAFT ID]: %DOT-0B%%NAME%%TIER-2%{%NAME%}
ItemDisplay[RW]: %DOT-0E%%RW_LABEL%{%NAME%}
ItemDisplay[UNI ID]: %DOT-D3%%NAME%{%NAME%}
ItemDisplay[SET ID]: %DOT-7D%%NAME%{%NAME%}
ItemDisplay[UNI FILTLVL<5]: %PX-D3%%NAME%{%NAME%}
ItemDisplay[SET FILTLVL<5]: %PX-7D%%NAME%{%NAME%}
ItemDisplay[ID (MAG OR RARE OR SET OR UNI OR CRAFT)]: %NAME%{%NAME%}
//-----------------------------------------------------------------------------------

// ------------------------------------------------------------------------------
// Filter level Setting limiters
// ------------------------------------------------------------------------------

// Show high value small items for gold
ItemDisplay[!SHOP !RW ID FILTLVL<5 FILTLVL>1 PRICE>34999 (WP12 OR WP4 OR WP13 OR CL6 OR CL5) !(wsp OR 9ws OR 7ws)]: %VENDOR_GOLD_TAG%{%GREEN%Sell to Vendor for %GOLD%Gold%CL%%NAME%}

// Hide gems
ItemDisplay[GEM>0 QTY>0]:

//hide most nmag non called out on middle filter levels
ItemDisplay[!SHOP FILTLVL>1 NMAG !RW WEAPON !ETH]:%NOTIFY-DEAD%{%NAME%}
ItemDisplay[!SHOP FILTLVL>2 NMAG !RW WEAPON]:%NOTIFY-DEAD%{%NAME%}
ItemDisplay[!SHOP FILTLVL>1 NMAG !RW ARMOR !(CHEST AND ETH)]:%NOTIFY-DEAD%{%NAME%}

//hide all remaining nmag
ItemDisplay[!SHOP FILTLVL>4 NMAG !RW (WEAPON OR ARMOR OR QUIVER)]:%NOTIFY-DEAD%{%NAME%}

// Hide all remaining magic !eth on semi-strict on hell
ItemDisplay[!SHOP MAG !ID !ETH FILTLVL>1 DIFF=2]:%NOTIFY-DEAD%{%NAME%}

// Hide all remaining magic on later filter levels
ItemDisplay[!SHOP MAG !ID FILTLVL>4]:%NOTIFY-DEAD%{%NAME%}

// Hide all items that arent called out in filter on endgame
ItemDisplay[!SHOP (ARMOR OR WEAPON) !leg DIFF=2 FILTLVL>6]:%NOTIFY-DEAD%{%NAME%}
//-----------------------------------------------------------------------------------


//-----------------------------------------------------------------------------------
// FILTER STRICTNESS ENFORCEMENT
//-----------------------------------------------------------------------------------
ItemDisplay[(FILTLVL>4 OR (FILTLVL>1 AND CLVL>79)) NMAG SOCK=1 !RW (ARMOR OR WEAPON) !ETH]:{%NAME%}
ItemDisplay[FILTLVL>1 NMAG SOCK=1 !RW WEAPON !ETH !ELT]:{%NAME%}
ItemDisplay[FILTLVL>4 MAG !ID !(rin OR amu OR cm1 OR cm2 OR cm3)]:{%NAME%}
ItemDisplay[FILTLVL>4 RARE !ID !(rin OR amu OR cm1 OR cm2 OR cm3)]:{%NAME%}
//-----------------------------------------------------------------------------------
