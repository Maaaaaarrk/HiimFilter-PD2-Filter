//-----------------------------------------------------------------------------------
// TOOLTIPS - UPGRADE REQUIREMENTS + SOCKET WARNINGS
// (Phil777 keeps these next to its own short "up:" note; the recipes in
// 30-Tags_Upgrading-1-recipes would repeat that note, so the Kassahi family skips them)
//-----------------------------------------------------------------------------------

//Upgrade Requirements
ItemDisplay[ID !NMAG !MAG !ELT $f(OR(UPLVL>0,UPSTR>0,UPDEX>0))]:%NAME%{%GRAY%)%CL%%NAME%}%CONTINUE%
ItemDisplay[ID !NMAG !MAG !ELT $f(UPDEX>0) !$f(UPDEX>CHARSTAT2-STAT2)]:%NAME%{%GRAY%Dex %UPDEX% %NAME%}%CONTINUE%
ItemDisplay[ID !NMAG !MAG !ELT $f(UPDEX>0) $f(UPDEX>CHARSTAT2-STAT2)]:%NAME%{%RED%Dex %UPDEX% %NAME%}%CONTINUE%
ItemDisplay[ID !NMAG !MAG !ELT $f(UPSTR>0) !$f(UPSTR>CHARSTAT0-STAT0)]:%NAME%{%GRAY%Str %UPSTR% %NAME%}%CONTINUE%
ItemDisplay[ID !NMAG !MAG !ELT $f(UPSTR>0) $f(UPSTR>CHARSTAT0-STAT0)]:%NAME%{%RED% Str %UPSTR% %NAME%}%CONTINUE%
ItemDisplay[ID !NMAG !MAG !ELT $f(UPLVL>0) !$f(UPLVL>CLVL)]:%NAME%{%GRAY%Lvl %UPLVL% %NAME%}%CONTINUE%
ItemDisplay[ID !NMAG !MAG !ELT $f(UPLVL>0) $f(UPLVL>CLVL)]:%NAME%{%RED%Lvl %UPLVL% %NAME%}%CONTINUE%
ItemDisplay[ID !NMAG !MAG !ELT $f(OR(UPLVL>0,UPSTR>0,UPDEX>0))]:%NAME%{%GRAY%( Requires: %NAME%}%CONTINUE%

//Upgrades That Give +1 Socket on slam / box
ItemDisplay[STAT486=0 !NMAG !MAG ID SOCK=0 STAT360=0 !SHOP !EQUIPPED (8ls OR 9wn OR bsh OR buc OR chn OR clb OR dgr OR dir OR flc OR hax OR hla OR jav OR lea OR lst OR mac OR qui OR sbr OR scl OR scm OR scp OR spc OR ssd OR sst OR stu OR tax OR tkf OR wnd OR xuc OR ywn OR aqv OR cqv OR (ILVL>25 AND (axf OR bar OR ces OR ktr OR lax OR lxb OR ne1 OR ne2 OR ne3 OR ne4 OR ne5 OR sbw OR spr OR wrb)) OR (ILVL>40 AND (8lb OR 9sr OR am5 OR ama OR lbw)))]: %NAME%{%RED%(Upgrade before SLAM For +1 Max Socket Chance)%CL%%NAME%}%CONTINUE%
ItemDisplay[STAT486=0 !NMAG !MAG ID SOCK=0 STAT360=0 !SHOP !EQUIPPED UPLVL>30 LVLREQ<31 (8ls OR 9wn OR bsh OR buc OR chn OR clb OR dgr OR dir OR flc OR hax OR hla OR jav OR lea OR lst OR mac OR qui OR sbr OR scl OR scm OR scp OR spc OR ssd OR sst OR stu OR tax OR tkf OR wnd OR xuc OR ywn OR aqv OR cqv OR (ILVL>25 AND (axf OR bar OR ces OR ktr OR lax OR lxb OR ne1 OR ne2 OR ne3 OR ne4 OR ne5 OR sbw OR spr OR wrb)) OR (ILVL>40 AND (8lb OR 9sr OR am5 OR ama OR lbw)))]: %NAME%{%RED%Warning: WILL increase level requirement over LLD%CL%%NAME%}%CONTINUE%

//Upgrades That Give +1 Max Socket via Puzzle Box (slammed items)
ItemDisplay[STAT486=0 !NMAG !MAG ID STAT360>0 !SHOP !EQUIPPED SOCK=0 (wnd OR 9wn OR ywn OR dgr OR dir OR tkf OR tax OR jav OR sst OR lst OR 8ls OR sbw OR lxb OR spr OR bar)]: %NAME%{%RED%(Upgrade before Puzzle Box For +1 Max Socket)%CL%%NAME%}%CONTINUE%
ItemDisplay[STAT486=0 !NMAG !MAG ID SOCK=0 STAT360>0 !SHOP !EQUIPPED UPLVL>30 LVLREQ<31 (wnd OR 9wn OR ywn OR dgr OR dir OR tkf OR tax OR jav OR sst OR lst OR 8ls OR sbw OR lxb OR spr OR bar)]: %NAME%{%RED%Warning: WILL increase level requirement over LLD%CL%%NAME%}%CONTINUE%

//-----------------------------------------------------------------------------------
