//-----------------------------------------------------------------------------------
// TOOLTIPS - SOCKETING RECIPE Superior
//-----------------------------------------------------------------------------------
// Sup
//ItemDisplay[HELM !INF SUP SOCK=0 NMAG]: %NAME%{%CL%%RED%SLAM %WHITE%For chance of 1 to Max Sockets%CL%%NAME%}%CONTINUE%
//ItemDisplay[CHEST !INF SUP SOCK=0 NMAG]: %NAME%{%CL%%RED%SLAM %WHITE%For chance of 1 to Max Sockets%CL%%NAME%}%CONTINUE%
//ItemDisplay[SHIELD !INF SUP SOCK=0 NMAG]: %NAME%{%CL%%RED%SLAM %WHITE%For chance of 1 to Max Sockets%CL%%NAME%}%CONTINUE%
//ItemDisplay[WEAPON !THROWING !INF SUP SOCK=0 NMAG]: %NAME%{%CL%%RED%SLAM %WHITE%For chance of 1 to Max Sockets%CL%%NAME%}%CONTINUE%
//-----------------------------------------------------------------------------------

// ITEM TAGS - PART 2 stat tags moved to 27-Tags_Nmag_StatTags[Hiim,ALL-EXCEPT=OnlyFilter]
// — Kassahi has its own equivalents in 29-Kassahi_Item_Stat_Names[Kassahi].filter.

// ITEM TAGS - LARZUK FOR SOCKETS
ItemDisplay[NMAG SOCK=0 MAXSOCKETS>0 (ARMOR OR WEAPON OR QUIVER)]:%NAME%{%TAN%Larzuk for $f(MIN(MAXSOCKETS,IF(AND(!NMAG,ONEHAND),4,6),IF(AND(!NMAG,!WEAPON),3,6),IF(STAT360>0,IF(TWOHAND,4,2),6))) sockets%CL%%NAME%}%CONTINUE%

//-----------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------
// TOOLTIPS - SOCKETING RECIPE Non superior
//-----------------------------------------------------------------------------------
// Non sup
ItemDisplay[HELM !INF SOCK=0 NMAG]: %NAME%{%WHITE%This Item + %ORANGE%Ral %WHITE%+ %ORANGE%Thul %WHITE%+ Perf %BLUE%O%CL%%WHITE%Socketing Recipe Rolls 1-Max Sockets:%CL%%NAME%}%CONTINUE%
ItemDisplay[CHEST !INF SOCK=0 NMAG]: %NAME%{%WHITE%This Item + %ORANGE%Tal %WHITE%+ %ORANGE%Thul %WHITE%+ Perf %YELLOW%O%CL%%WHITE%Socketing Recipe Rolls 1-Max Sockets:%CL%%NAME%}%CONTINUE%
ItemDisplay[SHIELD !INF SOCK=0 NMAG]: %NAME%{%WHITE%This Item + %ORANGE%Tal %WHITE%+ %ORANGE%Amn %WHITE%+ Perf %RED%O%CL%%WHITE%Socketing Recipe Rolls 1-Max Sockets:%CL%%NAME%}%CONTINUE%
ItemDisplay[(aqv OR cqv OR aqv2 OR cqv2 OR aqv3 OR cqv3) !INF SOCK=0 NMAG]: %NAME%{%WHITE%This Item + %ORANGE%Tal %WHITE%+ %ORANGE%Amn %WHITE%+ Perf %RED%O%CL%%WHITE%Socketing Recipe Rolls 1-Max Sockets:%CL%%NAME%}%CONTINUE%
ItemDisplay[WEAPON !THROWING !INF SOCK=0 NMAG]: %NAME%{%WHITE%This Item + %ORANGE%Ral %WHITE%+ %ORANGE%Amn %WHITE%+ Perf %PURPLE%O%CL%%WHITE%Socketing Recipe Rolls 1-Max Sockets:%CL%%NAME%}%CONTINUE%
//-----------------------------------------------------------------------------------
