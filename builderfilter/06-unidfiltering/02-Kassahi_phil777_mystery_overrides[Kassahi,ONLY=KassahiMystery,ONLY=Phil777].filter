//-----------------------------------------------------------------------------------
// Phil777 + Mystery overrides
//
// rtp (Navigator), rid (Almanac), rkey (Skeleton Key): show in BIG MYSTERY style
//   (matching SUR/BER/JAH/CHAM/ZOD RUNE_ALT_HIGH visual) but with PURPLE name and
//   NO SOUNDID-4719 ("tink" suppressed).
// lbox (PBOX / Puzzle Box): show in LIL MYSTERY style (matching VEX/OHM/LO
//   RUNE_HIGH visual) with PURPLE name and no SOUNDID.
//-----------------------------------------------------------------------------------

ItemDisplay[(rtp OR rid OR rkey)]: %BORDER-9B%%MAP-7D%%DOT-0B%%BLACK%@%PURPLE%@@%BLACK%@%GREEN%@@%BLACK%@%PURPLE%@@%BLACK%@%GREEN%@@%BLACK%@   %BLACK%O %PURPLE%%NAME%%BLACK% O   %BLACK%@%GREEN%@@%BLACK%@%PURPLE%@@%BLACK%@%GREEN%@@%BLACK%@%PURPLE%@@%BLACK%@{%NAME%}

ItemDisplay[lbox]: %BORDER-9B%%MAP-7D%%DOT-0B%%BLACK%@%GREEN%@%PURPLE%@%BLACK%@%PURPLE%@%GREEN%@%BLACK%@  %BLACK%O%PURPLE%%NAME%%BLACK%O  %BLACK%@%GREEN%@%PURPLE%@%BLACK%@%PURPLE%@%GREEN%@%BLACK%@{%NAME%}
