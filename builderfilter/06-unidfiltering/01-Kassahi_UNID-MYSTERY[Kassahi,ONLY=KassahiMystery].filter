
//------------------------------UNID_ITEM Mystery Override------------------------------


// BOSS ITEMS
ItemDisplay[UNI !ID (ram OR rar OR rbe OR 7qr OR uhn OR uth OR utc OR utb OR 7bs OR 7cr2) !(MAPID=1 OR MAPID=40 OR MAPID=75 OR MAPID=103 OR MAPID=109)]: %PURPLE%Mystery%CONTINUE%
// Overlords Helm
ItemDisplay[UNI !ID uh9 MAPID=137]: %PURPLE%Mystery%CONTINUE%
// GG
ItemDisplay[UNI !ID 4_STAR_UNIQUE !(MAPID=1 OR MAPID=40 OR MAPID=75 OR MAPID=103 OR MAPID=109)]: %PURPLE%Mystery%CONTINUE%
// 4-star uniques only when NOT eth (Shako, Griffon's, HoZ, etc.) — issue #83
ItemDisplay[UNI !ID !ETH 4_STAR_NO_ETH_UNIQUE !(MAPID=1 OR MAPID=40 OR MAPID=75 OR MAPID=103 OR MAPID=109)]: %PURPLE%Mystery%CONTINUE%
ItemDisplay[UNI !ID ETH 4_STAR_ETH_UNIQUE !(MAPID=1 OR MAPID=40 OR MAPID=75 OR MAPID=103 OR MAPID=109)]: %PURPLE%Mystery%CONTINUE%
