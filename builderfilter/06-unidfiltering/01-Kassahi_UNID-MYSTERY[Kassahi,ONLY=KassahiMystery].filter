
//------------------------------UNID_ITEM Mystery Override------------------------------


// BOSS ITEMS
ItemDisplay[UNI !ID (ram OR rar OR rbe OR 7qr OR uhn OR uth OR utc OR utb OR 7bs OR 7cr2) !IN_TOWN]: %PURPLE%Mystery%CONTINUE%
// Overlords Helm
ItemDisplay[UNI !ID uh9 MAPID=137]: %PURPLE%Mystery%CONTINUE%
// GG
// non-ETH and ETH copies are tiered separately (e.g. Shako is 4-star only when not ETH) — issue #83
ItemDisplay[UNI !ID !ETH 4_STAR_UNIQUE !IN_TOWN]: %PURPLE%Mystery%CONTINUE%
ItemDisplay[UNI !ID ETH 4_STAR_ETH_UNIQUE !IN_TOWN]: %PURPLE%Mystery%CONTINUE%
