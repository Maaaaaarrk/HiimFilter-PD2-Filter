//-----------------------------------------------------------------------------------
// CLASS SPECIFIC Items UNID
//-----------------------------------------------------------------------------------
// Pally Shields and Scepters Extra low filter level for paladin
ItemDisplay[PALADIN RARE !ID (DIN OR scp OR 9sc OR 7sc OR gsc OR 9qs OR 7qs OR wsp OR 9ws OR 7ws) FILTLVL<3]: %MAG_DBL_AFFIX_ITEM%

// Druid Clubs Extra low filter level for druid
ItemDisplay[DRUID (MAG OR RARE) !ID (clb OR 9cl OR 7cl OR spc OR 9sp OR 7sp) FILTLVL<3]: %TIER-2%%MAG_DBL_AFFIX_ITEM%

//magic for class you are player additional callout
ItemDisplay[DRUID CL1 FILTLVL<2 MAG !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[BARBARIAN CL2 FILTLVL<2 MAG !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[PALADIN CL3 FILTLVL<2 MAG !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[NECROMANCER CL4 FILTLVL<2 MAG !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[ASSASSIN CL5 FILTLVL<2 MAG !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[SORCERESS CL6 FILTLVL<2 MAG !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[AMAZON CL7 FILTLVL<2 MAG !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%

// rare for class you are player additional callout
ItemDisplay[DRUID CL1 FILTLVL<5 RARE !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[BARBARIAN CL2 FILTLVL<5 RARE !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[PALADIN CL3 FILTLVL<5 RARE !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[NECROMANCER CL4 FILTLVL<5 RARE !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[ASSASSIN CL5 FILTLVL<5 RARE !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[SORCERESS CL6 FILTLVL<5 RARE !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%
ItemDisplay[AMAZON CL7 FILTLVL<5 RARE !ID]: %TIER-2%%MAG_DBL_AFFIX_ITEM%%CONTINUE%

//Trav
ItemDisplay[(MAG OR RARE) CL4 MAPID=83 FILTLVL<8]: %NAME%%TIER-2%

// Arrows and Bolts - Amazon View
ItemDisplay[QUIVER MAG !ID AMAZON FILTLVL<3]: %QUIVER_MAG_AMA%
ItemDisplay[QUIVER RARE !ID AMAZON FILTLVL<5]: %QUIVER_RARE_AMA%
ItemDisplay[QUIVER RARE !ID AMAZON FILTLVL<7]: %QUIVER_RARE_AMA_TIGHT%

// Arrows and Bolts - Non zon
ItemDisplay[QUIVER NMAG SOCK<2]:
ItemDisplay[QUIVER MAG !ID FILTLVL<7]:%NAME%
ItemDisplay[QUIVER MAG !ID]:
ItemDisplay[QUIVER RARE !ID FILTLVL<9]:%NAME%
//-----------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------
// UNID Jewelry
//-----------------------------------------------------------------------------------
// ring amulet
ItemDisplay[MAG amu !ID FILTLVL<5]: %MAG_ITEM%
ItemDisplay[MAG rin !ID FILTLVL<3]: %MAG_ITEM%
//Trav
ItemDisplay[MAG amu !ID MAPID=83 FILTLVL<7]: %NAME%%TIER-2%
//Warlords
ItemDisplay[MAG amu !ID (MAPID=181 OR MAPID=182)]: %NAME%%TIER-2%
ItemDisplay[RARE (amu OR rin) !ID FILTLVL<3 PHIL777_LOOK]: %RARE_ITEM%
//90+ amu 2skill
ItemDisplay[RARE amu !ID ALVL>89 FILTLVL<9 FILTLVL>2]: %RARE_HIGH_ITEM%
ItemDisplay[RARE amu !ID FILTLVL<5]: %NAME%
//85+ ring
ItemDisplay[RARE rin !ID (FILTLVL<5 OR ILVL>84) FILTLVL<7 FILTLVL>2]: %RARE_ITEM%
ItemDisplay[RARE rin !ID FILTLVL<8]: %NAME%

// Jewel
ItemDisplay[MAG jew !ID FILTLVL<7 ILVL>84]: %MAG_DBL_AFFIX_ITEM%
ItemDisplay[MAG jew !ID FILTLVL<11 ILVL>84]: %NAME%
ItemDisplay[MAG jew !ID FILTLVL<7]: %MAG_ITEM%
ItemDisplay[RARE jew !ID ILVL>84]: %SOUNDID-4715%%RARE_GOOD_ITEM%
ItemDisplay[RARE jew !ID]: %RARE_HIGH_ITEM%

// Circlets
ItemDisplay[EQ7 RARE !ID]: %FX_UNID_RARE_SUPER%%RARE_SUPER%
// 3os circ mag 2x affix
ItemDisplay[(ci2 OR ci3) MAG !ETH !ID ILVL>84 FILTLVL<8]: %MAG_DBL_AFFIX_ITEM%
ItemDisplay[(ci2 OR ci3) MAG !ETH !ID FILTLVL<7]: %MAG_ITEM%
ItemDisplay[EQ7 MAG !ETH !ID FILTLVL<5]: %NAME%
ItemDisplay[EQ7 MAG !ID FILTLVL<3]: %NAME%
ItemDisplay[ci3 NMAG !ETH SOCK=0 FILTLVL<3]: %NAME%{%TAN%Note%WHITE%: You can %YELLOW%imbue %WHITE%it using Charsi quest}
