ItemDisplay[MAG cm3 !ID FILTLVL<7]: %CHARM_UNID%
// small
ItemDisplay[MAG cm1 !ID FILTLVL>6]: %CHARM_SC_TAG%%CONTINUE%
ItemDisplay[MAG cm1 ILVL>89 !ID FILTLVL>7]: %CHARM_UNID%
ItemDisplay[MAG cm1 !ID ILVL>89 FILTLVL<8]: %TIER-6%%MAG_DBL_AFFIX_ITEM%
ItemDisplay[MAG cm1 !ID FILTLVL<8]: %TIER-6%%MAG_ITEM%
// large
ItemDisplay[MAG cm2 !ID FILTLVL>6]: %CHARM_LC_TAG%%CONTINUE%
ItemDisplay[MAG cm2 ILVL>89 !ID FILTLVL>7]: %CHARM_UNID%
ItemDisplay[MAG cm2 !ID ILVL>89 FILTLVL<8]: %TIER-6%%MAG_DBL_AFFIX_ITEM%
ItemDisplay[MAG cm2 !ID FILTLVL<7]: %CHARM_UNID%
// Low level catch
ItemDisplay[MAG (cm1 OR cm2 OR cm3) CLVL<80 !ID FILTLVL<9]: %MAG_ITEM%
// Unique Charms - UNID
ItemDisplay[cm2 UNI !ID]: %UNI_UNID_TORCH%
ItemDisplay[cm1 UNI !ID]: %UNI_UNID_ANNI%
ItemDisplay[cm3 UNI !ID FILTLVL<8]: %UNI_UNID_GHEEDS%
