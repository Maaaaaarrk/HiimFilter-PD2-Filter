//-----------------------------------------------------------------------------------
// IMPORTANT DROPS (Damnation)
// Copy of the standard Unid Uniques/Set tiers with the FILTLVL< condition stripped
// from every rule. All rules still apply with their tier styling, but are no longer
// gated by filter level — so every set/unique shows at all filter levels.
//-----------------------------------------------------------------------------------

//  Boss Items
//-----------------------------------------------------------------------------------
// The Third Eye Amulet
// Cage of the Unsullied Boneweave
// Band of Skulls Troll Belt
// Aidans Scar - Scissors Suwayyah
// Cage of the Unsullied - Boneweave
// Dark Abyss - Lacquered Plate
// Band of Skulls - Troll Belt
// Itheraels Path - Mirrored Boots
// Hadriels Hand - Conquest Sword

ItemDisplay[UNI !ID (ram OR rar OR rbe OR 7qr OR uhn OR uth OR utc OR utb OR 7bs)]: %SOUNDID-4719%%UNI_BOSS_ITEM%

// Overlords Helm
ItemDisplay[UNI !ID uh9 MAPID=137]: %SOUNDID-4719%%UNI_BOSS_ITEM%

// 4 Star Unique Callouts
//-----------------------------------------------------------------------------------
ItemDisplay[UNI !ID 4_STAR_UNIQUE]: %SOUNDID-4719%%UNI_GG_ITEM%

// 4 Star Unique Callouts only when not ETH, 3 star when ETH
//-----------------------------------------------------------------------------------
ItemDisplay[UNI !ID !ETH 4_STAR_NO_ETH_UNIQUE]: %SOUNDID-4719%%UNI_GG_ITEM%
ItemDisplay[UNI !ID 4_STAR_NO_ETH_UNIQUE]: %UNI_STAR3_ITEM%

// 4 Star Unique Callouts only when ETH
//-----------------------------------------------------------------------------------
ItemDisplay[UNI !ID ETH 4_STAR_ETH_UNIQUE]: %SOUNDID-4719%%UNI_GG_ITEM%

// Jewelry
//-----------------------------------------------------------------------------------
// Amulet
// Ring
ItemDisplay[UNI !ID (amu OR rin)]: %SOUNDID-4719%%UNI_GG_ITEM%

// Rainbow Facet
ItemDisplay[jew UNI !ID]: %SOUNDID-4719%%FACET_ITEM%

// 3 Star Unique Callouts
// Filter level 1-8
//-----------------------------------------------------------------------------------

ItemDisplay[UNI !ID 3_STAR_UNIQUE]: %SOUNDID-4726%%UNI_STAR3_ITEM%


// 3 Star Unique Callouts only when not ETH, 2 star when ETH
//-----------------------------------------------------------------------------------
ItemDisplay[UNI !ID !ETH 3_STAR_NO_ETH_UNIQUE]: %SOUNDID-4726%%UNI_STAR3_ITEM%
ItemDisplay[UNI !ID 3_STAR_NO_ETH_UNIQUE]: %UNI_STAR2_ITEM%

// 2 Star Unique Callouts
// Filter level 1-7
//-----------------------------------------------------------------------------------
ItemDisplay[UNI !ID 2_STAR_UNIQUE]: %UNI_STAR2_ITEM%

// 1 Star Unique Callouts
// Filter level 1-7
//-----------------------------------------------------------------------------------
ItemDisplay[UNI !ID 1_STAR_UNIQUE]: %UNI_STAR1_ITEM%

// 0 Star Unique Callouts
// Filter level 1-7
//-----------------------------------------------------------------------------------
ItemDisplay[UNI !ID 0_STAR_UNIQUE]: %UNI_STAR0_ITEM%

// 00 Star Unique Callouts
// Filter level 1-6
//-----------------------------------------------------------------------------------
ItemDisplay[UNI !ID NO_STAR_UNIQUE]: %UNI_STAR0_ITEM%

//  lld catch callouts as Tier 1
//-----------------------------------------------------------------------------------
ItemDisplay[UNI !ID LLD_UNIQUE]: %UNI_STAR1_ITEM%

// 4 Star Set Callouts
//-----------------------------------------------------------------------------------
ItemDisplay[SET !ID 4_STAR_SET]: %SOUNDID-4719%%SET_GG_ITEM%

// Set Ring
// Set Amulet
ItemDisplay[SET !ID (amu OR rin)]: %SET_TIER3_ITEM%
ItemDisplay[SET !ID amu]: %NAME%
ItemDisplay[SET !ID rin]: %NAME%

// Only ETH
// Immortal Kings Stone Crusher - Ogre Maul
// Bul-Kathos Sacred Charge - Colossus Blade
// Bul-Kathos Tribal Guardian - Colossus Sword

ItemDisplay[SET !ID ETH (7m7 OR 7gd OR 7fb)]: %SET_GG_ITEM%

// Set tier 3 Set Callouts
//-----------------------------------------------------------------------------------
ItemDisplay[SET !ID 3_STAR_SET]: %SET_TIER3_ITEM%

// Set tier 2 Set Callouts
//-----------------------------------------------------------------------------------
ItemDisplay[SET !ID 2_STAR_SET]: %SET_TIER2_ITEM%

// Any ETH Set weapon catch rest
ItemDisplay[SET !ID ETH WEAPON]: %SET_TIER2_ITEM%
ItemDisplay[SET !ID ETH WEAPON]: %NAME%

// Set tier 1 Set Callouts
//-----------------------------------------------------------------------------------
ItemDisplay[SET !ID 1_STAR_SET]: %SET_TIER1_ITEM%

// Set tier 0 Set Callouts
//-----------------------------------------------------------------------------------
ItemDisplay[SET !ID 0_STAR_SET]: %GREEN%%NAME%

// LLD  lld catch callouts
//-----------------------------------------------------------------------------------
ItemDisplay[SET !ID LLD_SET]: %SET_TIER1_ITEM%%TIER-6%

