// Boss zone catch
//-----------------------------------------------------------------------------------
// Dclone
ItemDisplay[UNI !ID MAPID=137]: %NAME%
// Rathma
ItemDisplay[UNI !ID (MAPID=161 OR MAPID=162 OR MAPID=163)]: %NAME%
