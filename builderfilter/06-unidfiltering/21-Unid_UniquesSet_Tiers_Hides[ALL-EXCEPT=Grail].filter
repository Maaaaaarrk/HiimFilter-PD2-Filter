//-----------------------------------------------------------------------------------
// Unique/Set All other conditions
//-----------------------------------------------------------------------------------


ItemDisplay[UNI !ID !ALLDISCOVERED GRAILENABLED]:  %DOT-D3%%NAME%//grail
ItemDisplay[SET !ID !ALLDISCOVERED GRAILENABLED]:  %DOT-D3%%NAME%//grail

ItemDisplay[UNI !ID (MAPID=181 OR MAPID=182)]: %DOT-D3%%NAME%// Warrior Map catch rest
ItemDisplay[SET !ID (MAPID=181 OR MAPID=182)]: %DOT-7D%%NAME%// Warrior Map catch rest
ItemDisplay[UNI !ID ETH FILTLVL<6 !(7ba OR 7cs OR 7gl)]: %PX-D3%%TIER-6%%NAME%// Eth uni show all
ItemDisplay[SET !ID ETH FILTLVL<6]: %PX-7D%%TIER-6%%NAME%// Eth set show all
ItemDisplay[ELT UNI !ID FILTLVL<6]: %PX-D3%%TIER-4%%NAME%// Show all elite level 1-5 announce 1-4
ItemDisplay[UNI !ID FILTLVL>3 CLVL>84]:// Hide not called out on Semi-Strict and up
ItemDisplay[SET !ID FILTLVL>3 CLVL>84]:// Hide not called out on Semi-Strict and up
ItemDisplay[UNI !ID FILTLVL<4]: %PX-D3%%TIER-2%%GOLD%%NAME%
ItemDisplay[SET !ID FILTLVL<4]: %PX-7D%%TIER-2%%GREEN%%NAME%
//-----------------------------------------------------------------------------------
