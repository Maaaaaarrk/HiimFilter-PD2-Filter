ItemDisplay[UNI !ID (ram OR rar OR rbe OR 7qr OR uhn OR uth OR utc OR utb OR 7bs)]: %FX_UNID_GG%%UNI_BOSS_ITEM%

// Overlords Helm
ItemDisplay[UNI !ID uh9 MAPID=137]: %FX_UNID_GG%%UNI_BOSS_ITEM%

// 4 Star Unique Callouts (non-ETH and ETH copies are tiered separately)
//-----------------------------------------------------------------------------------
ItemDisplay[UNI !ID !ETH FILTLVL<11 4_STAR_UNIQUE]: %FX_UNID_GG%%UNI_GG_ITEM%
ItemDisplay[UNI !ID ETH FILTLVL<11 4_STAR_ETH_UNIQUE]: %FX_UNID_GG%%UNI_GG_ITEM%

// Jewelry
//-----------------------------------------------------------------------------------
// Amulet
// Ring
ItemDisplay[UNI !ID FILTLVL<11 (amu OR rin)]: %FX_UNID_GG%%UNI_GG_ITEM%

// Rainbow Facet
ItemDisplay[jew UNI !ID FILTLVL<11]: %FX_UNID_GG%%FACET_ITEM%

// 3 Star Unique Callouts
// Filter level 1-8
//-----------------------------------------------------------------------------------

ItemDisplay[UNI !ID !ETH FILTLVL<9 3_STAR_UNIQUE]: %FX_UNID_3STAR%%UNI_STAR3_ITEM%
ItemDisplay[UNI !ID ETH FILTLVL<9 3_STAR_ETH_UNIQUE]: %FX_UNID_3STAR%%UNI_STAR3_ITEM%
