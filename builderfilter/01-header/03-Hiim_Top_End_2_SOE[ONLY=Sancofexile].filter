//-----------------------------------------------------------------------------------
// Sanctuary of Exile changes (SOE)

// SOE-only aliases: left/right halves of the UBER_KEYS bracket decoration, used by
// the Voices rule below (the community edit referenced these without defining them).
Alias[UBER_KEYS_LEFT]: %RED%>>  >
Alias[UBER_KEYS_RIGHT]: %RED%<  <<

// Currency items

// Gemcutter/Charsi/Extraction
ItemDisplay[gcbx OR ccbx OR ooe]: %SOUNDID-1118%%PX-68%%ORANGE%* %NAME% %ORANGE%* 
// Carto Box
ItemDisplay[cabx]: %SOUNDID-4715%%BORDER-68%%PURPLE%%ORANGE% %NAME% %ORANGE%%PURPLE% 
//Mythic Orb
ItemDisplay[mfo]: %SOUNDID-248%%DOT-68%%PURPLE%*%ORANGE%*%CORAL%   Mythic Orb  %CORAL%%ORANGE%*%PURPLE%* 
// Exalt Orb
ItemDisplay[exo]: %SOUNDID-248%%DOT-68%%PURPLE%*%ORANGE%*%GREEN%   Exalt Orb   %GREEN%%ORANGE%*%PURPLE%*
// Divine/Sacred Orb
ItemDisplay[dvo OR sror]: %SOUNDID-4714%%BORDER-68%%ORANGE%%PURPLE%*%RED%*%YELLOW%*%GREEN%*   %NAME%   %GREEN%*%YELLOW%*%RED%*%PURPLE%* %ORANGE% 
// Chisel Avarice/Procurement
ItemDisplay[ccsa]: %MAP-68%%GOLD%Chisel-Averice
ItemDisplay[ccpr]: %SOUNDID-4715%%MAP-68%%PURPLE%*%GREEN%* %GOLD%Chisel-Procurement %GREEN%*%PURPLE%*  
// Terror of Opulence/Ethereal/Resplendence/Absolute
ItemDisplay[troo OR troe OR tror OR troa]: %SOUNDID-4715%%BORDER-68%%PURPLE% %NAME% %PURPLE% 
//Glyph of Nemesis/Corruption/Adverseries/Moo/Lineage
ItemDisplay[scnm OR sccn OR scas OR scmo OR schr]: %SOUNDID-4715%%BORDER-68%%PURPLE% %NAME% %PURPLE% 
//Cinder Soul
ItemDisplay[hfcr]: %BORDER-68%%ORANGE%  %NAME%  %ORANGE% 
//Cinder Cluster
ItemDisplay[hfmx]: %SOUNDID-4715%%BORDER-68%%ORANGE%  %NAME%  %ORANGE% 

// Ornate Charms - Magic Unid
ItemDisplay[MAG !ID cm4]: %BLUE% %NAME% %BLUE%

// Ornate Charms - Unique Unid
ItemDisplay[UNI !ID cm4]: %GOLD%*** %NAME% *** %GOLD%

// Mythic jewel ---------------------------------------------------------

ItemDisplay[mjw MAG !ID ALVL>90]: %SOUNDID-248%%GOLD%**%BLUE% %NAME% hi alvl:%ALVL%%GOLD%**
ItemDisplay[mjw MAG !ID]: %NAME% alvl:%ALVL%
ItemDisplay[mjw RARE !ID ALVL>90]: %DOT-A8%%SOUNDID-248%%ORANGE%** hi alvl %ALVL%%YELLOW% %NAME% %ORANGE%**
ItemDisplay[mjw RARE !ID]: %NAME% alvl %ALVL%
ItemDisplay[mjw UNI]: %NAME%


// Display Rolls In Name
ItemDisplay[mjw ID (STAT105>0 OR STAT91<0 OR STAT501>0 OR RES>0 OR FHR>0 OR STAT86>0 OR STAT138>0 OR IAS>0 OR EDAM>0 OR MINDMG>0 OR MAXDMG>0 OR MANA>14 OR REPLIFE>2 OR STR+DEX>9 OR STAT77>0 OR STAT1>0)]: {%NAME%}%CONTINUE%

// - req STAT91
ItemDisplay[mjw STAT91<0]: %SAGE%-Req %NAME%%CONTINUE%{%NAME%}

// IAS
ItemDisplay[mjw IAS>0]: %GOLD%IAS %NAME%%CONTINUE%{%NAME%}

// FCR
ItemDisplay[mjw STAT105>0]: %GOLD%%STAT105%FCR%NAME%%CONTINUE%{%NAME%}

// MAX MANA %
ItemDisplay[mjw STAT77>0]: %BLUE%%STAT77%%Mana %NAME%%CONTINUE%{%NAME%}

// Energy 
ItemDisplay[mjw STAT1>0]: %BLUE%+%STAT1% Energy %NAME%%CONTINUE%{%NAME%}

// Open Wounds
ItemDisplay[mjw !UNI STAT501>0]: %RED%+%STAT501% OW %NAME%%CONTINUE%{%NAME%}

// ED
ItemDisplay[mjw EDAM>0]: %GREEN%%EDAM%%ED %NAME%%CONTINUE%{%NAME%}

// Max Dmg
ItemDisplay[mjw STAT24>0 !(STAT23>0)]: %RED%%STAT24% MaxDMG %NAME%%CONTINUE%{%NAME%}

// Min Dmg
ItemDisplay[mjw STAT23>0 !(STAT24>0)]: %BLUE%%STAT23% MinDMG %NAME%%CONTINUE%{%NAME%}

// Dmg Range
ItemDisplay[mjw STAT23>0 STAT24>0]: %RED%+(%STAT23%-%STAT24%)DMG %NAME%%CONTINUE%{%NAME%}

// FHR
ItemDisplay[mjw FHR>0]: %GOLD%FHR %NAME%%CONTINUE%{%NAME%}

// REPLIFE
ItemDisplay[mjw (REPLIFE>2)]: %RED%%REPLIFE%rep %NAME%%CONTINUE%

// Mana
ItemDisplay[mjw (MANA>30)]: %BLUE%%MANA%mana %NAME%%CONTINUE%

// STATS
ItemDisplay[mjw (STR+DEX>9)]: Stat %NAME%%CONTINUE%
ItemDisplay[mjw (STR+DEX>15)]: Fat%NAME%%CONTINUE%
ItemDisplay[mjw (STR+DEX>9)]: %LIGHT_GRAY%%NAME%%CONTINUE%

// Life After Kill
ItemDisplay[mjw !UNI !SET STAT86>0]: %RED%%STAT86% LAEK %NAME%%CONTINUE%{%NAME%}

// Mana After Kill
ItemDisplay[mjw !UNI !SET STAT138>0]: %BLUE%%STAT138% MAEK %NAME%%CONTINUE%{%NAME%}

// All RES
ItemDisplay[mjw !UNI !SET RES>0]: %PURPLE%%RES%% ALL Res %NAME%%CONTINUE%{%NAME%}

ItemDisplay[mjw MAG !ID ALVL>90]: %SOUNDID-248%%GOLD%**%BLUE% %NAME% hi alvl:%ALVL%%GOLD%**
ItemDisplay[mjw MAG !ID]: %NAME% alvl:%ALVL%
ItemDisplay[mjw RARE !ID ALVL>90]: %DOT-A8%%SOUNDID-248%%ORANGE%** hi alvl %ALVL%%YELLOW% %NAME% %ORANGE%**
ItemDisplay[mjw RARE !ID]: %NAME% alvl %ALVL%

// Display Rolls In Name
ItemDisplay[mjw ID (STAT105>0 OR STAT91<0 OR STAT501>0 OR RES>0 OR FHR>0 OR STAT86>0 OR STAT138>0 OR IAS>0 OR EDAM>0 OR MINDMG>0 OR MAXDMG>0 OR MANA>14 OR REPLIFE>2 OR STR+DEX>9 OR STAT77>0 OR STAT1>0)]: {%NAME%}%CONTINUE%

// - req STAT91
ItemDisplay[mjw STAT91<0]: %SAGE%-Req %NAME%%CONTINUE%{%NAME%}

// IAS
ItemDisplay[mjw IAS>0]: %GOLD%IAS %NAME%%CONTINUE%{%NAME%}

// FCR
ItemDisplay[mjw STAT105>0]: %GOLD%%STAT105%%FCR %NAME%%CONTINUE%{%NAME%}

// MAX MANA %
ItemDisplay[mjw STAT77>0]: %BLUE%%STAT77%%Mana %NAME%%CONTINUE%{%NAME%}

// Energy 
ItemDisplay[mjw STAT1>0]: %BLUE%+%STAT1% Energy %NAME%%CONTINUE%{%NAME%}

// Open Wounds
ItemDisplay[mjw !UNI STAT501>0]: %RED%+%STAT501% OW %NAME%%CONTINUE%{%NAME%}

// ED
ItemDisplay[mjw EDAM>0]: %GREEN%%EDAM%%ED %NAME%%CONTINUE%{%NAME%}

// Max Dmg
ItemDisplay[mjw STAT24>0 !(STAT23>0)]: %RED%%STAT24% MaxDMG %NAME%%CONTINUE%{%NAME%}

// Min Dmg
ItemDisplay[mjw STAT23>0 !(STAT24>0)]: %BLUE%%STAT23% MinDMG %NAME%%CONTINUE%{%NAME%}

// Dmg Range
ItemDisplay[mjw STAT23>0 STAT24>0]: %RED%+(%STAT23%-%STAT24%)DMG %NAME%%CONTINUE%{%NAME%}

// FHR
ItemDisplay[mjw FHR>0]: %GOLD%%FHR%%FHR %NAME%%CONTINUE%{%NAME%}

// REPLIFE
ItemDisplay[mjw (REPLIFE>2)]: %RED%%REPLIFE%rep %NAME%%CONTINUE%

// Mana
ItemDisplay[mjw (MANA>30)]: %BLUE%%MANA%mana %NAME%%CONTINUE%

// STATS
ItemDisplay[mjw (STR+DEX>14)]: Stat %NAME%%CONTINUE%
ItemDisplay[mjw (STR+DEX>28)]: Fat%NAME%%CONTINUE%
ItemDisplay[mjw (STR+DEX>14)]: %LIGHT_GRAY%%NAME%%CONTINUE%

// Life After Kill
ItemDisplay[mjw !UNI !SET STAT86>0]: %RED%%STAT86% LAEK %NAME%%CONTINUE%{%NAME%}

// Mana After Kill
ItemDisplay[mjw !UNI !SET STAT138>0]: %BLUE%%STAT138% MAEK %NAME%%CONTINUE%{%NAME%}

// All RES
ItemDisplay[mjw !UNI !SET RES>0]: %PURPLE%%RES%% ALL Res %NAME%%CONTINUE%{%NAME%}

// Pierce
ItemDisplay[mjw !UNI STAT156>0]: %TEAL%%STAT156%Pierce %NAME%%CONTINUE%{%NAME%}


// Top line formatting
ItemDisplay[mjw ID (STAT105>0 OR STAT91<0 OR STAT501>0 OR RES>0 OR FHR>0 OR STAT86>0 OR STAT138>0 OR IAS>0 OR EDAM>0 OR MINDMG>0 OR MAXDMG>0 OR MANA>14 OR REPLIFE>2 OR STR+DEX>9 OR STAT77>0 OR STAT1>0)]: %DOT-50%%NAME%%CL%%CONTINUE%{%NAME%}

// BIG Mythic Jewel callouts
ItemDisplay[mjw FHR>7 STAT91<0 RES>15]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw (FHR>7 OR STAT91<0) RES>19]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw (FHR>7 OR STAT91<0) (FRES+CRES+LRES+PRES>80) RES=0]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw (RES>19 OR STAT91<0 OR FHR>7) (STAT86>5 OR STAT138>5)]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw (STR+DEX>15) (FHR>7 OR STAT91<0 OR REPLIFE>9 OR STAT86>5 OR STAT138>5)]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw STAT86>5 STAT138>5]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw EDAM>44 (STAT121>44 OR STAT122>44)]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw EDAM+STAT121+STAT122>100]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw EDAM>45 (MINDMG+MINDMG+MINDMG+MAXDMG+MAXDMG>25)]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw EDAM>38 EDAM<48 (MINDMG+MINDMG+MINDMG+MAXDMG+MAXDMG>54)]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw EDAM>12 EDAM<40 (MINDMG+MINDMG+MINDMG+MAXDMG+MAXDMG>73)]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw EDAM>37 STAT501>0]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw (MINDMG+MINDMG+MINDMG+MAXDMG+MAXDMG>100)]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw EDAM>45 IAS>15]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw RES>18 IAS>15]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw MANA>32 STAT77>6 (STAT86>5 OR STAT138>5)]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw MANA>37 STAT77>7]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw MANA>34 STAT1>15]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw STAT77>5 (STAT105>4 OR MANA>37 OR STAT1>15)]: %NAME%%PURPLE%BIG %CONTINUE%


// Mythic Jewel name formatting

ItemDisplay[mjw MAG ID (STAT105>0 OR STAT91<0 OR STAT501>0 OR RES>0 OR FHR>0 OR STAT86>0 OR STAT138>0 OR IAS>0 OR EDAM>0 OR MINDMG>0 OR MAXDMG>0 OR MANA>14 OR REPLIFE>2 OR STR+DEX>9 OR STAT77>0 OR STAT1>0)]:%NAME%%BLUE%Mythic Jewel%CONTINUE%{%NAME%}
ItemDisplay[mjw RARE ID (STAT105>0 OR STAT91<0 OR STAT501>0 OR RES>0 OR FHR>0 OR STAT86>0 OR STAT138>0 OR IAS>0 OR EDAM>0 OR MINDMG>0 OR MAXDMG>0 OR MANA>14 OR REPLIFE>2 OR STR+DEX>9 OR STAT77>0 OR STAT1>0)]:%NAME%%YELLOW%Mythic Jewel%CONTINUE%{%NAME%}
ItemDisplay[mjw CRAFT ID (STAT105>0 OR STAT91<0 OR STAT501>0 OR RES>0 OR FHR>0 OR STAT86>0 OR STAT138>0 OR IAS>0 OR EDAM>0 OR MINDMG>0 OR MAXDMG>0 OR MANA>14 OR REPLIFE>2 OR STR+DEX>9 OR STAT77>0 OR STAT1>0)]:%NAME%%ORANGE%Mythic Jewel%CONTINUE%{%NAME%}

ItemDisplay[mjw MAG ALVL>90]:%RED%hi affix rolls alvl:%ALVL%%CL%%BLUE%%NAME% 
ItemDisplay[mjw RARE ALVL>90]:%RED%hi affix rolls alvl:%ALVL%%CL%%YELLOW%%NAME%{%NL%%TAN%Reroll with 3 P.Gems} 

ItemDisplay[mjw MAG]: alvl:%ALVL%%CL%%NAME% {%NL%%TAN%Note: %WHITE%Upgrade to %YELLOW%rare %WHITE%with Jeweller's Prism from Anya.%NL%}
ItemDisplay[mjw RARE]: alvl:%ALVL%%CL%%NAME% 




// Top line formatting
ItemDisplay[mjw ID (STAT105>0 OR STAT91<0 OR STAT501>0 OR RES>0 OR FHR>0 OR STAT86>0 OR STAT138>0 OR IAS>0 OR EDAM>0 OR MINDMG>0 OR MAXDMG>0 OR MANA>14 OR REPLIFE>2 OR STR+DEX>9 OR STAT77>0 OR STAT1>0)]: %DOT-50%%NAME%%CL%%CONTINUE%{%NAME%}

// BIG Mythic Jewel callouts
ItemDisplay[mjw FHR>0 STAT91<0 RES>0]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw (FHR>0 OR STAT91<0) RES>14]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw (FHR>0 OR STAT91<0) (FRES+CRES+LRES+PRES>25) RES=0]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw (RES>14 OR STAT91<0 OR FHR>0) (STAT86>2 OR STAT138>2)]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw (STR+DEX>15) (FHR>0 OR STAT91<0 OR REPLIFE>4 OR STAT86>2 OR STAT138>2)]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw STAT86>3 STAT138>3]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw EDAM>44 (STAT121>44 OR STAT122>44)]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw EDAM+STAT121+STAT122>100]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw EDAM>45 (MINDMG+MINDMG+MINDMG+MAXDMG+MAXDMG>25)]: %NAME%%PURPLE%BIG %CONTINUE%
