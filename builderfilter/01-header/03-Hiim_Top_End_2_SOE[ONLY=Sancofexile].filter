ItemDisplay[mjw MANA>34 STAT1>15]: %NAME%%PURPLE%BIG %CONTINUE%
ItemDisplay[mjw STAT77>5 (STAT105>3 OR MANA>37 OR STAT1>15)]: %NAME%%PURPLE%BIG %CONTINUE%


// Mythic Jewel name formatting

ItemDisplay[mjw MAG ID (STAT105>0 OR STAT91<0 OR STAT501>0 OR RES>0 OR FHR>0 OR STAT86>0 OR STAT138>0 OR IAS>0 OR EDAM>0 OR MINDMG>0 OR MAXDMG>0 OR MANA>14 OR REPLIFE>2 OR STR+DEX>9 OR STAT77>0 OR STAT1>0)]:%NAME%%BLUE%%CL%Mythic Jewel%CONTINUE%{%NAME%}
ItemDisplay[mjw RARE ID (STAT105>0 OR STAT91<0 OR STAT501>0 OR RES>0 OR FHR>0 OR STAT86>0 OR STAT138>0 OR IAS>0 OR EDAM>0 OR MINDMG>0 OR MAXDMG>0 OR MANA>14 OR REPLIFE>2 OR STR+DEX>9 OR STAT77>0 OR STAT1>0)]:%NAME%%YELLOW%%CL%Mythic Jewel%CONTINUE%{%NAME%}
ItemDisplay[mjw CRAFT ID (STAT105>0 OR STAT91<0 OR STAT501>0 OR RES>0 OR FHR>0 OR STAT86>0 OR STAT138>0 OR IAS>0 OR EDAM>0 OR MINDMG>0 OR MAXDMG>0 OR MANA>14 OR REPLIFE>2 OR STR+DEX>9 OR STAT77>0 OR STAT1>0)]:%NAME%%ORANGE%%CL%Mythic Jewel%CONTINUE%{%NAME%}

ItemDisplay[mjw MAG ALVL>90]:%RED%hi affix rolls alvl:%ALVL%%CL%%BLUE%%NAME% 
ItemDisplay[mjw RARE ALVL>90]:%RED%hi affix rolls alvl:%ALVL%%CL%%YELLOW%%NAME%{%NL%%TAN%Reroll with 3 P.Gems} 

