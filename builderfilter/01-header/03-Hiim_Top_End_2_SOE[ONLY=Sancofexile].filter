ItemDisplay[mjw RARE]: alvl:%ALVL%%CL%%NAME% 



// SOE Infernal Maps [tmXi] ----------------------------------------------------------

ItemDisplay[tm1i]: %RED%%NAME%{%CL%%RED%F 120% %YELLOW%L 80% %BLUE% C 75%%CL%%GRAY%Ph 50% %ORANGE%M 50% %DARK_GREEN%P 120%%CL%%NAME%} //Phlegethon
ItemDisplay[tm2i]: %RED%%NAME%{%CL%%RED%F 75% %YELLOW%L 75% %BLUE% C 75%%CL%%GRAY%Ph 115% %ORANGE%M 75% %DARK_GREEN%P 120%%CL%%NAME%} //Throne of insanity
ItemDisplay[tm3i]: %RED%%NAME%{%CL%%RED%F 65% %YELLOW%L 65% %BLUE% C 65%%CL%%GRAY%Ph 50% %ORANGE%M 33% %DARK_GREEN%P 65%%CL%%NAME%} //Blood Moon
ItemDisplay[tm4i]: %RED%%NAME%{%CL%%RED%F 75% %YELLOW%L 75% %BLUE% C 120%%CL%%GRAY%Ph 50% %ORANGE%M 105% %DARK_GREEN%P 80%%CL%%NAME%} //Pandemonium Citadel
ItemDisplay[tm5i]: %RED%%NAME%{%CL%%RED%F 120% %YELLOW%L 75% %BLUE% C 75%%CL%%GRAY%Ph 115% %ORANGE%M 50% %DARK_GREEN%P 75%%CL%%NAME%} //Kehjistan Marketplace
ItemDisplay[tm6i]: %RED%%NAME%{%CL%%RED%F 120% %YELLOW%L 75% %BLUE% C 80%%CL%%GRAY%Ph 115% %ORANGE%M 55% %DARK_GREEN%P 75%%CL%%NAME%} //Canyon Of Sescheron
ItemDisplay[tm7i]: %RED%%NAME%{%CL%%RED%F 75% %YELLOW%L 120% %BLUE% C 75%%CL%%GRAY%Ph 60% %ORANGE%M 105% %DARK_GREEN%P 75%%CL%%NAME%} //Sanatorium 
ItemDisplay[tm8i]: %RED%%NAME%{%CL%%RED%F 75% %YELLOW%L 75% %BLUE% C 75%%CL%%GRAY%Ph 60% %ORANGE%M 105% %DARK_GREEN%P 120%%CL%%NAME%} //Ruined Cistern
ItemDisplay[tm9i]: %RED%%NAME%{%CL%%RED%F 120% %YELLOW%L 75% %BLUE% C 130%%CL%%GRAY%Ph 50% %ORANGE%M 50% %DARK_GREEN%P 75%%CL%%NAME%} //Ashen Plains

// New unique items

ItemDisplay[cm1 UNI !ID (MAPID=188 OR MAPID=189)]: %UBER_KEYS_LEFT%%GOLD% Voices %UBER_KEYS_RIGHT% //Voices
 
ItemDisplay[mgb UNI !ID]: %SOUNDID-34%%BORDER-68%%ORANGE%MAGE %PURPLE%*%RED%*%YELLOW%*%GREEN%*     %GOLD%%NAME%     %GREEN%*%YELLOW%*%RED%*%PURPLE%* %ORANGE%BLOOD?
 
ItemDisplay[mgb UNI !ID]: %SOUNDID-34%%BORDER-68%%ORANGE%MAGE %PURPLE%*%RED%*%YELLOW%*%GREEN%*     %GOLD%%NAME%     %GREEN%*%YELLOW%*%RED%*%PURPLE%* %ORANGE%BLOOD?
 
ItemDisplay[mjw UNI !ID]: %SOUNDID-34%%BORDER-68%%ORANGE%SUPER %PURPLE%*%RED%*%YELLOW%*%GREEN%*  %GOLD%%NAME%  %GREEN%*%YELLOW%*%RED%*%PURPLE%* %ORANGE%RARE
 
//Unique regular jewels
ItemDisplay[jew UNI !ID]: %SOUNDID-621%%BORDER-68%%ORANGE% %PURPLE%*%RED%*%YELLOW%*%GREEN%*     %NAME%     %GREEN%*%YELLOW%*%RED%*%PURPLE%* %ORANGE%
 
