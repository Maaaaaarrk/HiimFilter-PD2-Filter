//-----------------------------------------------------------------------------------
// CLASS BUILD SAFETY NET
// Uniques and set items worn by this class's tier-list builds on hiimpd2.com
// (CLASS_BUILD_UNIQUE / CLASS_BUILD_SET, generated per class filter from
// builderfilter/data/class-build-items.json) keep their usual star look but stay
// visible through filter level 10, where the shared tier rules would hide them.
// 4-star items already show through level 10, so they fall through to the tier rules.
//-----------------------------------------------------------------------------------

// Uniques: non-ETH and ETH copies use their own tier
ItemDisplay[UNI !ID !ETH FILTLVL<11 CLASS_BUILD_UNIQUE 3_STAR_UNIQUE]: %FX_UNID_3STAR%%UNI_STAR3_ITEM%
ItemDisplay[UNI !ID ETH FILTLVL<11 CLASS_BUILD_UNIQUE 3_STAR_ETH_UNIQUE]: %FX_UNID_3STAR%%UNI_STAR3_ITEM%
ItemDisplay[UNI !ID !ETH FILTLVL<11 CLASS_BUILD_UNIQUE 2_STAR_UNIQUE]: %UNI_STAR2_ITEM%
ItemDisplay[UNI !ID ETH FILTLVL<11 CLASS_BUILD_UNIQUE 2_STAR_ETH_UNIQUE]: %UNI_STAR2_ITEM%
ItemDisplay[UNI !ID !ETH FILTLVL<11 CLASS_BUILD_UNIQUE 1_STAR_UNIQUE]: %UNI_STAR1_ITEM%
ItemDisplay[UNI !ID ETH FILTLVL<11 CLASS_BUILD_UNIQUE 1_STAR_ETH_UNIQUE]: %UNI_STAR1_ITEM%
ItemDisplay[UNI !ID !ETH FILTLVL<11 CLASS_BUILD_UNIQUE (0_STAR_UNIQUE OR NO_STAR_UNIQUE)]: %UNI_STAR0_ITEM%
ItemDisplay[UNI !ID ETH FILTLVL<11 CLASS_BUILD_UNIQUE (0_STAR_ETH_UNIQUE OR NO_STAR_ETH_UNIQUE)]: %UNI_STAR0_ITEM%
// not starred at all: still worth a look for this class
ItemDisplay[UNI !ID !ETH FILTLVL<11 CLASS_BUILD_UNIQUE !4_STAR_UNIQUE !(amu OR rin)]: %NAME%
ItemDisplay[UNI !ID ETH FILTLVL<11 CLASS_BUILD_UNIQUE !4_STAR_ETH_UNIQUE !(amu OR rin)]: %NAME%

// Set items
ItemDisplay[SET !ID FILTLVL<11 CLASS_BUILD_SET 3_STAR_SET]: %SET_TIER3_ITEM%
ItemDisplay[SET !ID FILTLVL<11 CLASS_BUILD_SET 2_STAR_SET]: %SET_TIER2_ITEM%
ItemDisplay[SET !ID FILTLVL<11 CLASS_BUILD_SET 1_STAR_SET]: %SET_TIER1_ITEM%
ItemDisplay[SET !ID FILTLVL<11 CLASS_BUILD_SET !4_STAR_SET]: %GREEN%%NAME%
