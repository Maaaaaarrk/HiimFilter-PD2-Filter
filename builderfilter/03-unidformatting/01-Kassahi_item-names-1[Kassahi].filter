




//------------------------------NAMES_FOR_ALL_ITEMS------------------------------





// ITEM'S NAME (BASE)
ItemDisplay[(SET OR UNI) !ID !jew]: %BASENAME%%CONTINUE%
// Upstream applies this to every NMAG item too; here it is limited to gear/jewelry so it
// does not wipe the rune/rejuv names set earlier in 02-alias/03-alias-kassahi-*.
ItemDisplay[(NMAG OR MAG OR RARE OR CRAFT) !RW (rin OR amu OR jew OR ARMOR OR WEAPON)]: %BASENAME%%CONTINUE%
ItemDisplay[MAG (cm1 OR cm2 OR cm3) !STASH !INVENTORY]: %BASENAME%%CONTINUE%

// GG Charms
