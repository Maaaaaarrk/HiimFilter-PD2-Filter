//------------------------------MYSTERY Names------------------------------
// Out of town. Runes get the same names in 05-utility/09-Runes-Kassashi-1mystery (after the rune number is added).
// MYSTERY_QTY: the Kassahi bucket renames single Puzzle Boxes only (QTY=1); Phil777 renames any stack (TRUE).
// Navigator, Almanac, Skeleton Key, Vial and Mirror never stack, so the game reads their QTY as 0: no QTY check.
ItemDisplay[lbox MYSTERY_QTY !IN_TOWN]: %MYSTERY_COLOR%Lil Mystery%CONTINUE%
ItemDisplay[(rkey OR rtp OR rid) !IN_TOWN]: %MYSTERY_COLOR%Big Mystery%CONTINUE%
ItemDisplay[(lsvl OR llmr) !IN_TOWN]: %MYSTERY_COLOR%%MYSTERY_TOP_NAME%%CONTINUE%
