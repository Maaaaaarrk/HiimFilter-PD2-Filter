//-----------------------------------------------------------------------------------
// Kassahi corruption + desecration name suffixes
//
// Ports upstream Kassahi `04-statdecorators/01-item-stat-decorators[ALL]` lines
// 90-245 into our [Kassahi] family. Each rule appends a short identifier
// (e.g., "ed", "ias", "imm") to the item's display name based on the corruption
// (STAT360) or desecration (STAT206) roll value, so socketed/unsocketed
// corrupted gear at a glance tells you what stat got rolled.
//
// STAT477=4 / STAT477=21 are excluded — those are quest items the original
// upstream filter does not annotate.
//-----------------------------------------------------------------------------------

// SLAMMED (CORRUPTED)
ItemDisplay[STAT360>0 !(STAT477=4 OR STAT477=21)]: %NAME% %RED%{%NAME%}%CONTINUE%
ItemDisplay[STAT360=2 !(STAT477=4 OR STAT477=21)]: %NAME%ed{%NAME%}%CONTINUE%
ItemDisplay[STAT360=3 !(STAT477=4 OR STAT477=21)]: %NAME%ar{%NAME%}%CONTINUE%
ItemDisplay[STAT360=4 !(STAT477=4 OR STAT477=21)]: %NAME%lah{%NAME%}%CONTINUE%
ItemDisplay[STAT360=5 !(STAT477=4 OR STAT477=21)]: %NAME%ar/ed dem{%NAME%}%CONTINUE%
ItemDisplay[STAT360=6 !(STAT477=4 OR STAT477=21)]: %NAME%-req{%NAME%}%CONTINUE%
ItemDisplay[STAT360=7 !(STAT477=4 OR STAT477=21)]: %NAME%mf{%NAME%}%CONTINUE%
ItemDisplay[STAT360=8 !(STAT477=4 OR STAT477=21)]: %NAME%lpk{%NAME%}%CONTINUE%
ItemDisplay[STAT360=9 !(STAT477=4 OR STAT477=21)]: %NAME%mpk{%NAME%}%CONTINUE%
ItemDisplay[STAT360=10 !(STAT477=4 OR STAT477=21)]: %NAME%imm{%NAME%}%CONTINUE%
ItemDisplay[STAT360=12 !(STAT477=4 OR STAT477=21)]: %NAME%-efr{%NAME%}%CONTINUE%
ItemDisplay[STAT360=13 !(STAT477=4 OR STAT477=21)]: %NAME%-elr{%NAME%}%CONTINUE%
ItemDisplay[STAT360=14 !(STAT477=4 OR STAT477=21)]: %NAME%-ecr{%NAME%}%CONTINUE%
ItemDisplay[STAT360=15 !(STAT477=4 OR STAT477=21)]: %NAME%-epr{%NAME%}%CONTINUE%
ItemDisplay[(STAT360=16 OR STAT360=42) !(STAT477=4 OR STAT477=21)]: %NAME%fcr{%NAME%}%CONTINUE%
ItemDisplay[STAT360=17 !(STAT477=4 OR STAT477=21)]: %NAME%ll/ed{%NAME%}%CONTINUE%
ItemDisplay[STAT360=19 !(STAT477=4 OR STAT477=21)]: %NAME%ds{%NAME%}%CONTINUE%
ItemDisplay[STAT360=20 !(STAT477=4 OR STAT477=21)]: %NAME%ias{%NAME%}%CONTINUE%
ItemDisplay[STAT360=21 !(STAT477=4 OR STAT477=21)]: %NAME%cb{%NAME%}%CONTINUE%
ItemDisplay[STAT360=22 !(STAT477=4 OR STAT477=21)]: %NAME%ias/ed{%NAME%}%CONTINUE%
ItemDisplay[STAT360=23 !(STAT477=4 OR STAT477=21)]: %NAME%ias/cb{%NAME%}%CONTINUE%
ItemDisplay[STAT360=24 !(STAT477=4 OR STAT477=21)]: %NAME%itd/ed{%NAME%}%CONTINUE%
ItemDisplay[STAT360=25 !(STAT477=4 OR STAT477=21)]: %NAME%ds/ed{%NAME%}%CONTINUE%
ItemDisplay[STAT360=26 !(STAT477=4 OR STAT477=21)]: %NAME%ar/ed{%NAME%}%CONTINUE%
ItemDisplay[(STAT360=27 OR STAT360=50) !(STAT477=4 OR STAT477=21)]: %NAME%all{%NAME%}%CONTINUE%
