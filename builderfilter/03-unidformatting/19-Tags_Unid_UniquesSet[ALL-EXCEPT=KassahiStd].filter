//-----------------------------------------------------------------------------------
// UNI/SET !ID Formatting
//-----------------------------------------------------------------------------------

ItemDisplay[SET !ID !RAINBOWS_STYLE]: %GREEN%%NAME%%CONTINUE%
ItemDisplay[UNI !ID scl RAINBOWS_STYLE]: %CONTINUE%Hawk Tuah
ItemDisplay[UNI !ID 7st RAINBOWS_STYLE]: %CONTINUE%Jibril's Rod
ItemDisplay[UNI !ID pab RAINBOWS_STYLE]: %CONTINUE%ENPHERNO
ItemDisplay[UNI !ID 7vo RAINBOWS_STYLE]: %CONTINUE%Giant Memer
ItemDisplay[UNI !ID 6hb RAINBOWS_STYLE]: %CONTINUE%Cankles
ItemDisplay[UNI !ID 7yw RAINBOWS_STYLE]: %CONTINUE%Nethercrotch
ItemDisplay[SET !ID skp RAINBOWS_STYLE]: %CONTINUE%Arcanna's Head Game
ItemDisplay[SET !ID ltp RAINBOWS_STYLE]: %CONTINUE%Arcanna's Flesh Light
ItemDisplay[SET !ID wst RAINBOWS_STYLE]: %CONTINUE%Arcanna's Magic Wand
ItemDisplay[SET !ID utc RAINBOWS_STYLE]: %CONTINUE%Trang-Oul's Girthquake
ItemDisplay[SET !ID RAINBOWS_STYLE]: %GREEN%%NAME%%CONTINUE%
ItemDisplay[UNI !ID]: %GOLD%%NAME%%CONTINUE%

// FORMATTING
ItemDisplay[ETH UNI !ID]: %GRAY%eth %GOLD%%NAME%%CONTINUE%
ItemDisplay[ETH SET !ID]: %GRAY%eth %GREEN%%NAME%%CONTINUE%

// GRAIL
ItemDisplay[UNI !ID !ALLDISCOVERED !jew]: %GRAIL_TAG% %GOLD%%NAME%%CONTINUE%
ItemDisplay[SET !ID !ALLDISCOVERED]: %GRAIL_TAG% %GREEN%%NAME%%CONTINUE%

// Eth add on callout
ItemDisplay[UNI !ID ETH FILTLVL<5]: %PURPLE%· %NAME% %PURPLE%·%CONTINUE%
ItemDisplay[SET !ID ETH FILTLVL<5]: %PURPLE%· %NAME% %PURPLE%·%CONTINUE%

// LLD UNI
ItemDisplay[UNI (stu OR gth OR aar OR xui OR vgl OR xap OR kit OR wax OR cbw OR mau OR gma OR wst OR flb OR gsd OR tbt OR zlb OR dr2 OR tgl OR fld OR am5 OR hbt) STAT360=0 !ID]: %NAME% %TEAL%[LLD]%CONTINUE%

// LLD SET
ItemDisplay[SET (vbt OR vgl OR lgl OR lbl OR lbt) STAT360=0 !ID]: %NAME% %TEAL%[LLD]%CONTINUE%

// Warrior Map Formatting
ItemDisplay[UNI (ARMOR OR WEAPON OR rin OR amu OR QUIVER) !ID (MAPID=181 OR MAPID=182)]: %RED%* %GOLD%%NAME% %RED%%SLAMMED_TAG% *%CONTINUE%
ItemDisplay[SET (ARMOR OR WEAPON OR rin OR amu OR QUIVER) !ID (MAPID=181 OR MAPID=182)]: %RED%* %GREEN%%NAME% %RED%%SLAMMED_TAG% *%CONTINUE%

//-----------------------------------------------------------------------------------
