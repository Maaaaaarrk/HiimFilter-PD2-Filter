//-----------------------------------------------------------------------------------
// Kassahi names for PD2 / quest / gem items (names only — tooltips, frames, icons and
// sounds come from the display rules further down). Rune names come from the
// 02-alias RUNE lines so the Meme names keep working.
// The quantity tag is added here, after every rename, so renamed stacks keep it.
//-----------------------------------------------------------------------------------
// QUEST ITEMS
ItemDisplay[bks]: %GOLD%Scroll of Inifuss %RED%•%CONTINUE%
ItemDisplay[bkd]: %GOLD%Key to the Cairn Stones %RED%•%CONTINUE%
ItemDisplay[hdm]: %GOLD%Horadric Malus %RED%•%CONTINUE%
ItemDisplay[ass]: %GOLD%Book of Skill %RED%•%CONTINUE%
ItemDisplay[tr1]: %GOLD%Horadric Scroll%CONTINUE%
ItemDisplay[msf]: %GOLD%Staff of Kings %RED%•%CONTINUE%
ItemDisplay[vip]: %GOLD%Amulet of the Viper %RED%•%CONTINUE%
ItemDisplay[hst]: %GOLD%Horadric Staff %RED%•%CONTINUE%
ItemDisplay[j34]: %GOLD%Jade Figurine %RED%•%CONTINUE%
ItemDisplay[g34]: %GOLD%Golden Bird %RED%•%CONTINUE%
ItemDisplay[xyz]: %GOLD%Potion of Life %RED%•%CONTINUE%
ItemDisplay[g33]: %GOLD%Gidbinn %RED%•%CONTINUE%
ItemDisplay[qey]: %GOLD%Khalim's Eye %RED%•%CONTINUE%
ItemDisplay[qbr]: %GOLD%Khalim's Brain %RED%•%CONTINUE%
ItemDisplay[qhr]: %GOLD%Khalim's Heart %RED%•%CONTINUE%
ItemDisplay[qf1]: %GOLD%Khalim's Flail %RED%•%CONTINUE%
ItemDisplay[qf2]: %GOLD%Khalim's Will %RED%•%CONTINUE%
ItemDisplay[bbb]: %GOLD%Lam Esen's Tome %RED%•%CONTINUE%
ItemDisplay[mss]: %GOLD%Mephisto's Soulstone %RED%•%CONTINUE%
ItemDisplay[hfh]: %GOLD%Hellforge Hammer %RED%•%CONTINUE%
ItemDisplay[ice]: %GOLD%Malah's Potion %RED%•%CONTINUE%
ItemDisplay[tr2]: %GOLD%Scroll of Resistance %RED%•%CONTINUE%

// PD2 ITEMS
ItemDisplay[lsvl]: %RED%Vial%CONTINUE%
ItemDisplay[llmr]: %RED%Mirror%CONTINUE%
ItemDisplay[std]: %ORANGE%Standard of Heroes%CONTINUE%
ItemDisplay[dcso]: %ORANGE%Prime Evil Soul%CONTINUE%
ItemDisplay[dcbl]: %ORANGE%Pure Demonic Essence%CONTINUE%
ItemDisplay[cm2f]: %ORANGE%Hellfire Ashes%CONTINUE%
ItemDisplay[lbox]: %RED%Puzzle Box%CONTINUE%
ItemDisplay[lpp]: %GOLD%Puzzle Piece%CONTINUE%
ItemDisplay[scrb]: %GOLD%Horadrim Scarab%CONTINUE%
ItemDisplay[rtp]: %RED%Navigator%CONTINUE%
ItemDisplay[rid]: %RED%Almanac%CONTINUE%
ItemDisplay[imrn]: %RED%Demonic Cube%CONTINUE%
ItemDisplay[rkey]: %RED%Skeleton Key%CONTINUE%

// ESSENCES, KEYS, ORGANS, SIGILS, DCLONE, RATHMA & LUCION ITEMS
ItemDisplay[tes]: %ORANGE%Essence of Suffering%CONTINUE%
ItemDisplay[ceh]: %ORANGE%Essence of Hatred%CONTINUE%
ItemDisplay[bet]: %ORANGE%Essence of Terror%CONTINUE%
ItemDisplay[fed]: %ORANGE%Essence of Destruction%CONTINUE%
ItemDisplay[pk1]: %ORANGE%Key of Terror%CONTINUE%
ItemDisplay[pk2]: %ORANGE%Key of Hate%CONTINUE%
ItemDisplay[pk3]: %ORANGE%Key of Destruction%CONTINUE%
ItemDisplay[mbr]: %ORANGE%Mephisto's Brain%CONTINUE%
ItemDisplay[dhn]: %ORANGE%Diablo's Horn%CONTINUE%
ItemDisplay[bey]: %ORANGE%Baal's Eye%CONTINUE%
ItemDisplay[ubaa]: %ORANGE%Sigil of Madawc%CONTINUE%
ItemDisplay[ubab]: %ORANGE%Sigil of Talic%CONTINUE%
ItemDisplay[ubac]: %ORANGE%Sigil of Korlic%CONTINUE%
ItemDisplay[dcho]: %ORANGE%Black Soulstone%CONTINUE%
ItemDisplay[rtmo]: %ORANGE%Trang-Oul's Jawbone%CONTINUE%
ItemDisplay[rtmv]: %ORANGE%Splinter of the Void%CONTINUE%
ItemDisplay[cwss]: %RED%Tainted%CONTINUE%
ItemDisplay[lucb]: %ORANGE%Demonic Insignia%CONTINUE%
ItemDisplay[lucc]: %ORANGE%Talisman of Transgression%CONTINUE%
ItemDisplay[lucd]: %ORANGE%Flesh of Malic%CONTINUE%

// PROJECT DIABLO 2 ITEMS
ItemDisplay[(rid OR rtp OR rkey) INVENTORY]: %RED%%NAME%%CONTINUE%
ItemDisplay[wss]: %RED%Worldstone%CONTINUE%
ItemDisplay[iwss]: %RED%Catalyst%CONTINUE%
// EARS
ItemDisplay[ivea]: %GOLD%Assassin Ear%CONTINUE%
ItemDisplay[ivez]: %GOLD%Amazon Ear%CONTINUE%
ItemDisplay[iveb]: %GOLD%Barbarian Ear%CONTINUE%
ItemDisplay[ived]: %GOLD%Druid Ear%CONTINUE%
ItemDisplay[iven]: %GOLD%Necromancer Ear%CONTINUE%
ItemDisplay[ivep]: %GOLD%Paladin Ear%CONTINUE%
ItemDisplay[ives]: %GOLD%Sorceress Ear%CONTINUE%
// LARZUK, JEWEL FRAGMENTS & MAP ORBS
ItemDisplay[lmal]: %WHITE%Larzuk's Malus%CONTINUE%
ItemDisplay[jewf]: %WHITE%Jewel Fragments %GOLD%O%CONTINUE%
ItemDisplay[imma]:
ItemDisplay[imra]: %WHITE%Zakarum%CONTINUE%
ItemDisplay[rera]: %WHITE%Horadrim%CONTINUE%
ItemDisplay[scou]: %WHITE%Destruction%CONTINUE%
ItemDisplay[upma]: %WHITE%Angelic%CONTINUE%
ItemDisplay[upmp]: %WHITE%Cartographer%CONTINUE%
ItemDisplay[fort]: %WHITE%Fortification%CONTINUE%
ItemDisplay[irma]: %GOLD%Infused Arcane%CONTINUE%
ItemDisplay[irra]: %GOLD%Infused Zakarum%CONTINUE%
ItemDisplay[rrra]: %GOLD%Infused Horadrim%CONTINUE%
ItemDisplay[urma]: %GOLD%Infused Angelic%CONTINUE%

// GEMS & INFUSIONS
ItemDisplay[GEM=1]: %WHITE%Chip-%GEMTYPE%%CONTINUE%
ItemDisplay[GEM=2]: %WHITE%Fla-%GEMTYPE%%CONTINUE%
ItemDisplay[GEM=3]: %WHITE%%GEMTYPE%%CONTINUE%
ItemDisplay[GEM=4]: %WHITE%Flawless%CONTINUE%
ItemDisplay[GEM=5]: %WHITE%Perfect%CONTINUE%
ItemDisplay[(crfb OR crfc OR crfh OR crfs OR crfu OR crfp OR crfv)]: %GOLD%Infusion%CONTINUE%
ItemDisplay[((GEMTYPE=1 (GEM>3 GEM<6)) OR (crfc))]: %NAME% %PURPLE%%CONTINUE%
ItemDisplay[((GEMTYPE=2 (GEM>3 GEM<6)) OR (crfp))]: %NAME% %WHITE%%CONTINUE%
ItemDisplay[((GEMTYPE=3 (GEM>3 GEM<6)) OR (crfs))]: %NAME% %GREEN%%CONTINUE%
ItemDisplay[((GEMTYPE=4 (GEM>3 GEM<6)) OR (crfb))]: %NAME% %RED%%CONTINUE%
ItemDisplay[((GEMTYPE=5 (GEM>3 GEM<6)) OR (crfh))]: %NAME% %BLUE%%CONTINUE%
ItemDisplay[((GEMTYPE=6 (GEM>3 GEM<6)) OR (crfu))]: %NAME% %YELLOW%%CONTINUE%
ItemDisplay[((GEMTYPE=7 (GEM>3 GEM<6)) OR (crfv))]: %NAME% %LIGHT_GRAY%%CONTINUE%
ItemDisplay[GEM=4 GEMTYPE>0]: %NAME%o%CONTINUE%
ItemDisplay[GEM=5 GEMTYPE>0]: %NAME%O%CONTINUE%
ItemDisplay[(crfc OR crfp OR crfs OR crfb OR crfh OR crfu OR crfv)]: %NAME%@%CONTINUE%

// QUANTITY & UNSTACKED
ItemDisplay[!(ARMOR OR WEAPON OR tbk OR ibk OR key OR rkey OR rid OR rtp OR aqv OR aqv2 OR aqv3 OR cqv OR cqv2 OR cqv3) QTY>1 QTY<51 !(RUNE>0)]: %NAME% %QTY_TAG%%CONTINUE%
ItemDisplay[((gzv OR glw OR glg OR glr OR glb OR gly OR skl OR gpv OR gpw OR gpg OR gpr OR gpb OR gpy OR skz) OR (RUNE>0 QTY=0))]: %RED%Unstacked %NAME%%CONTINUE%
