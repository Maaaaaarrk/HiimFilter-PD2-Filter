

//------------------------------LUXE Names------------------------------



// ESSENCES — «·» wrapper, TEAL "ALL ESSENCES"
ItemDisplay[(tes OR ceh OR bet OR fed)]: %PURPLE%«%BLACK%·%GREEN%» %BLACK%O %TEAL%ALL ESSENCES %BLACK%O %GREEN%«%BLACK%·%PURPLE%»{%NAME%}%CONTINUE%
// MINI UBER KEYS — «·» wrapper, ORANGE "ALL KEYS"
ItemDisplay[(pk1 OR pk2 OR pk3)]: %PURPLE%«%BLACK%·%GREEN%» %BLACK%O %ORANGE%ALL KEYS %BLACK%O %GREEN%«%BLACK%·%PURPLE%»{%NAME%}%CONTINUE%
// SIGILS (Mephisto's Brain / Diablo's Horn / Baal's Eye) — «·» wrapper
