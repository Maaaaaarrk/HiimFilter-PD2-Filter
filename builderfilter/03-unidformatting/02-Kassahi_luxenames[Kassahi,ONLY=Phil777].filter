//-----------------------------------------------------------------------------------
// Phil777 (luxe) renames + frame application
//
// Two groups:
//   A. Items wrapped in folder 05 (PD2_items / Kassahi_pd2items / Ubermats) via
//      %TOKEN_PARTS% / %UBER_KEYS% / %BOSS_MAT% / %WSS_SHARD% / %GEN_RARE% /
//      %PD2_MATS% — all unified to the same «·» frame in 02-alias/03-alias-kassahi-luxe.
//      For these we only set the name colour here; the folder-05 rule provides the wrap.
//   B. Items NOT wrapped in folder 05 — luxenames sets the name and applies %PD2_MATS%
//      itself.
//
// Items with their own non-«·» style (imrn, scou, crf*, MAG charms) bypass entirely.
//
// Note: the shared HORADRIC_SCARAB alias prepends %GOLD%<space> before %NAME%, but
// it only colours the leading space — the %ORANGE% from this file's rename applies
// to the actual name text, so scrb still renders with ORANGE inside the PD2_MATS frame.
//-----------------------------------------------------------------------------------

// --- Group A: rename-only (wrap happens in folder 05) ---------------------------

// Essences — TEAL  (wrapped by TOKEN_PARTS in 04-Ubermats)
ItemDisplay[(tes OR ceh OR bet OR fed)]: %TEAL%%NAME%%CONTINUE%

// Mini uber keys + organs + ubtm — ORANGE  (wrapped by UBER_KEYS in 04-Ubermats)
ItemDisplay[(pk1 OR pk2 OR pk3 OR mbr OR dhn OR bey)]: %ORANGE%%NAME%%CONTINUE%

// Uber Ancients (sigils) — ORANGE  (wrapped by PD2_MATS in 04-Ubermats)
ItemDisplay[(ubaa OR ubab OR ubac)]: %ORANGE%%NAME%%CONTINUE%

// Uber materials — ORANGE  (wrapped by BOSS_MAT in 04-Ubermats)
ItemDisplay[(dcho OR dcso OR dcbl OR rtmo OR rtmv OR cm2f OR lucb OR lucc OR lucd)]: %ORANGE%%NAME%%CONTINUE%

// Worldstone Shard — ORANGE  (wrapped by WSS_SHARD in 03-PD2_items)
ItemDisplay[wss]: %ORANGE%Worldstone%CONTINUE%

// Catalyst Shard — RED  (wrapped by WSS_SHARD in 02-Kassahi_pd2items)
ItemDisplay[iwss]: %RED%Catalyst%CONTINUE%

// Larzuk's Puzzle Piece — ORANGE literal  (wrapped by GEN_RARE in 03-PD2_items)
ItemDisplay[lpp]: %ORANGE%Puzzle Piece%CONTINUE%

// Horadrim Scarab — ORANGE  (wrapped by PD2_MATS in 02-Kassahi_pd2items)
ItemDisplay[scrb]: %ORANGE%Horadrim Scarab%CONTINUE%

// --- Group B: rename + apply PD2_MATS wrap here ---------------------------------

ItemDisplay[jewf]: %ORANGE%Jewel Fragments%CONTINUE%
ItemDisplay[std]: %ORANGE%Standard of Heroes%CONTINUE%
ItemDisplay[imra]: %GOLD%Zakarum%CONTINUE%
ItemDisplay[irra]: %GOLD%Infused Zakarum%CONTINUE%
ItemDisplay[rera]: %GOLD%Horadrim%CONTINUE%
ItemDisplay[rrra]: %GOLD%Infused Horadrim%CONTINUE%
ItemDisplay[upma]: %GOLD%Angelic%CONTINUE%
ItemDisplay[urma]: %GOLD%Infused Angelic%CONTINUE%
ItemDisplay[upmp]: %GOLD%Cartographer%CONTINUE%
ItemDisplay[fort]: %GOLD%Fortification%CONTINUE%
ItemDisplay[irma]: %ORANGE%%NAME%%CONTINUE%

// Restore QTY counter for the literal-renamed items above (rename drops %NAME%, so the
// stack count is lost). Fires only on stacks of 2+.
ItemDisplay[(iwss OR lpp OR scrb OR jewf OR std OR imra OR irra OR rera OR rrra OR upma OR urma OR upmp OR fort) QTY>1]: %NAME% %QTY_TAG%{%NAME%}%CONTINUE%

ItemDisplay[(jewf OR std OR imra OR irra OR rera OR rrra OR upma OR urma OR upmp OR fort OR irma)]: %PD2_MATS%{%NAME%}%CONTINUE%


// --- Items that bypass the «·» frame (different style) ---------------------------

// DEMONIC CUBE (imrn) — own style
ItemDisplay[imrn]: %BLACK%O %GOLD%%NAME% %BLACK%O{%NAME%}%CONTINUE%

// scou (Destruction) — plain black-O wrap
ItemDisplay[scou]: %BLACK%O %NAME% %BLACK%O%WHITE%{%NAME%}%CONTINUE%

// Craft infusions — strip the upstream "%GOLD%Infusion (colored)@" label and
// reset to plain GOLD Infusion before the BLACK O wrap.
ItemDisplay[(crfb OR crfc OR crfs OR crfh OR crfv OR crfu OR crfp)]: %GOLD%Infusion%CONTINUE%
ItemDisplay[(crfb OR crfc OR crfs OR crfh OR crfv OR crfu OR crfp) QTY>1]: %NAME% %QTY_TAG%%CONTINUE%{%NAME%}
ItemDisplay[(crfb OR crfc OR crfs OR crfh OR crfv OR crfu OR crfp)]: %BLACK%O %NAME% %BLACK%O{%NAME%}%CONTINUE%

// MAG charm size labels
ItemDisplay[MAG !ID cm1]: %BLUE%Small%CONTINUE%
ItemDisplay[MAG !ID cm2]: %BLUE%Large%CONTINUE%
ItemDisplay[MAG !ID cm3]: %BLUE%Grand%CONTINUE%
ItemDisplay[MAG !ID jew]: %BLUE%Jewel%CONTINUE%
