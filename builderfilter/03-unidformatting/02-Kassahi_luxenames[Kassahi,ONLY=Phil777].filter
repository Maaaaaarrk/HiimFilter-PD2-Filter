

//------------------------------LUXE Names------------------------------



// ESSENCES — <<.>> wrapper, default name color
ItemDisplay[(tes OR ceh OR bet OR fed)]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// MINI UBER KEYS — <<.>> wrapper, default name color
ItemDisplay[(pk1 OR pk2 OR pk3)]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// SIGILS (Mephisto's Brain / Diablo's Horn / Baal's Eye) — <<.>> wrapper
ItemDisplay[(mbr OR dhn OR bey)]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// STANDARD OF HEROES — <<.>> wrapper
ItemDisplay[std]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// UBER ANCIENTS
ItemDisplay[(ubaa OR ubab OR ubac)]: %BLACK%O %NAME% %BLACK%O{%NAME%}%CONTINUE%
// UBER MATERIALS — DClone, Rathma, Lucion — <<.>> wrapper
ItemDisplay[(dcho OR dcso OR dcbl OR rtmo OR rtmv OR cm2f OR lucb OR lucc OR lucd)]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// WORLDSTONE SHARD — <<.>> wrapper, RED name
ItemDisplay[wss]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %RED%%NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// CATALYST SHARD — <<.>> wrapper, RED name
ItemDisplay[iwss]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %RED%%NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// PUZZLE PIECE — <<.>> wrapper, ORANGE name
ItemDisplay[lpp]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %ORANGE%%NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// DEMONIC CUBE (imrn) — unchanged from prior style
ItemDisplay[imrn]: %BLACK%O %GOLD%%NAME% %BLACK%O{%NAME%}%CONTINUE%
// JEWEL FRAGMENTS — <<.>> wrapper, ORANGE name
ItemDisplay[jewf]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %ORANGE%%NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// ZAKARUM + INFUSED ZAKARUM — <<.>> wrapper, ORANGE name
ItemDisplay[(imra OR irra)]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %ORANGE%%NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// HORADRIM + INFUSED HORADRIM — <<.>> wrapper, ORANGE name
ItemDisplay[(rera OR rrra)]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %ORANGE%%NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// ANGELIC + INFUSED ANGELIC — <<.>> wrapper, ORANGE name
ItemDisplay[(upma OR urma)]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %ORANGE%%NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// CARTOGRAPHER — <<.>> wrapper, ORANGE name
ItemDisplay[upmp]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %ORANGE%%NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// FORTIFICATION — <<.>> wrapper, ORANGE name
ItemDisplay[fort]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %ORANGE%%NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// INFUSED ARCANE — <<.>> wrapper, ORANGE name (paired-infusion style)
ItemDisplay[irma]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %ORANGE%%NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
// scou (Destruction) — kept previous black-O style (not in feedback scope)
ItemDisplay[scou]: %BLACK%O %NAME% %BLACK%O%WHITE%{%NAME%}%CONTINUE%
// HORADRIM SCARAB — <<.>> wrapper, ORANGE name
ItemDisplay[scrb]: %PURPLE%<<%BLACK%.%GREEN%>> %BLACK%O %ORANGE%%NAME% %BLACK%O %GREEN%<<%BLACK%.%PURPLE%>>{%NAME%}%CONTINUE%
ItemDisplay[(crfb OR crfc OR crfs OR crfh OR crfv OR crfu OR crfp)]: %BLACK%O %NAME% %BLACK%O{%NAME%}%CONTINUE%

ItemDisplay[MAG !ID cm1]: %BLUE%Small%CONTINUE%
ItemDisplay[MAG !ID cm2]: %BLUE%Large%CONTINUE%
ItemDisplay[MAG !ID cm3]: %BLUE%Grand%CONTINUE%
ItemDisplay[MAG !ID jew]: %BLUE%Jewel%CONTINUE%
