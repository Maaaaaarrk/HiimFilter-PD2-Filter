ItemDisplay[std]: %PURPLE%«%BLACK%·%GREEN%» %BLACK%O %ORANGE%STANDARD OF HEROES %BLACK%O %GREEN%«%BLACK%·%PURPLE%»{%NAME%}%CONTINUE%
// UBER ANCIENTS — Sigils of Madawc / Talic / Korlic
