ItemDisplay[crfb]: %GOLD%Infusion %RED%@{%NAME%}%CONTINUE%
ItemDisplay[crfc]: %GOLD%Infusion %PURPLE%@{%NAME%}%CONTINUE%
ItemDisplay[crfh]: %GOLD%Infusion %BLUE%@{%NAME%}%CONTINUE%
ItemDisplay[crfs]: %GOLD%Infusion %GREEN%@{%NAME%}%CONTINUE%
ItemDisplay[crfu]: %GOLD%Infusion %YELLOW%@{%NAME%}%CONTINUE%
ItemDisplay[crfp]: %GOLD%Infusion %WHITE%@{%NAME%}%CONTINUE%
ItemDisplay[crfv]: %GOLD%Infusion %LIGHT_GRAY%@{%NAME%}%CONTINUE%

// Infusion stack QTY annotation — since it was re-named we need to add it back
ItemDisplay[(crfb OR crfc OR crfs OR crfh OR crfv OR crfu OR crfp) QTY>1]: %NAME% %QTY_TAG%%CONTINUE%{%NAME%}
ItemDisplay[(imra OR irra OR rera OR rrra OR upma OR urma OR upmp OR fort OR scou OR irma OR imrn) QTY>1]: %NAME% %QTY_TAG%{%NAME%}%CONTINUE%

// Renamed-item QTY annotation since it was re-named we need to add it back
ItemDisplay[(tes OR ceh OR bet OR fed OR pk1 OR pk2 OR pk3 OR mbr OR dhn OR bey OR ubaa OR ubab OR ubac OR dcho OR dcso OR dcbl OR rtmo OR rtmv OR cm2f OR cwss OR lucb OR lucc OR lucd OR wss OR iwss OR lmal OR jewf OR lpp OR scrb OR std) QTY>1]: %NAME% %QTY_TAG%{%NAME%}%CONTINUE%

ItemDisplay[UNI ID]: %GOLD%%NAME%%CONTINUE%
ItemDisplay[SET ID]: %GREEN%%NAME%%CONTINUE%
ItemDisplay[RARE ID]: %YELLOW%%NAME%%CONTINUE%
ItemDisplay[CRAFT ID]: %ORANGE%%NAME%%CONTINUE%
ItemDisplay[MAG ID]: %ORANGE%%NAME%%CONTINUE%
// Match upstream Kassahi `04-statdecorators/01-item-stat-decorators[ALL]` lines 28-29:
//   (ARMOR OR WEAPON) NMAG !ETH SOCK=0 → WHITE; (ARMOR OR WEAPON) NMAG (SOCK>0 OR ETH) → GRAY.
// Apply to both ID and !ID NMAG (no ID restriction).
ItemDisplay[(ARMOR OR WEAPON) NMAG !ETH SOCK=0]: %WHITE%%NAME%%CONTINUE%
ItemDisplay[(ARMOR OR WEAPON) NMAG (SOCK>0 OR ETH)]: %GRAY%%NAME%%CONTINUE%
