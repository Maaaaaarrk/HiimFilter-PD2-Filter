//------------------------------MYSTERY Names------------------------------
// Out of town, single items only. Runes get the same names in 05-utility/09-Runes-Kassashi-1mystery
// (after the rune number is added). Phil777 keeps its own purple names.
ItemDisplay[lbox QTY=1 !IN_TOWN]: %RED%Lil Mystery%CONTINUE%
ItemDisplay[(rkey OR rtp OR rid) QTY=1 !IN_TOWN]: %RED%Big Mystery%CONTINUE%
ItemDisplay[(lsvl OR llmr) QTY=1 !IN_TOWN]: %RED%GG Mystery%CONTINUE%
